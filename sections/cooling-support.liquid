{%- if section.settings.enable_section -%}
<section class="section{% render 'section-ground' %}" id="proof" data-reveal data-section-ground="{% render 'section-ground', as: 'value' %}">
  <div class="page-width big-idea__grid">
    <div class="big-idea__media">
      {% render 'theme-image',
        image: section.settings.image,
        fallback: 'cover-macro.jpg',
        alt: section.settings.heading,
        sizes: '(min-width: 900px) 45vw, 100vw'
      %}
    </div>
    <div>
      <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
      <hr class="gold-rule">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="section__lede">{{ section.settings.body }}</p>
      {%- endif -%}
      {%- if section.settings.points != blank -%}
        <ul class="specs__list">
          {%- assign lines = section.settings.points | newline_to_br | split: '<br />' -%}
          {%- for line in lines -%}
            {%- assign trimmed = line | strip -%}
            {%- if trimmed != blank -%}
              <li>{{ trimmed }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Cooling / support proof",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "select",
      "id": "ground",
      "label": "Section colour",
      "options": [
        {
          "value": "auto",
          "label": "Auto — keep neighbours distinct"
        },
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "surface",
          "label": "Stone"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "auto",
      "info": "Auto alternates off-white and stone when you reorder sections. Dark is for contrast only, used sparingly."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Built for the climate"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered to sleep cool."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "A breathable cool-knit cover and gel-infused comfort layer, paired with a 7-zone pocket-spring core for deep, considered support."
    },
    {
      "type": "textarea",
      "id": "points",
      "label": "Proof points (one per line)",
      "default": "400gsm cool-knit cover\nGel-infused comfort layer\n20cm 7-zone pocket springs\nHigh-density encased base"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [{ "name": "Cooling / support proof" }]
}
{% endschema %}
