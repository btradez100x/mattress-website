{%- liquid
  assign order_status_url = pages['order-status'].url | default: '/pages/order-status'
  assign manufacturing_url = pages['manufacturing'].url | default: '/pages/manufacturing'
  assign journal_url = blogs['journal'].url | default: '/blogs/journal'
  assign home_hash = ''
  unless template.name == 'index'
    assign home_hash = routes.root_url
  endunless
  assign reserve_src = section.settings.reserve_link
  if reserve_src == blank
    assign reserve_src = '#reserve'
  endif
-%}
{%- capture reserve_href -%}{% render 'home-section-href', href: reserve_src %}{%- endcapture -%}
{%- assign reserve_href = reserve_href | strip -%}
{%- capture header_nav_links -%}
  {%- if section.settings.menu != blank -%}
    {%- assign order_status_in_menu = false -%}
    {%- for link in section.settings.menu.links -%}
      {%- assign link_title_down = link.title | strip | downcase -%}
      {%- if link_title_down == 'reserve' or link.url contains '#reserve' -%}
        {%- continue -%}
      {%- endif -%}
      {%- capture nav_href -%}{% render 'home-section-href', href: link.url %}{%- endcapture -%}
      {%- assign nav_href = nav_href | strip -%}
      {%- if link.title == 'Journal' or link.url contains '/pages/journal' -%}
        {%- assign nav_href = journal_url -%}
      {%- endif -%}
      <a href="{{ nav_href }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- if link.url contains 'order-status' -%}
        {%- assign order_status_in_menu = true -%}
      {%- endif -%}
    {%- endfor -%}
    {%- unless order_status_in_menu -%}
      <a href="{{ order_status_url }}"{% if request.path contains 'order-status' %} aria-current="page"{% endif %}>Order status</a>
    {%- endunless -%}
  {%- else -%}
    <a href="{{ home_hash }}#swap">The Swap System</a>
    <a href="{{ home_hash }}#specs">Specs</a>
    <a href="{{ manufacturing_url }}"{% if template.suffix == 'manufacturing' %} aria-current="page"{% endif %}>Manufacturing</a>
    <a href="{{ home_hash }}#lifestyle">Lifestyle</a>
    <a href="{{ journal_url }}">Journal</a>
    <a href="{{ home_hash }}#founder">Founder</a>
    <a href="{{ home_hash }}#faq">FAQ</a>
    <a href="{{ order_status_url }}"{% if request.path contains 'order-status' %} aria-current="page"{% endif %}>Order status</a>
  {%- endif -%}
{%- endcapture -%}
<header class="site-header">
  <div class="site-header__inner">
    {% render 'wordmark' %}

    <nav class="site-header__nav" aria-label="Primary">
      {{ header_nav_links }}
    </nav>

    <div class="site-header__actions">
      {%- assign order_line_count = cart.items.size -%}
      <a
        class="site-header__order"
        href="{{ routes.cart_url }}"
        data-order-link
        aria-label="Order"
        {% unless order_line_count > 1 %}hidden{% endunless %}
      >
        <span class="site-header__order-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" focusable="false">
            <path d="M5 8h14l-1.1 10.2a1.5 1.5 0 0 1-1.5 1.3H7.6a1.5 1.5 0 0 1-1.5-1.3L5 8z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
            <path d="M9 8V6.5a3 3 0 0 1 6 0V8" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="site-header__order-label">Order</span>
        <span class="site-header__order-count" data-order-count{% unless order_line_count > 1 %} hidden{% endunless %}>{{ order_line_count }}</span>
      </a>
      {%- if section.settings.show_reserve_cta -%}
        <a class="btn" href="{{ reserve_href }}">
          {{ section.settings.reserve_label | default: 'See sizes and prices' }}
        </a>
      {%- endif -%}
      <button
        class="nav-toggle"
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="MobileNav"
        aria-label="Open menu"
      >
        <span class="nav-toggle__bars" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <div class="nav-panel" id="MobileNav" data-nav-panel aria-hidden="true">
    {{ header_nav_links }}
    {%- if section.settings.show_reserve_cta -%}
      <a href="{{ reserve_href }}">
        {{ section.settings.reserve_label | default: 'See sizes and prices' }}
      </a>
    {%- endif -%}
    <a href="{{ routes.cart_url }}" data-order-link {% unless order_line_count > 1 %}hidden{% endunless %}>
      Order{% if order_line_count > 1 %} ({{ order_line_count }}){% endif %}
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "checkbox",
      "id": "show_reserve_cta",
      "label": "Show header CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "reserve_label",
      "label": "Header CTA label",
      "default": "See sizes and prices"
    },
    {
      "type": "url",
      "id": "reserve_link",
      "label": "Reserve CTA link"
    }
  ]
}
{% endschema %}
