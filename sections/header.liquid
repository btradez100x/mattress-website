{%- liquid
  assign manufacturing_url = pages['manufacturing'].url | default: '/pages/manufacturing'
-%}
{%- capture journal_url -%}{% render 'journal-index-href' %}{%- endcapture -%}
{%- assign journal_url = journal_url | strip -%}
{%- capture core_url -%}{% render 'core-page-url' %}{%- endcapture -%}
{%- assign core_url = core_url | strip -%}
{%- liquid
  assign large_sizes_url = pages['large-sizes'].url | default: '/pages/large-sizes'
  assign european_king_url = pages['european-king'].url | default: '/pages/european-king'
  assign split_king_url = pages['split-king'].url | default: '/pages/split-king'
  assign size_guide_url = pages['size-guide'].url | default: '/pages/size-guide'
  assign specification_url = pages['specification'].url | default: '/pages/specification'
  assign about_url = pages['about'].url | default: '/pages/about'
  assign trade_url = pages['trade'].url | default: '/pages/trade'
  assign recycling_url = pages['mattress-recycling'].url | default: '/pages/mattress-recycling'
  assign home_hash = ''
  unless template.name == 'index'
    assign home_hash = routes.root_url
  endunless
  assign reserve_src = section.settings.reserve_link
  if reserve_src == blank
    assign reserve_src = '#reserve'
  endif
  assign reserve_label = section.settings.reserve_label | default: 'See sizes and prices'
  if template.suffix == 'large-sizes' or template.suffix == 'european-king' or template.suffix == 'what-it-buys' or template.suffix == 'specification' or template.suffix == 'support' or template.suffix == 'the-core' or template.suffix == 'cooling' or template.suffix == 'split-king' or template.suffix == 'size' or template.suffix == 'need' or template.suffix == 'premium' or template.suffix == 'other-size' or template.suffix == 'conquest' or template.suffix == 'spec-size' or template.suffix == 'need-only' or template.suffix == 'spec-only' or template.suffix == 'temperature'
    assign reserve_src = '#configure'
    assign reserve_label = 'Reserve yours'
  elsif template.suffix == 'about' or template.suffix == 'mattress-recycling'
    assign reserve_src = pages['configure'].url | default: '/pages/configure'
    assign reserve_label = 'Reserve yours'
  elsif template.suffix == 'configure'
    assign reserve_src = '#reserve'
    assign reserve_label = 'Reserve yours'
  endif
-%}
{%- capture reserve_href -%}{% render 'home-section-href', href: reserve_src %}{%- endcapture -%}
{%- assign reserve_href = reserve_href | strip -%}
{%- comment -%} Homepage #reserve is the original The mattress page. The SKU stays unpublished. {%- endcomment -%}
{%- capture mattress_url -%}{% render 'home-section-href', href: '#reserve' %}{%- endcapture -%}
{%- assign mattress_url = mattress_url | strip -%}
{%- comment -%} Primary nav is theme-owned so an Admin menu titled Support cannot stay live. {%- endcomment -%}
{%- capture header_nav_links -%}
  <a href="{{ specification_url }}"{% if template.suffix == 'specification' %} aria-current="page"{% endif %}>The mattress</a>
  <a href="{{ manufacturing_url }}"{% if template.suffix == 'manufacturing' %} aria-current="page"{% endif %}>How it is made</a>
  <a href="{{ core_url }}"{% if template.suffix == 'support' or template.suffix == 'the-core' %} aria-current="page"{% endif %}>The core</a>
  <a href="{{ about_url }}"{% if template.suffix == 'about' %} aria-current="page"{% endif %}>About</a>
  <a href="{{ trade_url }}"{% if template.suffix == 'trade' %} aria-current="page"{% endif %}>Trade</a>
{%- endcapture -%}
<header class="site-header">
  <div class="site-header__inner">
    {% render 'oo-logo' %}

    <nav class="site-header__nav" aria-label="Primary">
      {{ header_nav_links }}
    </nav>

    <div class="site-header__actions">
      {%- assign order_line_count = cart.items.size -%}
      {%- assign order_href = routes.cart_url -%}
      <a
        class="site-header__order"
        href="{{ order_href }}"
        data-order-link
        aria-label="Order"
        {% unless order_line_count > 0 %}hidden{% endunless %}
      >
        <span class="site-header__order-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" focusable="false">
            <path d="M5 8h14l-1.1 10.2a1.5 1.5 0 0 1-1.5 1.3H7.6a1.5 1.5 0 0 1-1.5-1.3L5 8z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
            <path d="M9 8V6.5a3 3 0 0 1 6 0V8" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="site-header__order-label">Order</span>
        <span class="site-header__order-count" data-order-count{% unless order_line_count > 0 %} hidden{% endunless %}>{{ order_line_count }}</span>
      </a>
      {%- if section.settings.show_reserve_cta -%}
        <a class="btn btn--sm" href="{{ reserve_href }}" data-header-cta="desktop">
          {{ reserve_label }}
        </a>
      {%- endif -%}
      <button
        class="nav-toggle"
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="MobileNav"
        aria-label="Open menu"
      >
        <span class="nav-toggle__bars" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <div class="nav-panel" id="MobileNav" data-nav-panel aria-hidden="true">
    {{ header_nav_links }}
    {%- if section.settings.show_reserve_cta -%}
      <a href="{{ reserve_href }}" data-header-cta="mobile">
        {{ reserve_label }}
      </a>
    {%- endif -%}
    <a href="{{ order_href }}" data-order-link {% unless order_line_count > 0 %}hidden{% endunless %}>
      Order{% if order_line_count > 0 %} ({{ order_line_count }}){% endif %}
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "checkbox",
      "id": "show_reserve_cta",
      "label": "Show header CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "reserve_label",
      "label": "Header CTA label",
      "default": "See sizes and prices"
    },
    {
      "type": "url",
      "id": "reserve_link",
      "label": "Reserve CTA link"
    }
  ]
}
{% endschema %}
