{{ 'manufacturing.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign brand = settings.brand_name | default: 'Numa'
  assign eyebrow = section.settings.eyebrow | default: 'How it is made'
  assign heading = section.settings.heading | default: 'Built in two parts.
Closed with a zip.'
  assign lede = section.settings.lede | default: 'Thirty five centimetres. A pocket spring core beneath a comfort layer that lifts out. Made after you order it, in the size you ask for.'
  assign core_heading = section.settings.core_heading | default: 'The core'
  assign core_body = section.settings.core_body
  if core_body == blank
    assign core_body = '<p>Twenty centimetres of individually pocketed springs. Each one moves alone, so one person turning over does not move the other side of the bed.</p><p>This is the part that lasts. Pocket springs do not soften the way foam does, and a well-built core is still doing its job at year twenty. It carries a twenty five year guarantee.</p>'
  endif
  assign layer_heading = section.settings.layer_heading | default: 'The layer'
  assign layer_body = section.settings.layer_body
  if layer_body == blank
    assign layer_body = '<p>Ten centimetres, built as its own product rather than glued into the mattress. It sits under the top panel and comes out with a zip.</p><div class="lp-pull"><p>Every mattress you have thrown away was thrown away because of ten centimetres.</p></div><p>Underneath, the core was almost certainly still sound. Renewing the layer keeps the bed right for twenty five years, and it is why the feel can be settled after you own it rather than guessed at before.</p><p>When you tell us how it should feel, we send the layer that takes you there. You keep every layer, so you can go back to whichever suited best.</p><p>Two minutes to change. No tools.</p>'
  endif
  assign made_heading = section.settings.made_heading | default: 'Made after you order'
  assign made_body = section.settings.made_body
  if made_body == blank
    assign made_body = '<p>Nothing is built before somebody wants it. No warehouse, no stock, no last season''s tension to move on.</p><p>That is why it takes weeks rather than days, and why there is no clearance sale. It is also why the size range is what it is - a size exists because someone asked for it, not because a machine was already set up.</p>'
  endif
  assign heritage = section.settings.heritage | default: 'Made by experts who have been making mattresses for 49 years.'
  assign sizes_heading = section.settings.sizes_heading | default: 'The sizes'
  assign sizes_lede = section.settings.sizes_lede | default: 'British and European. Every size, one construction.'
  assign sizes_note = section.settings.sizes_note | default: 'Every size, one construction. Thirty five centimetres throughout.'
  assign outcome_heading = section.settings.outcome_heading | default: 'A bed that becomes yours,
and stays that way.'
  assign cta_label = section.settings.cta_label | default: 'Choose your size'
  assign cta_link = section.settings.cta_link
  if cta_link == blank
    assign cta_link = pages['configure'].url | default: '/pages/configure'
  endif
  assign stack_layer_n = section.settings.stack_layer_n | default: '10cm'
  assign stack_layer_l = section.settings.stack_layer_l | default: 'Comfort layer'
  assign stack_core_n = section.settings.stack_core_n | default: '20cm'
  assign stack_core_l = section.settings.stack_core_l | default: 'Pocket spring core'
  assign stack_total = section.settings.stack_total | default: '35cm finished · 1.8 / 2.0mm wire'

  assign measure_count = 0
  assign size_count = 0
  assign step_count = 0
  assign outcome_count = 0
  for block in section.blocks
    if block.type == 'measure'
      assign measure_count = measure_count | plus: 1
    elsif block.type == 'size'
      assign size_count = size_count | plus: 1
    elsif block.type == 'step'
      assign step_count = step_count | plus: 1
    elsif block.type == 'outcome'
      assign outcome_count = outcome_count | plus: 1
    endif
  endfor
-%}
<section class="mfg-page" data-lp-page data-lp-variant="G-manufacturing">
  <div class="mfg-intro">
    <div class="page-width">
      <p class="section__eyebrow lp-kicker">{{ eyebrow | replace: '[Brand]', brand | escape }}</p>
      <h1>{{ heading | replace: '[Brand]', brand | newline_to_br }}</h1>
      <p class="section__lede lp-lede">{{ lede | replace: '[Brand]', brand | escape }}</p>
    </div>
  </div>
  <div class="page-width"><div class="mfg-line" aria-hidden="true"></div></div>

  <div class="mfg-band">
    <div class="page-width mfg-build">
      <div>
        <div class="mfg-stack" aria-hidden="true">
          <div class="mfg-stack__layer">
            <span class="mfg-stack__n">{{ stack_layer_n | escape }}</span>
            <span class="mfg-stack__l">{{ stack_layer_l | escape }}</span>
          </div>
          <div class="mfg-stack__zip"></div>
          <div class="mfg-stack__core">
            <span class="mfg-stack__n">{{ stack_core_n | escape }}</span>
            <span class="mfg-stack__l">{{ stack_core_l | escape }}</span>
          </div>
        </div>
        <p class="mfg-stack__total">{{ stack_total | escape }}</p>
      </div>
      <ul class="lp-spec">
        {%- if measure_count > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'measure' -%}
              <li {{ block.shopify_attributes }}><b>{{ block.settings.label | escape }}</b><span>{{ block.settings.text | escape }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <li><b>20cm</b><span>Pocket spring core. Individually housed springs, edge to edge. No shared coils, no shared movement.</span></li>
          <li><b>10cm</b><span>Comfort layer. Built separately, dropped in, zipped closed. The part your body actually touches, and the only part that softens.</span></li>
          <li><b>35cm</b><span>Finished depth. It is what fitting a full core and a proper comfort layer into one bed requires.</span></li>
          <li><b>1.8 / 2.0mm</b><span>Pocket spring wire. Two gauges, used where the core needs them.</span></li>
        {%- endif -%}
      </ul>
    </div>
  </div>

  <div class="mfg-band mfg-band--surface">
    <div class="page-width mfg-halves">
      <article>
        <h2>{{ core_heading | escape }}</h2>
        <div class="rte">{{ core_body }}</div>
      </article>
      <article>
        <h2>{{ layer_heading | escape }}</h2>
        <div class="rte">{{ layer_body }}</div>
      </article>
    </div>
  </div>

  <div class="mfg-band">
    <div class="page-width mfg-order">
      <h2>{{ made_heading | escape }}</h2>
      <div class="rte">{{ made_body }}</div>
      {%- if heritage != blank -%}
        <p class="mfg-heritage">{{ heritage | escape }}</p>
      {%- endif -%}
      <ol class="lp-steps">
        {%- if step_count > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              <li {{ block.shopify_attributes }}><b>{{ block.settings.label | escape }}</b> {{ block.settings.text | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <li><b>Springs pocketed</b> To your size. Built for your order.</li>
          <li><b>Layers assembled</b> Core and comfort layer built separately, then brought together.</li>
          <li><b>Cover closed</b> Knitted fabric, tape-edge finished, zip fitted along the top panel.</li>
          <li><b>Compressed and rolled</b> So it reaches your bedroom in one piece. It expands within hours of being unrolled.</li>
        {%- endif -%}
      </ol>
    </div>
  </div>

  <div class="mfg-band mfg-band--surface">
    <div class="page-width mfg-sizes">
      <h2>{{ sizes_heading | escape }}</h2>
      {%- if sizes_lede != blank -%}
        <p class="section__lede">{{ sizes_lede | escape }}</p>
      {%- endif -%}
      <div class="lp-sizegrid">
        {%- if size_count > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'size' -%}
              <div {{ block.shopify_attributes }}>
                <p class="lp-sizegrid__s">{{ block.settings.label | escape }}</p>
                <p class="lp-sizegrid__d">{{ block.settings.dims | escape }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <div><p class="lp-sizegrid__s">Single</p><p class="lp-sizegrid__d">90 × 190cm</p></div>
          <div><p class="lp-sizegrid__s">Double</p><p class="lp-sizegrid__d">135 × 190cm</p></div>
          <div><p class="lp-sizegrid__s">King</p><p class="lp-sizegrid__d">150 × 200cm</p></div>
          <div><p class="lp-sizegrid__s">European King</p><p class="lp-sizegrid__d">160 × 200cm</p></div>
          <div><p class="lp-sizegrid__s">Super King</p><p class="lp-sizegrid__d">180 × 200cm</p></div>
          <div><p class="lp-sizegrid__s">Emperor</p><p class="lp-sizegrid__d">200 × 200cm</p></div>
        {%- endif -%}
      </div>
      {%- if sizes_note != blank -%}
        <p class="lp-note-line">{{ sizes_note | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="mfg-band" id="outcome">
    <div class="page-width lp-narrow mfg-close">
      <div class="lp-sec-head" style="text-align:center">
        <h2>{{ outcome_heading | newline_to_br }}</h2>
      </div>
      <div class="lp-outcome">
        {%- if outcome_count > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'outcome' -%}
              <div class="lp-outcome__item" {{ block.shopify_attributes }}>
                <p class="lp-outcome__name">{{ block.settings.heading | escape }}</p>
                <p class="lp-outcome__desc">{{ block.settings.text | escape }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <div class="lp-outcome__item">
            <p class="lp-outcome__name">You do not choose the feel. You discover it.</p>
            <p class="lp-outcome__desc">Sleep on it for a year. Tell us how it should feel. We adjust it until it is.</p>
          </div>
          <div class="lp-outcome__item">
            <p class="lp-outcome__name">It arrives finished.</p>
            <p class="lp-outcome__desc">Concierged. Room of your choice. Unrolled onto your bed. The old one leaves with it.</p>
          </div>
          <div class="lp-outcome__item">
            <p class="lp-outcome__name">It stays right for twenty five years.</p>
            <p class="lp-outcome__desc">The part that softens renews. The part that lasts, lasts.</p>
          </div>
        {%- endif -%}
      </div>
      {%- if cta_label != blank -%}
        <p class="lp-cta-band__btn" style="text-align:center"><a class="btn" href="{{ cta_link }}">{{ cta_label | escape }}</a></p>
      {%- endif -%}
    </div>
  </div>
</section>

