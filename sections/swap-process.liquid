{%- if section.settings.enable_section -%}
<section
  class="section{% if section.settings.dark %} section--dark{% elsif section.settings.surface %} section--surface{% endif %}"
  id="{{ section.settings.anchor_id | default: 'swap-process' }}"
  data-reveal
>
  <div class="page-width">
    <div class="media-feature__intro">
      <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="section__lede">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    <div class="media-feature__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' and block.settings.enabled -%}
          <article class="media-feature__card" {{ block.shopify_attributes }}>
            <div class="media-feature__media">
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: image_size: '1200x', controls: true }}
              {%- else -%}
                {%- assign step_fallback = block.settings.fallback_asset | default: 'swap-poster.jpg' -%}
                {% render 'theme-image',
                  image: block.settings.image,
                  fallback: step_fallback,
                  alt: block.settings.title,
                  sizes: '(min-width: 900px) 30vw, 100vw'
                %}
              {%- endif -%}
            </div>
            <div class="media-feature__copy">
              {%- if block.settings.step_label != blank -%}
                <p class="media-feature__step">{{ block.settings.step_label }}</p>
              {%- endif -%}
              <h3>{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Changeable top process",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "dark",
      "label": "Dark navy background",
      "default": false,
      "info": "Use sparingly. Prefer stone or off-white after a dark section so sections separate clearly."
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Stone surface background",
      "default": true,
      "info": "Soft stone (#EAE6DF) - pairs after a navy section per Brand Guidelines."
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "swap-process"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The changeable top"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Unzip. Lift out. Swap in."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "A visual walkthrough of the replaceable comfort top - swap it when worn, keep the engineered core."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process step",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this step",
          "default": true
        },
        {
          "type": "text",
          "id": "step_label",
          "label": "Step label",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Unzip the cover"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Open the perimeter zip to access the comfort top."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (optional)"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Theme fallback asset filename",
          "default": "swap-poster.jpg",
          "info": "Used in local preview / when no image is uploaded."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Changeable top process",
      "settings": {
        "dark": false,
        "surface": true
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "enabled": true,
            "step_label": "01",
            "title": "Unzip",
            "text": "Open the perimeter zip - hardware built for repeated use.",
            "fallback_asset": "handle-detail.jpg"
          }
        },
        {
          "type": "step",
          "settings": {
            "enabled": true,
            "step_label": "02",
            "title": "Lift out",
            "text": "Remove the comfort top as a single layer.",
            "fallback_asset": "swap-poster.jpg"
          }
        },
        {
          "type": "step",
          "settings": {
            "enabled": true,
            "step_label": "03",
            "title": "Swap in",
            "text": "Fit a new top when the comfort layer is worn - keep the engineered core.",
            "fallback_asset": "cover-macro.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
