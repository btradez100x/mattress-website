{%- if section.settings.enable_section -%}
<section class="section{% render 'section-ground' %}" id="{{ section.settings.anchor_id | default: 'cool-touch' }}" data-reveal data-section-ground="{% render 'section-ground', as: 'value' %}">
  <div class="page-width media-feature__split">
    {%- liquid
      assign main_caption = section.settings.image_caption
      if main_caption == blank
        assign main_caption = 'Cool-knit cover detail'
      endif
    -%}
    <figure class="cool-touch__main">
      <div class="media-feature__split-media cool-touch__thumb-frame">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: image_size: '1400x', controls: true }}
        {%- else -%}
          {% render 'theme-image',
            image: section.settings.image,
            fallback: 'cover-macro.jpg',
            alt: main_caption,
            sizes: '(min-width: 900px) 50vw, 100vw'
          %}
        {%- endif -%}
        {%- if main_caption != blank -%}
          <figcaption class="cool-touch__caption">{{ main_caption }}</figcaption>
        {%- endif -%}
      </div>
    </figure>
    <div class="media-feature__split-copy">
      {%- liquid
        assign brand = settings.brand_name | default: 'Numa'
        assign yarn_name = section.settings.yarn_name
        assign cool_heading = section.settings.heading | replace: '[Brand]', brand
        assign cool_body = section.settings.body | replace: '[Brand]', brand
        assign hand_line = section.settings.hand_line | replace: '[Brand]', brand
        if yarn_name != blank
          assign cool_heading = cool_heading | replace: '[yarn_name]', yarn_name
          assign cool_body = cool_body | replace: '[yarn_name]', yarn_name
          assign hand_line = hand_line | replace: '[yarn_name]', yarn_name
        endif
      -%}
      <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
      <hr class="gold-rule">
      <h2>{{ cool_heading }}</h2>
      {%- if cool_body != blank -%}
        {%- assign cool_lines = cool_body | newline_to_br | replace: '<br />', '|' | replace: '<br/>', '|' | replace: '<br>', '|' | split: '|' -%}
        {%- for line in cool_lines -%}
          {%- assign cool_line = line | strip -%}
          {%- if cool_line != blank -%}
            <p class="section__lede">{{ cool_line }}</p>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="cool-touch__points" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'point' and block.settings.enabled -%}
              {%- liquid
                assign point_title = block.settings.title | replace: '[Brand]', brand
                assign point_text = block.settings.text | replace: '[Brand]', brand
                if yarn_name != blank
                  assign point_title = point_title | replace: '[yarn_name]', yarn_name
                  assign point_text = point_text | replace: '[yarn_name]', yarn_name
                endif
              -%}
              <li {{ block.shopify_attributes }}>
                {%- if point_title != blank -%}
                  <strong>{{ point_title }}</strong>
                {%- endif -%}
                {%- if point_text != blank -%}
                  <span>{{ point_text }}</span>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if hand_line != blank -%}
        <p class="cool-touch__hand">{{ hand_line }}</p>
      {%- endif -%}

      {%- if section.settings.gallery_enabled -%}
        <div class="cool-touch__gallery">
          {%- for block in section.blocks -%}
            {%- if block.type == 'media' and block.settings.enabled -%}
              <figure class="cool-touch__thumb" {{ block.shopify_attributes }}>
                {%- liquid
                  assign media_fallback = block.settings.fallback_asset | default: 'cover-macro.jpg'
                  assign media_caption = block.settings.caption
                  if media_caption == blank
                    assign media_caption = 'Cover texture'
                  endif
                -%}
                <div class="cool-touch__thumb-frame">
                  {%- if block.settings.video != blank -%}
                    {{ block.settings.video | video_tag: image_size: '600x', controls: true }}
                  {%- else -%}
                    {% render 'theme-image',
                      image: block.settings.image,
                      fallback: media_fallback,
                      alt: media_caption,
                      sizes: '30vw'
                    %}
                  {%- endif -%}
                </div>
                {%- if media_caption != blank -%}
                  <figcaption class="cool-touch__thumb-caption">{{ media_caption }}</figcaption>
                {%- endif -%}
              </figure>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Cool touch",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "select",
      "id": "ground",
      "label": "Section colour",
      "options": [
        {
          "value": "auto",
          "label": "Auto — keep neighbours distinct"
        },
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "surface",
          "label": "Stone"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "auto",
      "info": "Auto alternates off-white and stone when you reorder sections. Dark is for contrast only, used sparingly."
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Stone surface background",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "gallery_enabled",
      "label": "Show supporting media gallery",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "cool-touch"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Cool touch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered to sleep cool.",
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Sleep hot? Your body has to shed heat to fall asleep. If the bed keeps giving it back, you lie there awake."
    },
    {
      "type": "text",
      "id": "yarn_name",
      "label": "Yarn name",
      "info": "Optional. Replaces [yarn_name] only if you type a yarn name here. Leave blank until then. [Brand] is the store name."
    },
    {
      "type": "textarea",
      "id": "hand_line",
      "label": "Closing line",
      "default": "Put your hand on the bed. You will feel it before you are in it."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Main image caption",
      "default": "Cool-knit cover detail"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Main video (optional)"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this point",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cool to the touch"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "It does not feel warm when you get in"
        }
      ]
    },
    {
      "type": "media",
      "name": "Gallery media",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this media",
          "default": true
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Cover texture"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (optional)"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Theme fallback asset",
          "default": "cover-macro.jpg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cool touch",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "enabled": true,
            "title": "Cool to the touch",
            "text": "The cover is knitted from [Brand]'s yarn. It pulls heat off your skin faster than cotton can return it."
          }
        },
        {
          "type": "point",
          "settings": {
            "enabled": true,
            "title": "400gsm of it",
            "text": "More of the yarn against you, right where you lie."
          }
        },
        {
          "type": "media",
          "settings": {
            "enabled": true,
            "caption": "Cover knit",
            "fallback_asset": "cover-macro.jpg"
          }
        },
        {
          "type": "media",
          "settings": {
            "enabled": true,
            "caption": "Surface detail",
            "fallback_asset": "handle-detail.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
