{%- if section.settings.enable_section -%}
{%- liquid
  assign spec_id = section.settings.spec_id | default: 'mattress' | strip
  if spec_id == blank
    assign spec_id = 'mattress'
  endif
  assign spec_label = section.settings.label | default: 'Full specification'
  assign spec_hint = section.settings.hint
  assign spec_note = section.settings.note
  assign spec_anchor = section.settings.anchor_id | default: 'specs' | strip
  if spec_anchor == blank
    assign spec_anchor = 'specs'
  endif
  assign body_id = 'vspec-body-' | append: section.id
  assign vspec_class = 'vspec'
  if section.settings.dark
    assign vspec_class = 'vspec vspec--dark'
  endif
-%}
<section class="section section--vspec{% render 'section-ground', ignore_legacy: true %}" id="{{ spec_anchor }}" data-reveal data-section-ground="{% render 'section-ground', as: 'value', ignore_legacy: true %}">
  <div class="page-width">
    <div class="{{ vspec_class }}" data-open="false" data-spec-panel data-spec-id="{{ spec_id | escape }}">
      <button
        class="vspec__trigger"
        type="button"
        aria-expanded="false"
        aria-controls="{{ body_id }}"
      >
        <span class="vspec__label">{{ spec_label }}</span>
        {%- if spec_hint != blank -%}
          <span class="vspec__hint">{{ spec_hint }}</span>
        {%- endif -%}
        <span class="vspec__ind" aria-hidden="true">+</span>
      </button>

      <div class="vspec__body" id="{{ body_id }}" role="region" aria-label="{{ spec_label | escape }}">
        <div class="vspec__clip">
          <div class="vspec__inner">
            {%- if spec_note != blank -%}
              <p class="vspec__note">{{ spec_note }}</p>
            {%- endif -%}
            <table class="vspec__table">
              <tbody>
                {%- for block in section.blocks -%}
                  {%- liquid
                    assign spec_name = block.settings.name
                    assign spec_meta = block.settings.meta
                    assign spec_does = block.settings.does
                    if spec_name == blank and spec_meta == blank and spec_does == blank
                      assign spec_name = block.settings.text
                    endif
                  -%}
                  {%- if spec_name != blank or spec_meta != blank or spec_does != blank -%}
                    <tr {{ block.shopify_attributes }}>
                      <td>
                        {%- if spec_name != blank -%}
                          <div class="vspec__name">{{ spec_name }}</div>
                        {%- endif -%}
                        {%- if spec_meta != blank -%}
                          <div class="vspec__meta">{{ spec_meta }}</div>
                        {%- endif -%}
                      </td>
                      <td class="vspec__does">{{ spec_does }}</td>
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product specs",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "select",
      "id": "ground",
      "label": "Section colour",
      "options": [
        {
          "value": "auto",
          "label": "Auto — keep neighbours distinct"
        },
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "surface",
          "label": "Stone"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "auto",
      "info": "Auto alternates off-white and stone when you reorder sections. Dark is for contrast only, used sparingly."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Trigger label",
      "default": "Full specification"
    },
    {
      "type": "text",
      "id": "hint",
      "label": "Trigger hint",
      "default": "Every layer, stated"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Panel note",
      "default": "You are spending real money on something you cannot open. Here is what is inside it."
    },
    {
      "type": "text",
      "id": "spec_id",
      "label": "Specification id (tracking)",
      "default": "mattress",
      "info": "Sent with spec_opened and spec_dwell. Use a different id if you add this panel to another product page."
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor id",
      "default": "specs"
    },
    {
      "type": "checkbox",
      "id": "dark",
      "label": "Dark specification panel",
      "default": false,
      "info": "Colours the specification panel only. Use Section colour for the band behind it."
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "What it is",
          "default": "Height"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Measurement",
          "default": "37 CM MADE UP"
        },
        {
          "type": "text",
          "id": "does",
          "label": "What it does",
          "default": "Deeper than most. Deep-fitted sheets needed"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product specs",
      "blocks": [
        { "type": "spec", "settings": { "name": "Height", "meta": "37 CM MADE UP", "does": "Deeper than most. Deep-fitted sheets needed" } },
        { "type": "spec", "settings": { "name": "Assembly", "meta": "HAND-ASSEMBLED, MADE TO ORDER", "does": "Built after you order it, never from stock" } },
        { "type": "spec", "settings": { "name": "Cover", "meta": "400 G COOL-KNIT · ZIP ACCESS", "does": "Opens all the way round to reach the comfort layer" } },
        { "type": "spec", "settings": { "name": "Gel memory foam", "meta": "1 CM · 28 DENSITY", "does": "Contours without trapping heat" } },
        { "type": "spec", "settings": { "name": "Comfort foam", "meta": "1.5 CM · 20 DENSITY", "does": "The give you feel first" } },
        { "type": "spec", "settings": { "name": "Wave-profile foam", "meta": "2.5 CM · 20 DENSITY", "does": "Moves air through the comfort layers" } },
        { "type": "spec", "settings": { "name": "Flippable comfort layer", "meta": "10 CM · 25 DENSITY · 2540 / 2580", "does": "Soft one side, firm the other. Turn it over to change the feel" } },
        { "type": "spec", "settings": { "name": "Pocket spring core", "meta": "20 CM · 7 ZONES · 1.9 / 2.0 MM WIRE", "does": "Individually pocketed, so movement does not travel" } },
        { "type": "spec", "settings": { "name": "Encased perimeter", "meta": "7 CM · 35 DENSITY", "does": "Holds the edge. Sit on it without sliding" } },
        { "type": "spec", "settings": { "name": "Underside", "meta": "ANTI-SLIP", "does": "Stays where you put it" } }
      ]
    }
  ]
}
{% endschema %}
