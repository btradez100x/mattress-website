{%- liquid
  assign lead_window = settings.lead_time_window | default: '8 to 10 weeks'
  assign warranty = settings.warranty_years | default: '15'
  if localization.country.iso_code == 'GB'
    assign market = 'gb'
    assign arrived_label = 'Arrived in the UK'
  elsif localization.country.iso_code == 'AE'
    assign market = 'ae'
    assign arrived_label = 'Arrived in the UAE'
  else
    assign market = settings.default_market | default: 'ae'
    if market == 'gb'
      assign arrived_label = 'Arrived in the UK'
    else
      assign arrived_label = 'Arrived in the UAE'
    endif
  endif
-%}
<main data-order-confirmed data-market="{{ market }}" data-lead-window="{{ lead_window | escape }}">
  <section class="thanks-hero section--dark" data-reveal>
    <div class="page-width thanks-hero__inner">
      <p class="section__eyebrow">{{ section.settings.eyebrow | default: 'Order confirmed' }}</p>
      <h1 class="thanks-hero__title">{{ section.settings.heading | default: 'Thank you.' }}</h1>
      <p class="thanks-hero__lede">
        {{ section.settings.lede | default: "Your order is in. We'll build it to your size, keep you updated at every stage, and deliver it into your room." }}
      </p>
      <p class="thanks-hero__window">
        Expected delivery
        <strong data-confirmed-lead>{{ lead_window }}</strong>
      </p>
      <p class="thanks-hero__remedy">
        If we are going to miss that window we will tell you before the date, and you can cancel for a full refund.
      </p>
    </div>
  </section>

  <section class="thanks-order" data-reveal>
    <div class="page-width page-width--narrow">
      <p class="section__eyebrow">Your order</p>
      <hr class="gold-rule">
      <p class="thanks-order__count" data-confirmed-count></p>
      <ul class="thanks-order__lines" role="list" data-confirmed-lines></ul>
      <p class="thanks-order__total">
        <span>Total</span>
        <strong data-confirmed-total></strong>
      </p>
      <p class="thanks-order__summary" data-confirmed-summary hidden></p>
    </div>
  </section>

  <section class="thanks-journey section--dark" data-reveal>
    <div class="page-width page-width--narrow">
      <p class="section__eyebrow">What happens next</p>
      <h2 class="thanks-journey__title">We'll update you at every stage.</h2>
      <p class="thanks-journey__lede">
        Silence is how chargebacks start. You will hear from us as the order moves - not only when it arrives.
      </p>
      <ol class="thanks-stages" data-confirmed-stages>
        <li class="thanks-stage thanks-stage--now" data-stage="confirmed">
          <span class="thanks-stage__dot" aria-hidden="true"></span>
          <span class="thanks-stage__name">Order confirmed</span>
          <span class="thanks-stage__date" data-stage-date>Today</span>
        </li>
        <li class="thanks-stage" data-stage="production">
          <span class="thanks-stage__dot" aria-hidden="true"></span>
          <span class="thanks-stage__name">In production</span>
          <span class="thanks-stage__date"></span>
        </li>
        <li class="thanks-stage" data-stage="quality">
          <span class="thanks-stage__dot" aria-hidden="true"></span>
          <span class="thanks-stage__name">Quality checked</span>
          <span class="thanks-stage__date"></span>
        </li>
        <li class="thanks-stage" data-stage="transit">
          <span class="thanks-stage__dot" aria-hidden="true"></span>
          <span class="thanks-stage__name">In transit</span>
          <span class="thanks-stage__date"></span>
        </li>
        <li class="thanks-stage" data-stage="arrived">
          <span class="thanks-stage__dot" aria-hidden="true"></span>
          <span class="thanks-stage__name" data-stage-arrived-label>{{ arrived_label }}</span>
          <span class="thanks-stage__date"></span>
        </li>
        <li class="thanks-stage" data-stage="delivered">
          <span class="thanks-stage__dot" aria-hidden="true"></span>
          <span class="thanks-stage__name">Delivered</span>
          <span class="thanks-stage__date"></span>
        </li>
      </ol>
    </div>
  </section>

  {%- if section.settings.image != blank -%}
    <section class="thanks-media" aria-label="Product atmosphere" data-reveal>
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag: class: 'thanks-media__img', loading: 'lazy', widths: '800, 1200, 1600, 2000', sizes: '100vw'
      }}
    </section>
  {%- endif -%}

  <section class="thanks-close" data-reveal>
    <div class="page-width page-width--narrow">
      <p class="section__eyebrow">Meanwhile</p>
      <hr class="gold-rule">
      <h2 class="thanks-close__title">Cancel any time before dispatch.</h2>
      <p class="thanks-close__lede">
        No questions asked. Once it arrives you still have 100 nights to change your mind, and a {{ warranty }}-year core warranty.
      </p>
      <div class="thanks-close__actions">
        {%- if section.settings.status_link != blank -%}
          <a class="btn" href="{{ section.settings.status_link }}">Track your order</a>
        {%- endif -%}
        <a class="btn btn--ghost" href="{{ routes.root_url }}">Back to the site</a>
      </div>
    </div>
  </section>
</main>

{% schema %}
{
  "name": "Order confirmed",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Order confirmed"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thank you."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting copy",
      "default": "Your order is in. We'll build it to your size, keep you updated at every stage, and deliver it into your room."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Atmosphere image"
    },
    {
      "type": "url",
      "id": "status_link",
      "label": "Order status page"
    }
  ]
}
{% endschema %}
