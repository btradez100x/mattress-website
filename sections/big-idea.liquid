{%- liquid
  assign brand = settings.brand_name | default: 'Valtora'
  assign body = section.settings.body | replace: '[Brand]', brand
-%}
<section class="section" id="swap" data-reveal>
  <div class="page-width big-idea__grid">
    <div class="big-idea__copy">
      <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
      <hr class="gold-rule">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if body != blank -%}
        <div class="section__lede rte">{{ body | newline_to_br }}</div>
      {%- endif -%}
    </div>
    <div class="big-idea__media">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: image_size: '1200x', controls: true }}
      {%- else -%}
        {% render 'theme-image',
          image: section.settings.image,
          fallback: 'lifestyle-airy.jpg',
          alt: section.settings.heading,
          sizes: '(min-width: 900px) 45vw, 100vw'
        %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Big idea / Swap System",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Swap System"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A better bed, for life."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Most mattresses get replaced because the top wears out — while the springs beneath have years left. [Brand] separates the two. Unzip the comfort top, swap in a new one, and your bed feels new again. Change firmness as life changes. Keep the bed for decades.",
      "info": "Use [Brand] — it is replaced by the global brand name setting."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (optional)"
    }
  ],
  "presets": [{ "name": "Big idea / Swap System" }]
}
{% endschema %}
