{%- liquid
  assign feel_soft = settings.feel_name_soft | default: 'Soft'
  assign feel_medium = settings.feel_name_medium | default: 'Medium'
  assign feel_medium_firm = settings.feel_name_medium_firm | default: 'Medium firm'
  assign feel_firm = settings.feel_name_firm | default: 'Firm'
  assign feel_extra = settings.feel_name_extra_firm | default: 'Extra firm'
-%}
{%- if section.settings.enable_section -%}
<section class="section{% render 'section-ground' %}" id="benefits" data-reveal data-section-ground="{% render 'section-ground', as: 'value' %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <p class="section__eyebrow">The feel</p>
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    <p class="feel-ladder__lede">Three layers. Two of them turn over.</p>
    <p class="feel-ladder__lede">Yours arrives {{ feel_medium_firm }}. Turn it over for {{ feel_medium }}.</p>
    <ol class="feel-ladder">
      <li class="feel-ladder__row">
        <p class="feel-ladder__name">{{ feel_soft }}</p>
        <p class="feel-ladder__layer">Third layer, single sided</p>
      </li>
      <li class="feel-ladder__row">
        <p class="feel-ladder__name">{{ feel_medium }}</p>
        <p class="feel-ladder__layer">Included layer, reverse</p>
      </li>
      <li class="feel-ladder__row feel-ladder__row--delivered">
        <p class="feel-ladder__name">{{ feel_medium_firm }}</p>
        <p class="feel-ladder__layer">Included layer, as delivered</p>
      </li>
      <li class="feel-ladder__row">
        <p class="feel-ladder__name">{{ feel_firm }}</p>
        <p class="feel-ladder__layer">Second layer</p>
      </li>
      <li class="feel-ladder__row">
        <p class="feel-ladder__name">{{ feel_extra }}</p>
        <p class="feel-ladder__layer">Second layer, reverse</p>
      </li>
    </ol>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Benefits",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },

    {
      "type": "select",
      "id": "ground",
      "label": "Section colour",
      "options": [
        {
          "value": "auto",
          "label": "Auto — keep neighbours distinct"
        },
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "surface",
          "label": "Stone"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "auto",
      "info": "Auto alternates off-white and stone when you reorder sections. Dark is for contrast only, used sparingly."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Five feels. One bed."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "adapt", "label": "Adaptive" },
            { "value": "cool", "label": "Cool" },
            { "value": "support", "label": "Support" },
            { "value": "stability", "label": "Stability" },
            { "value": "enduring", "label": "Enduring" }
          ],
          "default": "adapt"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Decide later."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Nobody knows how firm they want a mattress until they have slept on one. So we made one that does both. Unzip the cover, turn the layer over, zip it up. Medium on one side, medium firm on the other."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "adapt",
            "heading": "Decide later.",
            "text": "Nobody knows how firm they want a mattress until they have slept on one. So we made one that does both. Unzip the cover, turn the layer over, zip it up. Medium on one side, medium firm on the other."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "cool",
            "heading": "Sleep cool.",
            "text": "Air moves through it instead of sitting under you."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "support",
            "heading": "Wake without the ache.",
            "text": "Firm under your hips. Soft at your shoulders. Not the same everywhere, because you are not."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "enduring",
            "heading": "Keep it for decades.",
            "text": "Replace the layer that wears. Keep the bed that does not."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "stability",
            "heading": "Sit on the edge",
            "text": "It holds. No slide, no dip, and you can sleep right to the edge."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "stability",
            "heading": "They turn over. You sleep on.",
            "text": "Movement stays on their side of the bed."
          }
        }
      ]
    }
  ]
}
{% endschema %}
