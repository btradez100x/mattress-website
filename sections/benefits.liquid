{%- if section.settings.enable_section -%}
<section class="section section--surface" id="benefits" data-reveal>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <p class="section__eyebrow">Why it matters</p>
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="benefits__grid">
      {%- for block in section.blocks -%}
        <article class="benefit" {{ block.shopify_attributes }}>
          <svg class="benefit__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'cool' -%}
                <path d="M12 3v18M5 7l14 10M5 17L19 7" stroke="currentColor" stroke-width="1.25"/>
              {%- when 'support' -%}
                <path d="M4 16h16M6 16V9a6 6 0 0 1 12 0v7" stroke="currentColor" stroke-width="1.25"/>
              {%- when 'stability' -%}
                <path d="M4 16h16M6 16V9a6 6 0 0 1 12 0v7" stroke="currentColor" stroke-width="1.25"/>
                <path d="M8 20h8" stroke="currentColor" stroke-width="1.25"/>
              {%- when 'enduring' -%}
                <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.25"/>
                <path d="M12 8v4l2.5 2.5" stroke="currentColor" stroke-width="1.25"/>
              {%- else -%}
                <path d="M4 14h16M8 14V8l4-3 4 3v6" stroke="currentColor" stroke-width="1.25"/>
            {%- endcase -%}
          </svg>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Benefits",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Two firmnesses. One mattress."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "adapt", "label": "Adaptive" },
            { "value": "cool", "label": "Cool" },
            { "value": "support", "label": "Support" },
            { "value": "stability", "label": "Stability" },
            { "value": "enduring", "label": "Enduring" }
          ],
          "default": "adapt"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Too firm? Flip it."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Inside your mattress, behind a second zip, is a comfort layer with a soft side and a firm side. If the feel is not right, open it, turn it over and close it again. Two minutes, no tools, no cost, as many times as you like."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "adapt",
            "heading": "Too firm? Flip it.",
            "text": "Inside your mattress, behind a second zip, is a comfort layer with a soft side and a firm side. If the feel is not right, open it, turn it over and close it again. Two minutes, no tools, no cost, as many times as you like."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "cool",
            "heading": "Cool by design",
            "text": "A 400g cool-knit cover over gel memory foam and a wave-profile layer that channels air through the mattress rather than trapping it."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "support",
            "heading": "Deep, engineered support",
            "text": "A 20cm pocket-spring core with seven zones and two wire gauges - firmer under your hips, softer at your shoulders."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "enduring",
            "heading": "Built to keep",
            "text": "Refresh the top instead of replacing the mattress - less waste, less cost over time."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "stability",
            "heading": "Sit on the edge",
            "text": "A 35-density foam perimeter wraps the spring unit, so the edge holds its shape and you can sit on it without rolling off."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "stability",
            "heading": "They turn over. You sleep on.",
            "text": "Every spring is individually pocketed, so movement stays where it happens. If your partner gets up at five, reads late, or turns over twenty times a night, it does not travel across the bed to you."
          }
        }
      ]
    }
  ]
}
{% endschema %}
