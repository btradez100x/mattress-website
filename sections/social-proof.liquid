<section class="section section--surface" id="reviews" data-reveal>
  <div class="page-width">
    <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>

    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="reviews__app" {{ block.shopify_attributes }}>
          {% render block %}
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- assign review_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'review' -%}
        {%- assign review_count = review_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if review_count == 0 -%}
      <p class="reviews__empty">{{ section.settings.empty_text }}</p>
    {%- else -%}
      <div class="reviews__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <blockquote class="review" {{ block.shopify_attributes }}>
              <p class="review__quote">“{{ block.settings.quote }}”</p>
              <footer class="review__author">{{ block.settings.author }}</footer>
            </blockquote>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign has_proof = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'proof' -%}
        {%- if block.settings.logo != blank or block.settings.caption != blank -%}
          {%- assign has_proof = true -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_proof -%}
      <div class="proof-strip">
        <p class="section__eyebrow" style="margin-top:2.5rem;">Proof</p>
        <ul class="proof-strip__list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'proof' and block.settings.logo != blank or block.type == 'proof' and block.settings.caption != blank -%}
              <li class="proof-strip__item" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" style="text-decoration:none;">{%- endif -%}
                {%- if block.settings.logo != blank -%}
                  {{
                    block.settings.logo
                    | image_url: width: 240
                    | image_tag: loading: 'lazy', widths: '120,240', alt: block.settings.caption
                  }}
                {%- endif -%}
                {%- if block.settings.caption != blank -%}
                  <span>{{ block.settings.caption }}</span>
                {%- endif -%}
                {%- if block.settings.link != blank -%}</a>{%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Social proof",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "From early owners"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quiet confidence."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state",
      "default": "Reviews will appear here as the first allocation settles in."
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The swap system is the part I keep explaining to friends."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Founding allocation"
        }
      ]
    },
    {
      "type": "proof",
      "name": "Proof / certification",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "info": "Leave empty to keep this slot hidden."
        },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Social proof" }]
}
{% endschema %}
