{%- liquid
  assign brand = settings.brand_name | default: 'Aligna' | strip
  assign product_line = settings.brand_product_line | default: '' | strip
  assign market = settings.default_market
  if localization.country.iso_code == 'GB'
    assign market = 'gb'
  elsif localization.country.iso_code == 'AE'
    assign market = 'ae'
  endif

  if market == 'gb'
    assign legal_address = settings.registered_address_gb
    if legal_address == blank
      assign legal_address = settings.registered_address
    endif
    assign tax_no = settings.tax_reg_no_gb
    assign company_no = settings.company_no_gb
    if company_no == blank
      assign company_no = settings.company_number
    endif
  else
    assign legal_address = settings.registered_address_ae
    if legal_address == blank
      assign legal_address = settings.registered_address
    endif
    assign tax_no = settings.tax_reg_no_ae
    assign company_no = settings.company_number
  endif
  assign manufacturing_url = pages['manufacturing'].url | default: '/pages/manufacturing'
  assign journal_url = blogs['journal'].url | default: '/blogs/journal'
  assign home_hash = ''
  unless template.name == 'index'
    assign home_hash = routes.root_url
  endunless
  assign trial_url = section.settings.trial_link | default: pages['100-night-trial'].url | default: '/pages/100-night-trial'
  assign warranty_url = section.settings.warranty_link | default: pages['warranty'].url | default: '/pages/warranty'
  assign refund_url = section.settings.refund_link | default: pages['refunds-deposit'].url | default: '/pages/refunds-deposit'
  assign delivery_url = section.settings.delivery_link | default: pages['delivery-lead-time'].url | default: '/pages/delivery-lead-time'
  assign size_guide_url = section.settings.size_guide_link | default: pages['size-guide'].url | default: '/pages/size-guide'
  assign contact_url = section.settings.contact_link | default: pages['contact'].url | default: '/pages/contact'
  assign privacy_url = section.settings.privacy_link | default: pages['privacy'].url | default: '/pages/privacy'
  assign terms_url = section.settings.terms_link | default: pages['terms'].url | default: '/pages/terms'
  assign cookies_url = section.settings.cookies_link | default: pages['cookies'].url | default: '/pages/cookies'
-%}
{%- capture legal_name -%}{% render 'legal-name' %}{%- endcapture -%}
{%- assign legal_name = legal_name | strip -%}
{%- capture contact_phone -%}{% render 'contact-phone' %}{%- endcapture -%}
{%- assign contact_phone = contact_phone | strip -%}
{%- assign order_status_url = pages['order-status'].url | default: '/pages/order-status' -%}
{%- if section.settings.order_status_link != blank -%}
  {%- assign order_status_url = section.settings.order_status_link -%}
{%- endif -%}
<footer class="site-footer">
  <div class="page-width site-footer__grid">
    <div class="site-footer__brand">
      {% render 'wordmark', dark: true %}
      <p>
        {% render 'market-tagline' %}. A better bed, for life. Refresh it, don't replace it.
      </p>
      <div class="site-footer__contact">
        {%- if legal_name != blank -%}
          <p class="site-footer__company"><strong>{{ legal_name }}</strong></p>
        {%- endif -%}
        {%- if brand != blank and brand != legal_name -%}
          <p class="site-footer__trading">
            <span class="site-footer__trading-label">Trading as</span>
            <span class="site-footer__trading-lockup">
              <span class="site-footer__trading-name">{{ brand }}</span>
              {%- if product_line != blank -%}
                <span class="site-footer__trading-line">{{ product_line }}</span>
              {%- endif -%}
            </span>
          </p>
        {%- endif -%}
        {%- if legal_address != blank -%}
          <p class="site-footer__address-inline">{{ legal_address | newline_to_br }}</p>
        {%- endif -%}
        {%- if settings.contact_email != blank -%}
          <p><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></p>
        {%- endif -%}
        {%- if contact_phone != blank -%}
          <p><a href="tel:{{ contact_phone | replace: ' ', '' }}">{{ contact_phone }}</a></p>
        {%- endif -%}
        {%- capture contact_hours_html -%}{% render 'contact-hours' %}{%- endcapture -%}
        {%- assign contact_hours_html = contact_hours_html | strip -%}
        {%- if contact_hours_html != blank -%}
          <p>{{ contact_hours_html }}</p>
        {%- endif -%}
        {%- if settings.response_time_note != blank -%}
          <p class="site-footer__response">{{ settings.response_time_note }}</p>
        {%- endif -%}
        {%- if settings.whatsapp_enabled -%}
          <p class="site-footer__whatsapp">{% render 'whatsapp-button', variant: 'inline' %}</p>
        {%- endif -%}
      </div>
    </div>

    <div>
      <h3>Explore</h3>
      <ul>
        <li><a href="{{ home_hash }}#swap">The Swap System</a></li>
        <li><a href="{{ home_hash }}#specs">Specs</a></li>
        <li><a href="{{ manufacturing_url }}">Manufacturing</a></li>
        <li><a href="{{ home_hash }}#lifestyle">Lifestyle</a></li>
        <li><a href="{{ home_hash }}#reserve">Reserve</a></li>
        <li><a href="{{ journal_url }}">Journal</a></li>
        <li><a href="{{ home_hash }}#faq">FAQ</a></li>
        <li><a href="{{ size_guide_url }}">Size guide</a></li>
      </ul>
    </div>

    <div>
      <h3>{{ section.settings.policies_heading | default: 'Policies' }}</h3>
      <ul>
        {%- if section.settings.menu != blank -%}
          {%- assign order_status_in_menu = false -%}
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- if link.url contains 'order-status' -%}
              {%- assign order_status_in_menu = true -%}
            {%- endif -%}
          {%- endfor -%}
          {%- unless order_status_in_menu -%}
            <li><a href="{{ order_status_url }}">Order status</a></li>
          {%- endunless -%}
        {%- else -%}
          <li><a href="{{ trial_url }}">100-night trial</a></li>
          <li><a href="{{ warranty_url }}">Warranty</a></li>
          <li><a href="{{ refund_url }}">Refunds &amp; cancellations</a></li>
          <li><a href="{{ delivery_url }}">Delivery &amp; lead time</a></li>
          {%- if section.settings.lead_time_link != blank -%}
            <li><a href="{{ section.settings.lead_time_link }}">Lead times</a></li>
          {%- endif -%}
          <li><a href="{{ contact_url }}">Contact</a></li>
          <li><a href="{{ order_status_url }}">Order status</a></li>
          <li><a href="{{ privacy_url }}">Privacy</a></li>
          <li><a href="{{ terms_url }}">Terms</a></li>
          <li><a href="{{ cookies_url }}">Cookies</a></li>
        {%- endif -%}
      </ul>
    </div>
  </div>

  {%- if section.settings.show_payment_icons -%}
    <div class="page-width site-footer__payments">
      {% render 'payment-marks', market: market %}
    </div>
  {%- endif -%}

  {%- if legal_name != blank or settings.trade_licence_no != blank or legal_address != blank or tax_no != blank or company_no != blank -%}
    <div class="page-width site-footer__legal">
      {%- if legal_name != blank -%}<span>{{ legal_name }}</span>{%- endif -%}
      {%- if market != 'gb' and settings.trade_licence_no != blank -%}
        <span>Trade licence {{ settings.trade_licence_no }}</span>
      {%- endif -%}
      {%- if company_no != blank -%}<span>Company no. {{ company_no }}</span>{%- endif -%}
      {%- if tax_no != blank -%}<span>{% if market == 'gb' %}VAT{% else %}TRN{% endif %} {{ tax_no }}</span>{%- endif -%}
      {%- if legal_address != blank -%}<span class="site-footer__address">{{ legal_address | newline_to_br }}</span>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="page-width site-footer__bottom" data-footer-copyright>
    <span>
      © {{ 'now' | date: '%Y' }} {% if legal_name != blank %}{{ legal_name }}{% else %}{{ brand }}{% endif %}. All rights reserved.
      {%- if section.settings.copyright_text != blank %} {{ section.settings.copyright_text }}{% endif -%}
    </span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Business name, address, email, phone, and trade licence are edited in Theme settings → Business details."
    },
    {
      "type": "text",
      "id": "policies_heading",
      "label": "Policies heading",
      "default": "Policies"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Policy menu"
    },
    {
      "type": "url",
      "id": "size_guide_link",
      "label": "Size guide page"
    },
    {
      "type": "url",
      "id": "trial_link",
      "label": "Trial page"
    },
    {
      "type": "url",
      "id": "warranty_link",
      "label": "Warranty page"
    },
    {
      "type": "url",
      "id": "delivery_link",
      "label": "Delivery & lead time page"
    },
    {
      "type": "url",
      "id": "refund_link",
      "label": "Refunds & cancellations page"
    },
    {
      "type": "url",
      "id": "lead_time_link",
      "label": "Lead time page (optional separate)"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact page"
    },
    {
      "type": "url",
      "id": "order_status_link",
      "label": "Order status page"
    },
    {
      "type": "url",
      "id": "privacy_link",
      "label": "Privacy page"
    },
    {
      "type": "url",
      "id": "terms_link",
      "label": "Terms page"
    },
    {
      "type": "url",
      "id": "cookies_link",
      "label": "Cookies page"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Extra copyright text"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ]
}
{% endschema %}
