{%- liquid
  assign brand = settings.brand_name | default: 'Numa' | strip
  assign heading = section.settings.heading | strip
  if heading == blank or heading == 'Styled by [Brand]' or heading == 'Styled by Numa' or heading == 'Styled by Aligna'
    assign heading = 'Styled by ' | append: brand
  else
    assign heading = heading | replace: '[Brand]', brand | replace: 'Aligna', brand | replace: 'Numa', brand
  endif
-%}
{%- if section.settings.enable_section -%}
<section
  class="section lifestyle-collage{% render 'section-ground' %}"
  id="{{ section.settings.anchor_id | default: 'lifestyle' }}"
  data-reveal
  data-section-ground="{% render 'section-ground', as: 'value' %}"
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <hr class="gold-rule">
    <h2>Styled by <span data-brand-text>{{ brand | escape }}</span></h2>
    {%- if section.settings.body != blank -%}
      <p class="section__lede">{{ section.settings.body }}</p>
    {%- endif -%}

    <div class="lifestyle-collage__masonry" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'image' and block.settings.enabled -%}
          {%- liquid
            assign span = block.settings.span | default: 'mid'
            assign fallback = block.settings.fallback_asset | default: 'styled-01-morning.webp'
            assign img_alt = block.settings.caption
            if img_alt == blank
              assign img_alt = 'Styled by ' | append: brand
            endif
            assign item_caption = block.settings.caption
            if item_caption == blank
              assign item_caption = img_alt
            endif
          -%}
          <figure
            class="lifestyle-collage__item"
            role="listitem"
            {{ block.shopify_attributes }}
            data-reveal-child
            style="--reveal-delay: {{ forloop.index0 | times: 50 }}ms"
          >
            <div class="lifestyle-collage__frame lifestyle-collage__item--{{ span }}">
              {% render 'theme-image',
                image: block.settings.image,
                fallback: fallback,
                alt: img_alt,
                sizes: '(min-width: 900px) 33vw, 50vw',
                class: 'lifestyle-collage__img'
              %}
            </div>
            <figcaption class="lifestyle-collage__caption">{{ item_caption }}</figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Lifestyle collage",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "select",
      "id": "ground",
      "label": "Section colour",
      "options": [
        {
          "value": "auto",
          "label": "Auto — keep neighbours distinct"
        },
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "surface",
          "label": "Stone"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "auto",
      "info": "Auto alternates off-white and stone when you reorder sections. Dark is for contrast only, used sparingly."
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Stone surface background",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "lifestyle"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Styled by [Brand]",
      "info": "The live heading is always Styled by the Brand name setting. This field is unused for that line."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Soft light. Quiet rooms. Real homes, not a showroom aisle."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Lifestyle image",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this image",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Rooms only: a bed in a real room, soft light. No product-on-plain-ground, detail shots, side panels, hotel interiors or anything that looks rendered. One image per shoot. Supply at the cell ratio, 1600px wide: wide 5:4, mid 4:5, tall 3:4, square 1:1. An upload here overrides the theme fallback file."
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Theme fallback asset",
          "default": "styled-01-morning.webp",
          "info": "Used when no image is uploaded. Prefer compressed .webp theme assets."
        },
        {
          "type": "select",
          "id": "span",
          "label": "Collage size",
          "default": "mid",
          "options": [
            { "value": "tall", "label": "Tall" },
            { "value": "mid", "label": "Medium" },
            { "value": "wide", "label": "Wide" },
            { "value": "square", "label": "Square" }
          ]
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "In the room"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lifestyle collage",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "enabled": true,
            "fallback_asset": "styled-01-morning.webp",
            "span": "wide",
            "caption": "Morning light, oak and linen"
          }
        },
        {
          "type": "image",
          "settings": {
            "enabled": true,
            "fallback_asset": "styled-07-home.webp",
            "span": "wide",
            "caption": "A room somebody lives in"
          }
        },
        {
          "type": "image",
          "settings": {
            "enabled": true,
            "fallback_asset": "styled-08-lake.webp",
            "span": "square",
            "caption": "A slow morning by the water"
          }
        },
        {
          "type": "image",
          "settings": {
            "enabled": true,
            "fallback_asset": "styled-02-navy.webp",
            "span": "tall",
            "caption": "A navy room with the lamps on"
          }
        },
        {
          "type": "image",
          "settings": {
            "enabled": true,
            "fallback_asset": "styled-05-rose.webp",
            "span": "mid",
            "caption": "Rose velvet, city outside"
          }
        },
        {
          "type": "image",
          "settings": {
            "enabled": true,
            "fallback_asset": "styled-06-daylight.webp",
            "span": "tall",
            "caption": "Daylight and an olive tree"
          }
        },
        {
          "type": "image",
          "settings": {
            "enabled": true,
            "fallback_asset": "styled-09-teal.webp",
            "span": "mid",
            "caption": "Teal, terracotta, lamplight"
          }
        }
      ]
    }
  ]
}
{% endschema %}
