{%- liquid
  assign market = settings.default_market | default: 'ae'
  if localization.country.iso_code == 'GB'
    assign market = 'gb'
  elsif localization.country.iso_code == 'AE'
    assign market = 'ae'
  endif
  assign visible_count = 0
  assign award_count = 0
  for block in section.blocks
    if block.type == 'logo' and block.settings.enabled
      assign visibility = block.settings.market_visibility | default: 'all'
      assign show_item = true
      if visibility == 'ae' and market != 'ae'
        assign show_item = false
      endif
      if visibility == 'gb' and market != 'gb'
        assign show_item = false
      endif
      if show_item
        assign visible_count = visible_count | plus: 1
      endif
    endif
    if block.type == 'award' and block.settings.enabled
      assign award_count = award_count | plus: 1
    endif
  endfor
-%}
{%- if section.settings.enable_section -%}
{%- if visible_count > 0 or award_count > 0 -%}
<section class="section{% render 'section-ground' %}" id="press" data-reveal data-section-ground="{% render 'section-ground', as: 'value' %}">
  <div class="page-width">
    <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="press__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="section__lede press__lede">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if visible_count > 0 -%}
      <ul class="press__logos" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'logo' and block.settings.enabled -%}
            {%- liquid
              assign visibility = block.settings.market_visibility | default: 'all'
              assign show_item = true
              if visibility == 'ae' and market != 'ae'
                assign show_item = false
              endif
              if visibility == 'gb' and market != 'gb'
                assign show_item = false
              endif
            -%}
            {%- if show_item -%}
              <li class="press__logo" {{ block.shopify_attributes }} data-reveal-child style="--reveal-delay: {{ forloop.index0 | times: 70 }}ms">
                {%- if block.settings.link != blank -%}
                  <a class="press__logo-link" href="{{ block.settings.link }}" rel="noopener" target="_blank">
                {%- else -%}
                  <span class="press__logo-link press__logo-link--static">
                {%- endif -%}
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 320
                    | image_tag: loading: 'lazy', widths: '160,240,320', alt: block.settings.name, class: 'press__logo-img'
                  }}
                {%- elsif block.settings.fallback_asset != blank -%}
                  <img
                    class="press__logo-img"
                    src="{{ block.settings.fallback_asset | asset_url }}"
                    alt="{{ block.settings.name | escape }}"
                    loading="lazy"
                    width="200"
                    height="48"
                  >
                {%- else -%}
                  <span class="press__logo-text">{{ block.settings.name }}</span>
                {%- endif -%}
                {%- if block.settings.link != blank -%}
                  </a>
                {%- else -%}
                  </span>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if award_count > 0 -%}
      <p class="section__eyebrow" style="margin-top:2.5rem;">{{ section.settings.awards_heading | default: 'Awards' }}</p>
      <ul class="awards__grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'award' and block.settings.enabled -%}
            <li class="award" {{ block.shopify_attributes }}>
              <div class="award__copy">
                {%- if block.settings.year != blank -%}
                  <p class="award__year">{{ block.settings.year }}</p>
                {%- endif -%}
                <h3 class="award__title">{{ block.settings.title }}</h3>
                {%- if block.settings.org != blank -%}
                  <p class="award__org">{{ block.settings.org }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="award__text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Press & recognition",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true,
      "info": "Admin only - hide the whole credibility strip here."
    },
    {
      "type": "select",
      "id": "ground",
      "label": "Section colour",
      "options": [
        {
          "value": "auto",
          "label": "Auto — keep neighbours distinct"
        },
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "surface",
          "label": "Stone"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "auto",
      "info": "Auto alternates off-white and stone when you reorder sections. Dark is for contrast only, used sparingly."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "As seen on"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Press & recognition."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Selected coverage, mentions, and distinctions."
    },
    {
      "type": "text",
      "id": "awards_heading",
      "label": "Awards subheading",
      "default": "Awards"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press logo",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this logo",
          "default": true
        },
        {
          "type": "select",
          "id": "market_visibility",
          "label": "Show in market",
          "options": [
            { "value": "all", "label": "All markets" },
            { "value": "ae", "label": "UAE only" },
            { "value": "gb", "label": "UK only" }
          ],
          "default": "all"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Publication name",
          "default": "Publication"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Theme asset path",
          "default": "press-the-national.svg"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Article / site link"
        }
      ]
    },
    {
      "type": "award",
      "name": "Award",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this award",
          "default": true
        },
        {
          "type": "text",
          "id": "year",
          "label": "Year",
          "default": "2026"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Award title"
        },
        {
          "type": "text",
          "id": "org",
          "label": "Organisation",
          "default": "Organisation"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting text"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Press & recognition"
    }
  ]
}
{% endschema %}
