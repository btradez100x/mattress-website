{%- liquid
  assign brand = settings.brand_name | default: 'Aligna'
  assign warranty = settings.warranty_years | default: '25'
  assign payment_mode = settings.payment_mode | default: 'full'
  assign market = settings.default_market | default: 'ae'
  if localization.country.iso_code == 'GB'
    assign market = 'gb'
  elsif localization.country.iso_code == 'AE'
    assign market = 'ae'
  endif
  if market == 'gb'
    assign market_label = 'the UK'
  elsif market == 'ae'
    assign market_label = 'the UAE'
  else
    assign market_label = 'your market'
  endif
-%}
{%- capture lead -%}{%- render 'lead-time', product: product, product_type: 'mattress' -%}{%- endcapture -%}
{%- assign lead = lead | strip -%}
{%- if section.settings.enable_section -%}
<section class="section{% render 'section-ground' %}" id="faq" data-reveal data-section-ground="{% render 'section-ground', as: 'value' %}">
  <div class="page-width page-width--narrow" style="max-width:48rem; width:min(100% - (var(--space-gutter) * 2), 48rem);">
    <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>

    <div class="faq__list" data-faq>
      {%- for block in section.blocks -%}
        {%- liquid
          assign show_item = true
          assign mode_vis = block.settings.payment_mode_visibility | default: 'all'
          if mode_vis == 'full' and payment_mode != 'full'
            assign show_item = false
          endif
          if mode_vis == 'split' and payment_mode != 'split'
            assign show_item = false
          endif
          assign answer = block.settings.answer
          if market == 'gb' and block.settings.answer_gb != blank
            assign answer = block.settings.answer_gb
          elsif market == 'ae' and block.settings.answer_ae != blank
            assign answer = block.settings.answer_ae
          endif
          assign answer = answer | replace: '[Brand]', brand | replace: 'Aligna', brand
        -%}
          {%- capture answer -%}{% render 'warranty-tokens', text: answer %}{%- endcapture -%}
          {%- capture answer -%}{% render 'trial-tokens', text: answer %}{%- endcapture -%}
        {%- liquid
          assign answer = answer | strip | replace: '[X-Y]', lead
          assign q_down = block.settings.question | downcase
          assign a_down = block.settings.answer | downcase
          if q_down contains 'oeko' or a_down contains 'oeko'
            if settings.show_oeko_tex_claim != true or settings.oeko_tex_certificate_no == blank
              assign show_item = false
            endif
          endif
        -%}
        {%- if show_item -%}
          <div class="faq__item" id="faq-{{ block.id }}" data-faq-item aria-expanded="false" {{ block.shopify_attributes }}>
            <button class="faq__trigger" type="button" data-faq-trigger>
              <span>{{ block.settings.question }}</span>
              <span class="faq__icon" aria-hidden="true"></span>
            </button>
            <div class="faq__panel">
              {%- if block.settings.answer_gb != blank and block.settings.answer_ae != blank -%}
                {%- capture answer_gb -%}{% render 'warranty-tokens', text: block.settings.answer_gb %}{%- endcapture -%}
                {%- capture answer_gb -%}{% render 'trial-tokens', text: answer_gb %}{%- endcapture -%}
                {%- capture answer_ae -%}{% render 'warranty-tokens', text: block.settings.answer_ae %}{%- endcapture -%}
                {%- capture answer_ae -%}{% render 'trial-tokens', text: answer_ae %}{%- endcapture -%}
                <span data-market-only="gb"{% if market != 'gb' %} hidden{% endif %}>{{ answer_gb | strip | replace: '[Brand]', brand | replace: 'Aligna', brand | replace: '[X-Y]', lead | newline_to_br }}</span>
                <span data-market-only="ae"{% if market == 'gb' %} hidden{% endif %}>{{ answer_ae | strip | replace: '[Brand]', brand | replace: 'Aligna', brand | replace: '[X-Y]', lead | newline_to_br }}</span>
              {%- else -%}
                {{ answer | newline_to_br }}
              {%- endif -%}
              {%- if q_down contains 'oeko' %} · {{ settings.oeko_tex_certificate_no }}{% endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },

    {
      "type": "select",
      "id": "ground",
      "label": "Section colour",
      "options": [
        {
          "value": "auto",
          "label": "Auto — keep neighbours distinct"
        },
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "surface",
          "label": "Stone"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "auto",
      "info": "Auto alternates off-white and stone when you reorder sections. Dark is for contrast only, used sparingly."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clear answers."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Why does it take 8 to 10 weeks?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Because nothing is made until you order it. Your mattress is built to your chosen size, flown to the UK, and cleared through customs. This is how made-to-order furniture works - the same wait you would expect from a bespoke sofa. Many orders arrive sooner.",
          "info": "Tokens: [Brand], [X] (Theme settings → Warranty years), [X-Y] (lead time). Used when a market-specific answer below is blank."
        },
        {
          "type": "textarea",
          "id": "answer_gb",
          "label": "Answer (UK)",
          "info": "Optional. Shown on the UK market instead of Answer."
        },
        {
          "type": "textarea",
          "id": "answer_ae",
          "label": "Answer (UAE)",
          "info": "Optional. Shown on the UAE market instead of Answer."
        },
        {
          "type": "select",
          "id": "payment_mode_visibility",
          "label": "Show for payment mode",
          "options": [
            { "value": "all", "label": "All modes" },
            { "value": "full", "label": "Full payment only" },
            { "value": "split", "label": "Split payment only" }
          ],
          "default": "all"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "Why does it take 8 to 10 weeks?",
            "answer": "Because nothing is made until you order it. Your mattress is built to your chosen size, flown to the UK, and cleared through customs. This is how made-to-order furniture works - the same wait you would expect from a bespoke sofa. Many orders arrive sooner."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "What does it feel like?",
            "answer": "Medium to medium firm, and you choose which. Most people want a mattress in that range, so that is where we built ours.\n\nTurn the comfort layer over and it moves between the two. If you want to go further in either direction, a soft or firm comfort layer will take you there."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "How do I change the firmness?",
            "answer": "Unzip the cover, turn the comfort layer over, zip it up. Two minutes, no tools, and it costs nothing. One side is medium, the other is medium firm."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "What if I want it softer or firmer than that?",
            "answer": "The mattress covers medium to medium firm because that is what most people want. If you want to go outside that, a comfort layer will take you there - softer or firmer, in the same 10cm that already sits inside the mattress.\n\nYou do not need to decide now. Sleep on it first."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "What if my partner and I want different firmnesses?",
            "answer": "The flip changes the whole mattress, not one side of it, so you will need to agree. Most couples find one setting works once they have both slept on it for a fortnight. If you cannot agree, tell us within your [N] nights and we will collect it and refund you in full."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Will my mattress look exactly like the photographs?",
            "answer": "Close, but not identical. Every mattress is hand-assembled and fabrics are sourced in batches, so the shade of the cover or the side panel can vary very slightly between runs. It is the same difference you would see between two lengths of the same cloth.\n\nWhat never varies is what is inside it. The spring unit, the comfort layers, the depth, the firmness and the construction are identical in every mattress we make, to the same specification.\n\nIf yours arrives and you are not happy with it for any reason, including how it looks, you have [N] nights to tell us and we will collect it and refund you in full."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Can I change my mind after ordering?",
            "answer": "Yes. Cancel any time before your mattress is dispatched and we refund you in full, no questions asked. Once it arrives you still have [N] nights."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "What if it is late?",
            "answer": "We give a delivery window rather than a single date because international freight can move. If we are going to miss the window we will tell you before you find out, and you can cancel for a full refund at any point before dispatch."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "What if I do not like it?",
            "answer": "You have [N] nights to decide. If it is not right we collect it and refund you."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "How much is a comfort layer?",
            "answer": "GBP 250. A new mattress does not cost GBP 250, which is the point - you refresh the layer that wears rather than replacing the whole bed.\n\nThe same layer works on any other mattress as a 10cm topper, so it is not only useful to people who own ours."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Is the price negotiable?",
            "answer": "No. We sell direct and price the same for everyone, which is how the price stays where it is."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Do I pay in full today?",
            "answer": "Yes. You pay the full mattress price at checkout. You can spread the cost with Klarna. Cancel any time before dispatch for a full refund.",
            "answer_gb": "Yes. You pay the full mattress price at checkout. You can spread the cost with Klarna. Cancel any time before dispatch for a full refund.",
            "answer_ae": "Yes. You pay the full mattress price at checkout. You can spread the cost with Tabby or Tamara. Cancel any time before dispatch for a full refund.",
            "payment_mode_visibility": "full"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "How does the split payment work?",
            "answer": "You pay part today to place the order. The balance is due before dispatch. Cancel any time before dispatch for a full refund of amounts paid.",
            "payment_mode_visibility": "split"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Which size should I choose?",
            "answer": "Use the size selector on this page. Dimensions are always shown in centimetres, so measure your bed and match the numbers rather than the name. The size guide has every size in full."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "How does the replaceable layer work?",
            "answer": "Unzip, lift out, swap in when the comfort layer is worn. To change firmness, flip the module inside - you do not need a new layer."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "What is the warranty?",
            "answer": "[X]-year warranty on the spring core."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Will I feel my partner moving?",
            "answer": "Much less than on a conventional sprung mattress. Every spring is individually wrapped in its own pocket, so it compresses on its own rather than pulling its neighbours with it. Add 10cm of foam above that and most movement is absorbed before it reaches you.\n\nIt is not complete isolation - no sprung mattress is - but if you are currently woken every time your partner turns over, this will be a noticeable change."
          }
        }
      ]
    }
  ]
}
{% endschema %}
