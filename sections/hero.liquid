{%- liquid
  assign brand = section.settings.brand_name_override | default: settings.brand_name
  assign style = ''
  if section.settings.override_primary != blank or section.settings.override_accent != blank
    if section.settings.override_primary != blank
      assign style = style | append: '--brand-primary:' | append: section.settings.override_primary | append: ';'
    endif
    if section.settings.override_accent != blank
      assign style = style | append: '--brand-accent:' | append: section.settings.override_accent | append: ';'
    endif
  endif
  assign tone = section.settings.tone | default: 'light'
  capture market
    render 'size-market'
  endcapture
  assign market = market | strip
  assign payment_mode = settings.payment_mode | default: 'full'
  assign warranty = settings.warranty_years | default: '25' | strip
  if warranty == blank
    assign warranty = '25'
  endif
-%}
{%- if section.settings.assurance != blank -%}
  {%- capture assurance_line -%}{% render 'warranty-tokens', text: section.settings.assurance %}{%- endcapture -%}
  {%- assign assurance_line = assurance_line | strip -%}
{%- else -%}
{%- liquid
  if payment_mode == 'split'
    assign assurance_line = 'Pay '
    assign assurance_line = assurance_line | append: settings.split_percent | default: 50 | append: '% today · balance when it ships'
    if market == 'ae'
      assign assurance_line = assurance_line | append: ' · Spread with Tabby or Tamara'
    else
      assign assurance_line = assurance_line | append: ' · Spread with Klarna'
    endif
  else
    assign assurance_line = 'Cancel any time before dispatch · [N]-night trial · [X]-year warranty'
  endif
-%}
{%- endif -%}
{%- capture assurance_line -%}{% render 'trial-tokens', text: assurance_line %}{%- endcapture -%}
{%- capture assurance_line -%}{% render 'warranty-tokens', text: assurance_line %}{%- endcapture -%}
{%- assign assurance_line = assurance_line | strip -%}
{%- if section.settings.enable_section -%}
{%- if section.settings.video == blank -%}
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 1600 | preload_tag: as: 'image', fetchpriority: 'high' }}
  {%- else -%}
    <link rel="preload" as="image" href="{{ 'hero-mattress.jpg' | asset_url }}" fetchpriority="high">
  {%- endif -%}
{%- endif -%}
<section
  class="hero hero--{{ tone }}"
  id="hero"
  data-section-ground="{% if tone == 'dark' %}dark{% else %}bg{% endif %}"
  {% if style != blank %}style="{{ style }}"{% endif %}
>
  {%- comment -%} Copy first so the product image stays clear (Apple-style stack on light) {%- endcomment -%}
  <div class="hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 data-reveal-child data-reveal-first style="--reveal-delay: 0ms">{{ section.settings.heading | newline_to_br }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hero__sub" data-reveal-child data-reveal-first style="--reveal-delay: 50ms">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="hero__cta" data-reveal-child data-reveal-first style="--reveal-delay: 150ms">
      <a class="btn" href="{{ section.settings.cta_link | default: '#reserve' }}" data-hero-cta>
        {{ section.settings.cta_label | default: 'See sizes and prices' }}
      </a>
      {%- if section.settings.secondary_cta_label != blank -%}
        <a class="btn btn--ghost hero__secondary" href="{{ section.settings.secondary_cta_link | default: '#swap-video' }}">
          {{ section.settings.secondary_cta_label }}
        </a>
      {%- endif -%}
    </div>
    {%- if assurance_line != blank -%}
      <p class="hero__assurance" data-reveal-child data-reveal-first style="--reveal-delay: 200ms">{{ assurance_line }}</p>
    {%- endif -%}
  </div>

  <div class="hero__media" data-reveal-child data-reveal-first style="--reveal-delay: 100ms">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1920x' }}
    {%- else -%}
      {% render 'theme-image',
        image: section.settings.image,
        fallback: 'hero-mattress.jpg',
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        alt: brand
      %}
    {%- endif -%}
  </div>
  {%- if tone == 'dark' -%}
    <div class="hero__scrim" aria-hidden="true"></div>
  {%- endif -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "header",
      "content": "Copy (positioning test surface)"
    },
    {
      "type": "text",
      "id": "brand_name_override",
      "label": "Brand name override",
      "info": "For name A/B variants on duplicated pages. Logo stays in the header only."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Made to order. Made to last."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subhead",
      "default": "Change the feel whenever you want. Replace the layer that wears, not the whole bed."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "See sizes and prices"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "CTA link",
      "info": "Use a path or in-page anchor such as #reserve."
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary CTA label",
      "default": "How the swap system works"
    },
    {
      "type": "text",
      "id": "secondary_cta_link",
      "label": "Secondary CTA link",
      "info": "Use a path or in-page anchor such as #swap."
    },
    {
      "type": "text",
      "id": "assurance",
      "label": "Assurance line override",
      "info": "Leave blank to use Theme settings → Warranty years (full payment: Cancel any time before dispatch · [N]-night trial · [X]-year warranty). Split mode still uses pay-today defaults. A filled line may use [X] for the years."
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Hero tone",
      "options": [
        { "value": "light", "label": "Light (product on off-white)" },
        { "value": "dark", "label": "Dark overlay (lifestyle)" }
      ],
      "default": "light",
      "info": "Light = Apple-style stack (copy above, product shines below). Dark = Nike-style lifestyle with bottom copy."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Defaults to theme asset hero-mattress.jpg (real product cutout composite)."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Hero video (optional)"
    },
    {
      "type": "header",
      "content": "Token overrides (segment variants)"
    },
    {
      "type": "color",
      "id": "override_primary",
      "label": "Primary override"
    },
    {
      "type": "color",
      "id": "override_accent",
      "label": "Accent override"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
