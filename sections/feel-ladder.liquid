{%- if section.settings.enable_section -%}
<section class="section{% render 'section-ground' %}" id="{{ section.settings.anchor_id | default: 'five-feels' }}" data-reveal data-section-ground="{% render 'section-ground', as: 'value' %}">
  <div class="page-width">
    {%- liquid
      assign name_soft = settings.feel_name_soft | default: 'Soft'
      assign name_medium = settings.feel_name_medium | default: 'Medium'
      assign name_medium_firm = settings.feel_name_medium_firm | default: 'Medium firm'
      assign name_firm = settings.feel_name_firm | default: 'Firm'
      assign name_extra = settings.feel_name_extra_firm | default: 'Extra firm'
      assign arrives = section.settings.arrives | replace: '[medium firm]', name_medium_firm | replace: '[medium]', name_medium
    -%}
    {%- if section.settings.eyebrow != blank -%}
      <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.lede != blank -%}
      <p class="section__lede feel-ladder__lede">{{ section.settings.lede }}</p>
    {%- endif -%}
    {%- if arrives != blank -%}
      <p class="section__lede feel-ladder__lede">{{ arrives }}</p>
    {%- endif -%}

    <ol class="feel-ladder" role="list">
      <li class="feel-ladder__row">
        <p class="feel-ladder__name">{{ name_soft }}</p>
        <p class="feel-ladder__layer">{{ section.settings.layer_soft }}</p>
      </li>
      <li class="feel-ladder__row">
        <p class="feel-ladder__name">{{ name_medium }}</p>
        <p class="feel-ladder__layer">{{ section.settings.layer_medium }}</p>
      </li>
      <li class="feel-ladder__row feel-ladder__row--delivered">
        <p class="feel-ladder__name">{{ name_medium_firm }}</p>
        <p class="feel-ladder__layer">{{ section.settings.layer_medium_firm }}</p>
      </li>
      <li class="feel-ladder__row">
        <p class="feel-ladder__name">{{ name_firm }}</p>
        <p class="feel-ladder__layer">{{ section.settings.layer_firm }}</p>
      </li>
      <li class="feel-ladder__row">
        <p class="feel-ladder__name">{{ name_extra }}</p>
        <p class="feel-ladder__layer">{{ section.settings.layer_extra }}</p>
      </li>
    </ol>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Five feels",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "select",
      "id": "ground",
      "label": "Section colour",
      "options": [
        { "value": "auto", "label": "Auto — keep neighbours distinct" },
        { "value": "bg", "label": "Off-white" },
        { "value": "surface", "label": "Stone" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "auto"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor",
      "default": "five-feels"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The feel"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Five feels. One bed."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "Three layers. Two of them turn over."
    },
    {
      "type": "textarea",
      "id": "arrives",
      "label": "Arrives line",
      "default": "Yours arrives medium firm. Turn it over for medium.",
      "info": "Optional tokens: [medium firm] and [medium] use Theme settings, Five feels."
    },
    {
      "type": "text",
      "id": "layer_soft",
      "label": "Soft layer",
      "default": "Third layer, single sided"
    },
    {
      "type": "text",
      "id": "layer_medium",
      "label": "Medium layer",
      "default": "Included layer, reverse"
    },
    {
      "type": "text",
      "id": "layer_medium_firm",
      "label": "Medium firm layer",
      "default": "Included layer, as delivered"
    },
    {
      "type": "text",
      "id": "layer_firm",
      "label": "Firm layer",
      "default": "Second layer"
    },
    {
      "type": "text",
      "id": "layer_extra",
      "label": "Extra firm layer",
      "default": "Second layer, reverse"
    }
  ],
  "presets": [
    {
      "name": "Five feels"
    }
  ]
}
{% endschema %}
