{%- comment -%}
  Order status. Theme talks to a JSON contract at settings.order_lookup_endpoint
  (Shopify App Proxy /apps/order today). Lookup stays off until the worker is live.
{%- endcomment -%}
{%- liquid
  assign lookup_on = settings.order_lookup_enabled
  assign endpoint = settings.order_lookup_endpoint | default: '/apps/order'
  assign contact_url = pages['contact'].url | default: '/pages/contact'
  capture market
    render 'size-market'
  endcapture
  assign market = market | strip
-%}
<section
  class="section"
  data-order-status
  data-lookup-endpoint="{{ endpoint | escape }}"
  data-lookup-enabled="{% if lookup_on %}true{% else %}false{% endif %}"
  data-preview="false"
  data-market="{{ market | escape }}"
  data-contact-path="{{ contact_url | escape }}"
>
  <div class="page-width order-status">
    <p class="section__eyebrow">Order status</p>
    <hr class="gold-rule">
    <h1 class="order-status__heading">{{ section.settings.heading }}</h1>
    <p class="section__lede">{{ section.settings.body }}</p>

    <div data-os-idle>
      {%- unless lookup_on -%}
        <p class="reserve-panel__note" role="status">
          Order lookup is not on yet. Email us with your order number and we will tell you exactly where it is.
          {%- if settings.contact_email != blank -%}
            <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
          {%- endif -%}
        </p>
      {%- else -%}
        <p class="reserve-panel__note">
          Enter your order number and email. If that matches an order, we will send you a link. This page is updated by hand, not live tracking.
        </p>
      {%- endunless -%}

      <form class="order-status-form" data-os-form method="post" action="{{ request.path }}">
        <label>
          <span class="order-status-form__label">Order number</span>
          <input type="text" name="order" autocomplete="off" {% unless lookup_on %}disabled{% endunless %} {% if lookup_on %}required{% endif %}>
        </label>
        <label>
          <span class="order-status-form__label">Email</span>
          <input type="email" name="email" autocomplete="email" {% unless lookup_on %}disabled{% endunless %} {% if lookup_on %}required{% endif %}>
        </label>
        {%- if lookup_on -%}
          <button class="btn" type="submit">Send me a link</button>
        {%- else -%}
          <button class="btn" type="button" disabled aria-disabled="true">Check status (coming soon)</button>
        {%- endif -%}
      </form>
      <p class="reserve-panel__note" data-os-form-note hidden></p>

      <ol class="order-status__stages" data-os-explain aria-label="Typical production stages">
        <li class="order-status__stage" data-state="explain"><span class="order-status__num">1</span><span>Order confirmed</span></li>
        <li class="order-status__stage" data-state="explain"><span class="order-status__num">2</span><span>In production</span></li>
        <li class="order-status__stage" data-state="explain"><span class="order-status__num">3</span><span>Quality checked</span></li>
        <li class="order-status__stage" data-state="explain"><span class="order-status__num">4</span><span>In transit</span></li>
        <li class="order-status__stage" data-state="explain"><span class="order-status__num">5</span><span>Arrived locally</span></li>
        <li class="order-status__stage" data-state="explain"><span class="order-status__num">6</span><span>Delivery being arranged</span></li>
        <li class="order-status__stage" data-state="explain"><span class="order-status__num">7</span><span>Delivery booked</span></li>
        <li class="order-status__stage" data-state="explain"><span class="order-status__num">8</span><span>Delivered</span></li>
      </ol>
      <p class="reserve-panel__note">
        These stages are what a live order will show, one at a time, as we update them by hand. A firm delivery date appears only when delivery is booked.
      </p>
    </div>

    <div data-os-result hidden></div>

    {%- if settings.reviews_allow_submissions -%}
      <p class="reserve-panel__note">
        Already received your mattress?
        <a href="{{ routes.root_url }}#write-review">Leave a review</a>
      </p>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'order-status.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Order status",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where is my mattress?"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Updated by hand as your mattress moves through production. Enter your order number and email and we will send a link if they match an order."
    }
  ]
}
{% endschema %}
