{%- comment -%}
  /pages/checkout is deleted as an order surface. Native /cart is canonical.
  Keep this template so bookmarks still resolve, then 301 to /cart.
  Do not fire basket_view here.
{%- endcomment -%}
<section class="cart-page order-page" data-cart-redirect="{{ routes.cart_url }}">
  <div class="page-width cart-page__wrap">
    <div class="cart-panel">
      <p class="section__eyebrow">Your order</p>
      <h1 class="cart-page__title">Taking you to your order.</h1>
      <p><a class="btn" href="{{ routes.cart_url }}">Continue to your order</a></p>
    </div>
  </div>
</section>
<script>
  (function () {
    var dest = {{ routes.cart_url | json }};
    try {
      if (location.search) {
        dest += (dest.indexOf('?') >= 0 ? '&' : '?') + location.search.replace(/^\?/, '');
      }
    } catch (e) {}
    window.location.replace(dest);
  })();
</script>

{% schema %}
{
  "name": "Checkout review",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Stage B heading",
      "default": "Your order"
    }
  ]
}
{% endschema %}
