{%- comment -%} Blog index - SEO journal for sleep & mattress guidance {%- endcomment -%}
<section class="section blog-index" data-reveal>
  <div class="page-width">
    <p class="section__eyebrow">{{ section.settings.eyebrow | default: 'Journal' }}</p>
    <hr class="gold-rule">
    <h1 class="blog-index__heading">{{ section.settings.heading | default: blog.title }}</h1>
    {%- if section.settings.lede != blank -%}
      <p class="section__lede">{{ section.settings.lede }}</p>
    {%- elsif blog.metafields.custom.lede != blank -%}
      <p class="section__lede">{{ blog.metafields.custom.lede }}</p>
    {%- endif -%}

    {%- paginate blog.articles by section.settings.page_size -%}
      {%- if blog.articles.size == 0 -%}
        <p class="blog-index__empty">Articles will appear here once published in Shopify Admin → Blog posts.</p>
      {%- else -%}
        <ul class="blog-index__grid" role="list">
          {%- for article in blog.articles -%}
            <li class="blog-card" data-reveal-child style="--reveal-delay: {{ forloop.index0 | times: 50 }}ms">
              <a class="blog-card__link" href="{{ article.url }}">
                {%- if article.image -%}
                  <div class="blog-card__media">
                    {{
                      article.image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        widths: '400,800,1200',
                        sizes: '(min-width: 900px) 30vw, 90vw',
                        alt: article.image.alt | default: article.title
                    }}
                  </div>
                {%- else -%}
                  <div class="blog-card__media blog-card__media--empty" aria-hidden="true"></div>
                {%- endif -%}
                <div class="blog-card__body">
                  {%- if article.tags.size > 0 -%}
                    <p class="blog-card__tag">{{ article.tags.first }}</p>
                  {%- endif -%}
                  <h2 class="blog-card__title">{{ article.title }}</h2>
                  {%- if article.excerpt != blank -%}
                    <p class="blog-card__excerpt">{{ article.excerpt | strip_html | truncate: 160 }}</p>
                  {%- else -%}
                    <p class="blog-card__excerpt">{{ article.content | strip_html | truncate: 160 }}</p>
                  {%- endif -%}
                  <p class="blog-card__meta">
                    <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                      {{ article.published_at | date: '%-d %b %Y' }}
                    </time>
                    <span aria-hidden="true"> · </span>
                    <span>Read</span>
                  </p>
                </div>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="blog-pagination" aria-label="Blog pagination">
          {{ paginate | default_pagination }}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sleep research & mattress guidance."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Intro"
    },
    {
      "type": "range",
      "id": "page_size",
      "label": "Articles per page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    }
  ]
}
{% endschema %}
