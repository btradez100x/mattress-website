{%- comment -%}
  Comfort top PDP. Flag off: 404 UI + noindex. Real HTTP 404 / sitemap exclusion
  still needs the product unpublished in Admin.

  Admin: product "Comfort Top", type "top", variants = Size × Firmness
  (GB: Single | Double | King | Super King | Emperor; AE: Single | Queen |
  King | Super King) × Soft | Medium | Firm. Assign this
  template. Metafields: custom.lead_time_min_weeks, custom.lead_time_max_weeks,
  custom.lead_time_note, custom.firmness_number, custom.suits.
{%- endcomment -%}
{%- if settings.comfort_tops_enabled == false -%}
<section class="section">
  <div class="page-width page-width--narrow" style="text-align:center;">
    <p class="section__eyebrow">Not found</p>
    <h1 style="font-size:clamp(2rem,4vw,2.75rem);">This page does not exist.</h1>
    <p class="section__lede" style="margin-inline:auto;">Return home to reserve your allocation.</p>
    <a class="btn" href="{{ routes.root_url }}" style="margin-top:1.5rem;">Back home</a>
  </div>
</section>
{%- else -%}
{%- capture lt_display -%}{%- render 'lead-time', product: product, product_type: 'top' -%}{%- endcapture -%}
{%- capture lt_min -%}{%- render 'lead-time', product: product, product_type: 'top', format: 'min' -%}{%- endcapture -%}
{%- capture lt_max -%}{%- render 'lead-time', product: product, product_type: 'top', format: 'max' -%}{%- endcapture -%}
{%- assign lt_display = lt_display | strip -%}
{%- assign price = product.price | money -%}
{%- if localization.country.iso_code == 'GB' -%}
  {%- assign price_note = section.settings.price_note_gb | default: 'One price per size, whichever feel you choose.' -%}
{%- else -%}
  {%- assign price_note = section.settings.price_note_ae | default: 'One price per size, whichever feel you choose.' -%}
{%- endif -%}
<section
  class="section comfort-top"
  data-comfort-top
  data-comfort-tops-enabled="true"
  data-product-handle="{{ product.handle | escape }}"
  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
  data-lead-window="{{ lt_display | escape }}"
  data-lead-min="{{ lt_min | strip }}"
  data-lead-max="{{ lt_max | strip }}"
  data-top-price-raw="{{ product.price }}"
  data-status-path="{{ pages['order-status'].url | default: '/pages/order-status' }}"
>
  <div class="page-width comfort-top__hero">
    {%- if section.settings.image != blank -%}
      <img class="comfort-top__img" src="{{ section.settings.image | image_url: width: 1800 }}" alt="{{ section.settings.heading | escape }}" width="1800" height="1200">
    {%- else -%}
      <img class="comfort-top__img" src="{{ 'manufacturing-cover.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1800" height="1200">
    {%- endif -%}
    <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="comfort-top__heading">{{ section.settings.heading }}</h1>
    <div class="section__lede rte">{{ section.settings.body }}</div>
  </div>

  <div class="page-width comfort-top__disambig" data-top-disambig>
    <div class="comfort-top__cols" data-top-unknown>
      <div>
        <h2>{{ section.settings.col1_heading }}</h2>
        <p>{{ section.settings.col1_body }}</p>
      </div>
      <div>
        <h2>{{ section.settings.col2_heading }}</h2>
        <p>{{ section.settings.col2_body }}</p>
      </div>
    </div>
    <p class="reserve-panel__note" data-top-unknown>{{ section.settings.disambig_note }}</p>
    <p class="section__lede" data-top-known hidden></p>
  </div>

  <div class="page-width comfort-top__buy">
    <h2>{{ section.settings.size_heading }}</h2>
    <p class="reserve-panel__note">{{ section.settings.size_note }}</p>
    <div class="comfort-top__sizes" data-top-sizes role="listbox" aria-label="Size"></div>
    <p class="reserve-panel__note" data-top-find-order>
      <a href="{{ pages['order-status'].url | default: '/pages/order-status' }}">Find my order</a>
    </p>

    <h2>{{ section.settings.feel_heading }}</h2>
    <div class="comfort-top__feels" data-top-feels>
      <button type="button" class="size-chip" data-top-firmness="Soft">Soft<span>Side sleepers and lighter frames</span></button>
      <button type="button" class="size-chip" data-top-firmness="Medium">Medium<span>Most people, and couples who disagree</span></button>
      <button type="button" class="size-chip" data-top-firmness="Firm">Firm<span>Back and front sleepers, and heavier frames</span></button>
    </div>
    <p class="reserve-panel__note" data-top-current-feel hidden></p>

    <p class="comfort-top__price" data-top-price>{{ price }}</p>
    <p class="reserve-panel__note">{{ price_note }}</p>
    <p class="reserve-panel__note">Lead time: {% render 'lead-time', product: product, product_type: 'top', format: 'span' %}</p>
    <button class="btn" type="button" data-top-add>Add to order</button>
    <p class="reserve-panel__note" data-top-status hidden></p>
  </div>

  <div class="page-width">
    <h2>{{ section.settings.argument_heading }}</h2>
    <p class="section__lede">{{ section.settings.argument_body }}</p>
  </div>

  <div class="page-width comfort-top__how">
    <div>
      <h2>{{ section.settings.how_a_heading }}</h2>
      <ol>
        <li>Open the zip on the side of the mattress.</li>
        <li>Lift out the comfort module.</li>
        <li>Put the new one in.</li>
        <li>Close the zip.</li>
      </ol>
    </div>
    <div>
      <h2>{{ section.settings.how_b_heading }}</h2>
      <ol>
        <li>Strip the bed.</li>
        <li>Lay the top on the mattress.</li>
        <li>Make the bed over it with deep-fitted sheets.</li>
        <li>That is it.</li>
      </ol>
    </div>
  </div>

  <div class="page-width">
    <h2>{{ section.settings.depth_heading }}</h2>
    <p class="section__lede">{{ section.settings.depth_body }}</p>
  </div>

  <div class="page-width" data-faq>
    <h2>Questions</h2>
    <div class="faq__item" data-faq-item aria-expanded="false">
      <button class="faq__trigger" type="button" data-faq-trigger><span>Will this fix a worn-out mattress?</span><span class="faq__icon" aria-hidden="true"></span></button>
      <div class="faq__panel">No. If your mattress has dipped, or the springs have gone, a topper masks that for a while rather than solving it. On a mattress that is still sound, it changes how it feels.</div>
    </div>
    <div class="faq__item" data-faq-item aria-expanded="false">
      <button class="faq__trigger" type="button" data-faq-trigger><span>Can I return it?</span><span class="faq__icon" aria-hidden="true"></span></button>
      <div class="faq__panel">Yes. If it is not right, tell us within 100 nights and we will collect it and refund you in full.</div>
    </div>
    <div class="faq__item" data-faq-item aria-expanded="false">
      <button class="faq__trigger" type="button" data-faq-trigger><span>How is it delivered?</span><span class="faq__icon" aria-hidden="true"></span></button>
      <div class="faq__panel">It arrives compressed and rolled, by courier. Unroll it and give it a few hours to recover its full height before you sleep on it.</div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Comfort top",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The comfort top" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two jobs. One layer." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Inside our mattress, the comfort top is the part you replace - unzip, lift out, put a new one in, and the bed feels new again.</p><p>On any other bed, it is a 10cm topper. Deeper than most, in the same foams we build our own mattress with.</p>" },
    { "type": "text", "id": "col1_heading", "label": "Column 1 heading", "default": "If you own our mattress" },
    { "type": "textarea", "id": "col1_body", "label": "Column 1 body", "default": "This replaces the module inside it. Unzip, lift the old one out, put the new one in." },
    { "type": "text", "id": "col2_heading", "label": "Column 2 heading", "default": "If you do not" },
    { "type": "textarea", "id": "col2_body", "label": "Column 2 body", "default": "This sits on top of your existing mattress as a 10cm topper." },
    { "type": "text", "id": "disambig_note", "label": "Disambiguation note", "default": "Same product either way. Choose your size and we will tell you which you need." },
    { "type": "text", "id": "size_heading", "label": "Size heading", "default": "Which size?" },
    { "type": "text", "id": "size_note", "label": "Size note", "default": "Match the size of the bed it is going on. Dimensions are in centimetres." },
    { "type": "text", "id": "feel_heading", "label": "Feel heading", "default": "Which feel?" },
    { "type": "text", "id": "argument_heading", "label": "Argument heading", "default": "A layer, not a mattress." },
    { "type": "textarea", "id": "argument_body", "label": "Argument body", "default": "A comfort top costs GBP 250. A new mattress does not. Refresh the layer at year five and year ten and you have spent less than replacing a cheaper bed twice - and thrown away far less." },
    { "type": "text", "id": "how_a_heading", "label": "How A heading", "default": "Inside our mattress" },
    { "type": "text", "id": "how_b_heading", "label": "How B heading", "default": "On any other mattress" },
    { "type": "text", "id": "depth_heading", "label": "Depth heading", "default": "It is 10cm deep." },
    { "type": "textarea", "id": "depth_body", "label": "Depth body", "default": "On our mattress that is already accounted for - it replaces a layer of the same depth. On any other mattress it adds 10cm, which is a noticeable change in height. Your current fitted sheets may not fit. Deep-fitted sheets start at around 35cm." },
    { "type": "text", "id": "price_note_gb", "label": "Price note UK", "default": "One price per size, whichever feel you choose." },
    { "type": "text", "id": "price_note_ae", "label": "Price note UAE", "default": "One price per size, whichever feel you choose." }
  ]
}
{% endschema %}
