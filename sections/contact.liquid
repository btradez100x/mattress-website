{%- liquid
  assign brand = settings.brand_name | default: 'Numa' | strip
  assign product_line = settings.brand_product_line | default: '' | strip
  assign trading_as = brand
  if product_line != blank
    assign trading_as = brand | append: ' ' | append: product_line
  endif
-%}
{%- capture legal_name -%}{% render 'legal-name' %}{%- endcapture -%}
{%- assign legal_name = legal_name | strip -%}
{%- capture company_no -%}{% render 'company-number' %}{%- endcapture -%}
{%- assign company_no = company_no | strip -%}
{%- capture legal_address -%}{% render 'legal-address' %}{%- endcapture -%}
{%- assign legal_address = legal_address | strip -%}
{%- capture contact_phone -%}{% render 'contact-phone' %}{%- endcapture -%}
{%- assign contact_phone = contact_phone | strip -%}

<section class="policy-page contact-page">
  <div class="section section--dark policy-hero">
    <div class="page-width policy-hero__copy">
      <p class="section__eyebrow">Contact</p>
      <hr class="gold-rule">
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.body != blank -%}
        {%- capture contact_body -%}{% render 'reply-tokens', text: section.settings.body %}{%- endcapture -%}
        <p class="section__lede policy-hero__lede">{{ contact_body | strip }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="section section--surface policy-body">
    <div class="page-width page-width--narrow">
      <ul class="contact-details contact-details--cards" role="list">
        {%- if legal_name != blank -%}
          <li>
            <strong>Company</strong>
            <span>{{ legal_name }}</span>
          </li>
        {%- endif -%}
        {%- if company_no != blank -%}
          <li>
            <strong>Company number</strong>
            <span>{{ company_no }}</span>
          </li>
        {%- endif -%}
        {%- if brand != blank and brand != legal_name -%}
          <li>
            <strong>Trading as</strong>
            <span>{{ trading_as }}</span>
          </li>
        {%- endif -%}
        {%- if settings.trade_licence_no != blank -%}
          <li>
            <strong>Trade licence</strong>
            <span>{{ settings.trade_licence_no }}</span>
          </li>
        {%- endif -%}
        {%- if legal_address != blank -%}
          <li>
            <strong>Registered address</strong>
            <span>{{ legal_address | newline_to_br }}</span>
          </li>
        {%- endif -%}
        {%- if settings.contact_email != blank -%}
          <li>
            <strong>Email</strong>
            <span><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></span>
          </li>
        {%- endif -%}
        {%- if contact_phone != blank -%}
          <li>
            <strong>Phone</strong>
            <span><a href="tel:{{ contact_phone | replace: ' ', '' }}">{{ contact_phone }}</a></span>
          </li>
        {%- endif -%}
        {%- capture contact_hours_html -%}{% render 'contact-hours' %}{%- endcapture -%}
        {%- assign contact_hours_html = contact_hours_html | strip -%}
        {%- if contact_hours_html != blank -%}
          <li>
            <strong>Hours</strong>
            <span>{{ contact_hours_html }}</span>
          </li>
        {%- endif -%}
        {%- if settings.response_time_note != blank -%}
          {%- capture response_note -%}{% render 'reply-tokens', text: settings.response_time_note %}{%- endcapture -%}
          {%- assign response_note = response_note | strip -%}
          <li>
            <strong>Response</strong>
            <span>{{ response_note }}</span>
          </li>
        {%- endif -%}
      </ul>

      {%- if settings.whatsapp_enabled -%}
        <div class="contact-whatsapp">
          {% render 'whatsapp-button', variant: 'inline' %}
          {%- capture wa_check -%}{% render 'whatsapp-number' %}{%- endcapture -%}
          {%- if wa_check == blank -%}
            <p class="contact-whatsapp__hint">Add your WhatsApp number in Theme settings → Business details (UAE or UK) to activate chat.</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if page.content != blank -%}
        <div class="rte policy-intro trust-policy__body">{{ page.content }}</div>
      {%- endif -%}
    </div>
  </div>

  <div class="section section--dark policy-cta" data-section-ground="dark">
    <div class="page-width policy-cta__inner">
      <p class="section__eyebrow">Next</p>
      <hr class="gold-rule">
      <p class="policy-cta__action">
        <a class="btn" href="/#reserve">Reserve your size</a>
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Talk to a person."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Questions about sizing, lead times, or your order - we reply within [D] working days, approximately. WhatsApp is usually fastest."
    }
  ]
}
{% endschema %}
