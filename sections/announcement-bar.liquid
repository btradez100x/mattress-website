{%- liquid
  assign market = settings.default_market | default: 'ae'
  if localization.country.iso_code == 'GB'
    assign market = 'gb'
  elsif localization.country.iso_code == 'AE'
    assign market = 'ae'
  endif
  if market == 'gb' and section.settings.text_gb != blank
    assign announcement = section.settings.text_gb
  elsif market == 'ae' and section.settings.text_ae != blank
    assign announcement = section.settings.text_ae
  else
    assign announcement = section.settings.text
  endif
-%}
{%- capture announcement -%}{% render 'trial-tokens', text: announcement %}{%- endcapture -%}
{%- capture announcement -%}{% render 'warranty-tokens', text: announcement %}{%- endcapture -%}
{%- assign announcement = announcement | strip -%}
{%- if section.settings.enable_section -%}
{%- if announcement != blank -%}
  <div class="announcement" role="region" aria-label="Announcement">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ announcement }}</a>
    {%- else -%}
      <p style="margin:0">{{ announcement }}</p>
    {%- endif -%}
  </div>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text (fallback)",
      "default": "Cancel any time before dispatch · [N]-night trial"
    },
    {
      "type": "text",
      "id": "text_ae",
      "label": "Text (UAE)",
      "default": "Cancel any time before dispatch · [N]-night trial · Made to order"
    },
    {
      "type": "text",
      "id": "text_gb",
      "label": "Text (UK)",
      "default": "Cancel any time before dispatch · [N]-night trial"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    }
  ]
}
{% endschema %}
