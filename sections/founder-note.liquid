{%- liquid
  assign brand = settings.brand_name | default: 'Numa'
  assign note = section.settings.note | replace: '[Brand]', brand | replace: 'Aligna', brand | replace: 'Numa', brand
  assign portrait_alt = section.settings.name | append: ', founder of ' | append: brand
  assign founder_caption = section.settings.name
  if section.settings.role != blank
    assign role_label = section.settings.role | strip | downcase
    if founder_caption != blank
      assign founder_caption = founder_caption | append: ', ' | append: role_label
    else
      assign founder_caption = role_label
    endif
  endif
  assign has_media = false
  if section.settings.portrait != blank
    assign has_media = true
  endif
-%}
{%- if section.settings.enable_section -%}
<section class="section founder-note{% unless has_media %} founder-note--copy founder-note--solo{% endunless %}{% render 'section-ground' %}" id="founder" data-reveal data-section-ground="{% render 'section-ground', as: 'value' %}">
  <div class="page-width founder-note__grid">
    {%- if has_media -%}
      <figure class="founder-note__media">
        <div class="founder-note__portrait">
          {{
            section.settings.portrait
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '600,900,1200,1400',
              sizes: '(min-width: 900px) 40vw, 100vw',
              alt: portrait_alt
          }}
          {%- if founder_caption != blank -%}
            <figcaption class="founder-note__caption">{{ founder_caption }}</figcaption>
          {%- endif -%}
        </div>
      </figure>
    {%- endif -%}
    <div class="founder-note__copy">
      <p class="section__eyebrow" data-reveal-child style="--reveal-delay: 50ms">{{ section.settings.eyebrow }}</p>
      <hr class="gold-rule" data-reveal-child style="--reveal-delay: 100ms">
      <h2 data-reveal-child style="--reveal-delay: 150ms">{{ section.settings.heading }}</h2>
      <div class="founder-note__body rte" data-reveal-child style="--reveal-delay: 200ms">
        {{ note }}
        {%- if settings.pillows_enabled -%}
          <p class="pdp-discover">
            <a href="{{ all_products['pillows'].url | default: '/products/pillows' }}">The right height for how you sleep.</a>
          </p>
        {%- endif -%}
      </div>
      <div class="founder-note__signoff" data-reveal-child style="--reveal-delay: 250ms">
        {%- if section.settings.signature_image != blank -%}
          {{
            section.settings.signature_image
            | image_url: width: 280
            | image_tag: loading: 'lazy', class: 'founder-note__signature', alt: ''
          }}
        {%- endif -%}
        <p class="founder-note__name">{{ section.settings.name }}</p>
        {%- if section.settings.role != blank -%}
          <p class="founder-note__role">{{ section.settings.role }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Founder note",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },

    {
      "type": "select",
      "id": "ground",
      "label": "Section colour",
      "options": [
        {
          "value": "auto",
          "label": "Auto — keep neighbours distinct"
        },
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "surface",
          "label": "Stone"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "auto",
      "info": "Auto alternates off-white and stone when you reorder sections. Dark is for contrast only, used sparingly."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A note from the founder"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built from years of studying sleep."
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note (~80-120 words)",
      "default": "<p>I spent years studying my own sleep - tracking what restored me, what stole the morning, and what I needed when the day started early and focus mattered. [Brand] is the mattress that came from that work: deep support, a surface that does not hold heat, and a layer you can refresh instead of replacing the whole bed.</p><p>Each one is made to order. Cancel any time before dispatch for a full refund. If anything is unclear, message us - a person will reply.</p>",
      "info": "Use [Brand] - it is replaced by the global brand name setting."
    },
    {
      "type": "image_picker",
      "id": "portrait",
      "label": "Portrait",
      "info": "Optional. Leave empty and the note stays centred. Upload a portrait and it sits beside the note."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Ben Acolatse"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Role",
      "default": "Founder"
    },
    {
      "type": "image_picker",
      "id": "signature_image",
      "label": "Signature image (optional)"
    }
  ],
  "presets": [{ "name": "Founder note" }]
}
{% endschema %}
