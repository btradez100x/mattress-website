{%- liquid
  assign brand = settings.brand_name | default: 'Aligna'
  assign note = section.settings.note | replace: '[Brand]', brand | replace: 'Aligna', brand
  assign portrait_alt = section.settings.name | append: ', founder of ' | append: brand
  assign portrait_caption = section.settings.portrait_caption
  if portrait_caption == blank
    assign portrait_caption = section.settings.name
  endif
-%}
{%- if section.settings.enable_section -%}
<section class="section founder-note" id="founder" data-reveal>
  <div class="page-width founder-note__grid">
    <figure class="founder-note__media" data-reveal-child style="--reveal-delay: 0ms">
      <div class="founder-note__portrait">
      {%- if section.settings.portrait != blank -%}
        {{
          section.settings.portrait
          | image_url: width: 900
          | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 900px) 28vw, 80vw', alt: portrait_alt
        }}
      {%- else -%}
        <img
          src="{{ 'founder-ben.jpg' | asset_url }}"
          alt="{{ portrait_alt | escape }}"
          width="800"
          height="800"
          loading="lazy"
        >
      {%- endif -%}
      </div>
      <figcaption class="founder-note__caption">{{ portrait_caption }}</figcaption>
    </figure>
    <div class="founder-note__copy">
      <p class="section__eyebrow" data-reveal-child style="--reveal-delay: 120ms">{{ section.settings.eyebrow }}</p>
      <hr class="gold-rule" data-reveal-child style="--reveal-delay: 180ms">
      <h2 data-reveal-child style="--reveal-delay: 240ms">{{ section.settings.heading }}</h2>
      <div class="founder-note__body rte" data-reveal-child style="--reveal-delay: 320ms">
        {{ note }}
      </div>
      <div class="founder-note__signoff" data-reveal-child style="--reveal-delay: 420ms">
        {%- if section.settings.signature_image != blank -%}
          {{
            section.settings.signature_image
            | image_url: width: 280
            | image_tag: loading: 'lazy', class: 'founder-note__signature', alt: ''
          }}
        {%- endif -%}
        <p class="founder-note__name">{{ section.settings.name }}</p>
        {%- if section.settings.role != blank -%}
          <p class="founder-note__role">{{ section.settings.role }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Founder note",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A note from the founder"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built from years of studying sleep."
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note (~80-120 words)",
      "default": "<p>I spent years studying my own sleep - tracking what restored me, what stole the morning, and what I needed when the day started early and focus mattered. [Brand] is the mattress that came from that work: deep support, a cooler sleep surface for warm climates, and a comfort top you can refresh instead of replacing the whole bed.</p><p>Each one is made to order. Cancel any time before dispatch for a full refund. If anything is unclear, message us - a person will reply.</p>",
      "info": "Use [Brand] - it is replaced by the global brand name setting."
    },
    {
      "type": "image_picker",
      "id": "portrait",
      "label": "Portrait",
      "info": "Optional. Falls back to the theme founder photo if empty."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Benjamin Maxwell"
    },
    {
      "type": "text",
      "id": "portrait_caption",
      "label": "Portrait caption",
      "default": "Benjamin Maxwell, founder"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Role",
      "default": "Founder"
    },
    {
      "type": "image_picker",
      "id": "signature_image",
      "label": "Signature image (optional)"
    }
  ],
  "presets": [{ "name": "Founder note" }]
}
{% endschema %}
