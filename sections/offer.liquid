{%- liquid
  capture market
    render 'size-market'
  endcapture
  assign market = market | strip
  assign payment_mode = settings.payment_mode | default: 'full'
  assign warranty = settings.warranty_years | default: '25' | strip
  if warranty == blank
    assign warranty = '25'
  endif
  if market == 'ae'
    assign top_price = section.settings.replacement_top_price_ae | default: 'A replacement comfort layer is AED 1,200. A new mattress is not.'
  else
    assign top_price = section.settings.replacement_top_price_gb | default: 'A replacement comfort layer is £299. A new mattress is not.'
  endif
  if payment_mode == 'full'
    assign cta_note_default = 'Pay in full today. Cancel any time before dispatch for a full refund.'
  else
    assign cta_note_default = 'Pay the first instalment today. Balance due before dispatch.'
  endif
-%}
{%- if section.settings.enable_section -%}
<section class="section{% render 'section-ground', fallback: 'dark' %}" id="offer" data-reveal data-section-ground="{% render 'section-ground', as: 'value', fallback: 'dark' %}">
  <div class="page-width">
    <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    {%- if market == 'ae' and section.settings.body_ae != blank -%}
      <p class="section__lede">{{ section.settings.body_ae }}</p>
    {%- elsif section.settings.body_gb != blank -%}
      <p class="section__lede">{{ section.settings.body_gb }}</p>
    {%- elsif section.settings.body != blank -%}
      <p class="section__lede">{{ section.settings.body }}</p>
    {%- endif -%}
    {%- if section.settings.replacement_frame != blank -%}
      <div class="rte section__lede offer__frame">{{ section.settings.replacement_frame }}</div>
    {%- endif -%}
    {%- if top_price != blank -%}
      <p class="offer__top-price">{{ top_price }}</p>
    {%- endif -%}

    <hr class="gold-rule gold-rule--measure">

    <div class="offer__items">
      {%- for block in section.blocks -%}
        {%- liquid
          assign show_item = true
          assign visibility = block.settings.market_visibility | default: 'all'
          if visibility == 'ae' and market != 'ae'
            assign show_item = false
          endif
          if visibility == 'gb' and market == 'ae'
            assign show_item = false
          endif
          assign block_mode = block.settings.payment_mode_visibility | default: 'all'
          if block_mode == 'full' and payment_mode != 'full'
            assign show_item = false
          endif
          if block_mode == 'split' and payment_mode != 'split'
            assign show_item = false
          endif
          assign title_down = block.settings.title | downcase
          assign text_down = block.settings.text | downcase
          assign is_chemicals_claim = false
          assign is_oeko_claim = false
          if title_down contains 'harmful chemicals'
            assign is_chemicals_claim = true
          endif
          if title_down contains 'oeko' or text_down contains 'oeko'
            assign is_oeko_claim = true
          endif
          if is_chemicals_claim and is_oeko_claim
            if settings.show_chemicals_claim != true or settings.show_oeko_tex_claim != true or settings.oeko_tex_certificate_no == blank
              assign show_item = false
            endif
          elsif is_chemicals_claim
            if settings.show_chemicals_claim != true
              assign show_item = false
            endif
          elsif is_oeko_claim
            if settings.show_oeko_tex_claim != true or settings.oeko_tex_certificate_no == blank
              assign show_item = false
            endif
          endif
        -%}
        {%- if show_item -%}
          {%- capture offer_title -%}{% render 'warranty-tokens', text: block.settings.title %}{%- endcapture -%}
          {%- capture offer_title -%}{% render 'trial-tokens', text: offer_title %}{%- endcapture -%}
          {%- capture offer_text -%}{% render 'warranty-tokens', text: block.settings.text %}{%- endcapture -%}
          {%- capture offer_text -%}{% render 'trial-tokens', text: offer_text %}{%- endcapture -%}
          {%- assign offer_title = offer_title | strip -%}
          {%- assign offer_text = offer_text | strip -%}
          {%- assign text_down_offer = offer_text | downcase -%}
          {%- if offer_title == blank and text_down_offer contains 'spring core' -%}
            {%- assign offer_title = warranty | append: '-year warranty' -%}
          {%- endif -%}
          <div class="offer__item" {{ block.shopify_attributes }}>
            <strong>{{ offer_title }}</strong>
            <span>{{ offer_text }}{% if is_oeko_claim %} · {{ settings.oeko_tex_certificate_no }}{% endif %}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="offer__cta" data-reveal-child style="--reveal-delay: 50ms">
        <a class="btn" href="{{ section.settings.cta_link | default: '#reserve' }}">
          {{ section.settings.cta_label }}
        </a>
        <p class="offer__cta-note">
          {{ section.settings.cta_note | default: cta_note_default }}
        </p>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Offer",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "select",
      "id": "ground",
      "label": "Section colour",
      "options": [
        {
          "value": "auto",
          "label": "Auto — keep neighbours distinct"
        },
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "surface",
          "label": "Stone"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "dark",
      "info": "Auto alternates off-white and stone when you reorder sections. Dark is for contrast only, used sparingly."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Buy with confidence"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Order with confidence."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body (fallback)",
      "default": "Made to order. Cancel any time before dispatch. Honest lead times."
    },
    {
      "type": "textarea",
      "id": "body_ae",
      "label": "Body (UAE)",
      "default": "Cancel any time before dispatch. Honest lead times. Delivery options confirmed at checkout."
    },
    {
      "type": "textarea",
      "id": "body_gb",
      "label": "Body (UK)",
      "default": "Cancel any time before dispatch. Honest lead times. Delivery options confirmed at checkout."
    },
    {
      "type": "richtext",
      "id": "replacement_frame",
      "label": "Replacement-frequency frame (optional)",
      "default": "<p>Most mattresses get replaced every seven or eight years because the top layer wears out. Ours is built so you replace the layer instead.</p>",
      "info": "Anchors on replacement frequency, not competitor price. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "replacement_top_price_gb",
      "label": "Replacement top price line (UK)",
      "default": "A replacement comfort layer is £299. A new mattress is not."
    },
    {
      "type": "text",
      "id": "replacement_top_price_ae",
      "label": "Replacement top price line (UAE)",
      "default": "A replacement comfort layer is AED 1,200. A new mattress is not."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "See sizes and prices"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "CTA link",
      "default": "#reserve",
      "info": "Use a path or in-page anchor such as #reserve. Must stay a text setting, not a URL picker."
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "CTA note override",
      "info": "Leave blank for payment-mode default."
    }
  ],
  "blocks": [
    {
      "type": "offer_item",
      "name": "Offer line",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "[N]-night trial",
          "info": "Leave blank when supporting text is the spring-core line to use Theme settings → Warranty years. Or write [X]-year warranty."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting text",
          "default": "Sleep on it. Decide at home."
        },
        {
          "type": "select",
          "id": "market_visibility",
          "label": "Show in market",
          "options": [
            { "value": "all", "label": "All markets" },
            { "value": "ae", "label": "UAE only" },
            { "value": "gb", "label": "UK only" }
          ],
          "default": "all"
        },
        {
          "type": "select",
          "id": "payment_mode_visibility",
          "label": "Show for payment mode",
          "options": [
            { "value": "all", "label": "All modes" },
            { "value": "full", "label": "Full payment only" },
            { "value": "split", "label": "Split payment only" }
          ],
          "default": "all"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Offer",
      "blocks": [
        {
          "type": "offer_item",
          "settings": { "title": "[N]-night trial", "text": "Sleep on it. Decide at home." }
        },
        {
          "type": "offer_item",
          "settings": { "title": "[X]-year warranty", "text": "On the spring core." }
        },
        {
          "type": "offer_item",
          "settings": {
            "title": "Made to order",
            "text": "Built after you order it, never from stock."
          }
        },
        {
          "type": "offer_item",
          "settings": {
            "title": "Cancel before dispatch",
            "text": "Full refund any time before your mattress ships.",
            "payment_mode_visibility": "full"
          }
        },
        {
          "type": "offer_item",
          "settings": {
            "title": "Pay part today",
            "text": "First payment now, balance before dispatch.",
            "payment_mode_visibility": "split"
          }
        }
      ]
    }
  ]
}
{% endschema %}
