    "story": {
      "type": "lp",
      "blocks": {
        "b2": {
          "type": "prose",
          "settings": {
            "ground": "",
            "tight": true,
            "anchor_id": "",
            "kicker": "Two problems",
            "heading": "Support and comfort\nare not the same job.",
            "body_1": "Most mattresses solve both with the same five centimetres, which is why fixing one makes the other worse. Softer for the shoulder means less under the hip. Firmer for the back means pressure at the shoulder.",
            "body_2": "Ours separates them. The core holds. The layer adapts.",
            "pull": "Ours separates them. The core holds. The layer adapts."
          }
        },
        "b3": {
          "type": "split",
          "settings": {
            "ground": "",
            "reverse": true,
            "kicker": "The core",
            "heading": "Seven zones along the bed",
            "body_1": "Your hips are the heaviest part of you and they sink first. On a single-tension mattress that tips the spine out of line for eight hours, and you feel it at seven in the morning rather than at eleven at night.",
            "body_2": "Heavier two millimetre wire sits under the hips and shoulders. One point eight everywhere else. Each spring in its own pocket, so one person turning over does not move the other.",
            "pull": "",
            "image_file": "coolknit-side.webp",
            "image_alt": ""
          }
        },
        "b4": {
          "type": "split",
          "settings": {
            "ground": "bone",
            "reverse": true,
            "kicker": "Adjust to Desire",
            "heading": "You do not have to\nget it right.",
            "body_1": "Which is fortunate, because nobody can. Firm or soft, medium or medium firm, it is an impossible question to answer before you have slept on it.",
            "body_2": "So you do not answer it. Sleep on it, tell us where it is wrong, and we make a new comfort layer to that description. With our compliments, for a year.",
            "pull": "",
            "image_file": "product-floating.webp",
            "image_alt": ""
          }
        },
        "b5": {
          "type": "assurance",
          "settings": {
            "a1_heading": "You cannot get this wrong",
            "a1_body": "A year to tell us how it should feel. We remake the comfort layer to that, with our compliments, as often as it takes.",
            "a2_heading": "100 days to change your mind",
            "a2_body": "Collected from your home and refunded in full. Emperor is made to order and excluded.",
            "a3_heading": "25 years on the core",
            "a3_body": "The part that carries you is guaranteed for a quarter of a century.",
            "ground": ""
          }
        }
      },
