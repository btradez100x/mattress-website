    "story": {
      "type": "lp",
      "blocks": {
        "b2": {
          "type": "cards",
          "settings": {
            "ground": "",
            "anchor_id": "",
            "kicker": "Three things that matter",
            "heading": "What makes a mattress\nstill good in twenty years",
            "card_1_heading": "Pocket springs, individually housed",
            "card_1_body": "Twenty centimetres, seven zones, two wire gauges. Each spring moves alone, so one person turning over does not move the other.",
            "card_2_heading": "A comfort layer that comes out",
            "card_2_body": "The top five centimetres are what soften. Ours unzip and lift away, so the bed is renewed rather than replaced.",
            "card_3_heading": "Made after you order it",
            "card_3_body": "No warehouse, no stock to clear, no last season's tension to move on. It takes weeks rather than days.",
            "layout": "grid",
            "lede": "",
            "card_1_label": "",
            "card_2_label": "",
            "card_3_label": ""
          }
        },
        "b3": {
          "type": "prose",
          "settings": {
            "ground": "dark",
            "tight": false,
            "anchor_id": "",
            "kicker": "Why we can promise that",
            "heading": "Because nothing is\nbuilt until you order.",
            "body_1": "No warehouse. No stock bought last quarter at last quarter's specification. No clearance sale, ever, because there is nothing to clear. Your mattress is wound, pocketed, layered and closed after you have chosen it, to the size you chose.",
            "body_2": "That is why the guarantee can be twenty five years, and why the comfort layer can be remade for a year. We are not managing inventory. We are making your bed.",
            "pull": ""
          }
        },
        "b4": {
          "type": "media",
          "settings": {
            "image_file": "room-calm.webp",
            "image_alt": ""
          }
        },
        "b5": {
          "type": "prose",
          "settings": {
            "ground": "",
            "tight": false,
            "anchor_id": "",
            "kicker": "Why you cannot choose in a showroom",
            "heading": "Four minutes lying down\ntells you nothing.",
            "body_1": "You cannot know how a mattress feels until you have slept on it for weeks. By then the decision is behind you and the money is spent, which is why most people keep a mattress they never liked.",
            "body_2": "So you do not choose a firmness when you order. Your mattress arrives, you sleep on it, and for a year you tell us how it should feel. We build a new comfort layer to that description and send it, with our compliments.",
            "pull": "You do not choose the feel. You discover it."
          }
        },
        "b6": {
          "type": "price",
          "settings": {
            "kicker": "What it costs",
            "heading": "From £1,999.",
            "body": "King is £2,999. Super King is £3,299. Every size is the same build, so the price is the size and nothing else.",
            "price_from": "From £1,999.",
            "price_klarna": "or £83 a month with Klarna",
            "show_pay": true,
            "pay_label": "Pay by",
            "klarna_amount": "£83 a month",
            "show_sizestrip": true,
            "sizestrip_rows": "Double|135 x 190 cm\nKing|150 x 200 cm\nEuropean King|160 x 200 cm\nSuper King|180 x 200 cm\nEmperor|200 x 200 cm"
          }
        },
        "b7": {
          "type": "cards",
          "settings": {
            "ground": "",
            "anchor_id": "",
            "kicker": "What arriving looks like",
            "heading": "It arrives finished.",
            "card_1_heading": "Concierged in",
            "card_1_body": "To the room you choose, unboxed, unrolled onto your bed and positioned. The packaging leaves with it.",
            "card_2_heading": "The old one leaves",
            "card_2_body": "Taken away and sent for recycling. We carry the cost.",
            "card_3_heading": "A window you agree",
            "card_3_body": "We call before we come, and arrange a time that suits you. Nothing arrives unannounced.",
            "layout": "arrive",
            "lede": "Not left in a hallway in a box for you to wrestle upstairs.",
            "card_1_label": "On the day",
            "card_2_label": "Same visit",
            "card_3_label": "Beforehand"
          }
        },
        "b8": {
          "type": "assurance",
          "settings": {
            "a1_heading": "You cannot get this wrong",
            "a1_body": "A year to tell us how it should feel. We remake the comfort layer to that, with our compliments, as often as it takes.",
            "a2_heading": "100 days to change your mind",
            "a2_body": "Collected from your home and refunded in full. Emperor is made to order and excluded.",
            "a3_heading": "25 years on the core",
            "a3_body": "The part that carries you is guaranteed for a quarter of a century.",
            "ground": ""
          }
        }
      },
