            "icon": "adapt",
            "heading": "A bed that adapts",
            "text": "Swap the top to change firmness \u2014 as your body, your partner, or your preferences change."
          }
        },
        "b2": {
          "type": "benefit",
          "settings": {
            "icon": "cool",
            "heading": "Cool by design",
            "text": "A breathable cool-knit cover and gel-infused comfort layer, made for warm nights."
          }
        },
        "b3": {
          "type": "benefit",
          "settings": {
            "icon": "support",
            "heading": "Deep, engineered support",
            "text": "A 20cm, 7-zone pocket-spring core and high-density base keep your spine aligned."
          }
        },
        "b4": {
          "type": "benefit",
          "settings": {
            "icon": "enduring",
            "heading": "Built to keep",
            "text": "Refresh the top instead of replacing the mattress \u2014 less waste, less cost over time."
          }
        }
