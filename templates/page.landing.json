    "faq": {
      "type": "faq",
      "blocks": {
        "f1": {
          "type": "item",
          "settings": {
            "question": "What does the deposit do?",
            "answer": "It reserves your mattress in the current allocation. Fully refundable any time before dispatch."
          }
        },
        "f2": {
          "type": "item",
          "settings": {
            "question": "When will it ship?",
            "answer": "Each mattress is made to order. Current window: [X-Y]. We confirm your date before dispatch."
          }
        },
        "f3": {
          "type": "item",
          "settings": {
            "question": "Which size should I choose?",
            "answer": "Use the size selector \u2014 dimensions always shown in cm. UAE and UK sizes differ."
          }
        },
        "f4": {
          "type": "item",
          "settings": {
            "question": "How does the replaceable top work?",
            "answer": "Unzip, lift out, swap in. Tops come in soft, medium and firm."
          }
        },
        "f5": {
          "type": "item",
          "settings": {
            "question": "What if it is not right for me?",
            "answer": "You have a 100-night trial per the active offer terms."
          }
        },
        "f6": {
          "type": "item",
          "settings": {
            "question": "What is the warranty?",
            "answer": "[X]-year warranty on the spring core."
          }
        },
        "f7": {
          "type": "item",
          "settings": {
            "question": "Can I pay cash on delivery?",
            "answer": "Because each mattress is made to order, we take a small refundable deposit to reserve your size. The balance is due only once we confirm your dispatch date \u2014 and the deposit is refundable in full at any point before dispatch."
          }
        }
      },
      "block_order": [
