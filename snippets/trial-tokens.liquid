{%- comment -%}
  Resolve the return window in copy. Theme settings → Nights to return it.
  Tokens: [N]  [N]-night  {{ settings.trial_nights }}
  The adjustment year is never a night count.
{%- endcomment -%}
{%- liquid
  assign trial = settings.trial_nights | default: 100 | append: '' | strip
  if trial == blank or trial == '0'
    assign trial = '100'
  endif
  assign trial_phrase = trial | append: '-night'
  assign out = text | default: ''
  assign out = out | replace: '{{ settings.trial_nights }}', trial
  assign out = out | replace: '[N]-night', trial_phrase
  assign out = out | replace: '[N]', trial
-%}
{{- out -}}
