{% comment %}
  Deprecated for layout render as of 13.0.11 recovery.
  Keep file so Shopify sync does not 404 if an old theme.liquid still renders it.
  The live guard now lives inline in layout/theme.liquid (CSS only).
{% endcomment %}
<style id="float-basket-fix-snippet">
html body .float-basket:not(.has-items):not(.is-active){pointer-events:none!important}
html body .float-basket[hidden]:not(.has-items):not(.is-active),
html body:has([data-size-reserve]) .float-basket:not(.has-items):not(.is-active),
html body:has([data-lp-configure]) .float-basket:not(.has-items):not(.is-active){
  display:none!important;visibility:hidden!important;pointer-events:none!important;
}
html body .float-basket.has-items,
html body .float-basket.is-active{
  display:flex!important;visibility:visible!important;pointer-events:auto!important;
  background:var(--brand-primary,#1f3a5f)!important;
}
</style>
