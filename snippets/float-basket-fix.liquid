{% comment %}
  Inline float-basket recovery 13.0.9. Shopify GitHub sync was leaving
  base.css / theme.js stale on the CDN; shipping this in Liquid guarantees
  the fix lands with the layout publish.

  Critical: empty bars must never cover ADD or eat taps on size pages.
  PR review marker: cursor/fix-basket-add-blocked-1b6d
{% endcomment %}
<style id="float-basket-fix">
/* Empty bars never steal taps; CTA button stays clickable on marketing. */
.float-basket:not(.has-items):not(.is-active){pointer-events:none!important}
.float-basket:not(.has-items):not(.is-active) .float-basket__btn,
.float-basket:not(.has-items):not(.is-active) a.float-basket__btn{pointer-events:auto!important}

/* [hidden] empty bars: fully gone (beats stale CDN flex rules). */
html body .float-basket[hidden]:not(.has-items):not(.is-active),
html body.has-sticky-reserve .float-basket[hidden]:not(.has-items):not(.is-active){
  display:none!important;
  visibility:hidden!important;
  opacity:0!important;
  pointer-events:none!important;
  transform:none!important;
  max-height:0!important;
  min-height:0!important;
  padding:0!important;
  overflow:hidden!important;
}

/* Size / funnel pages: hard-hide empty bars so ADD is never covered. */
html body:has([data-size-reserve]) .float-basket:not(.has-items):not(.is-active),
html body:has([data-lp-configure]) .float-basket:not(.has-items):not(.is-active),
html body.has-sticky-reserve:has([data-size-reserve]) .float-basket:not(.has-items):not(.is-active),
html body.has-sticky-reserve:has([data-lp-configure]) .float-basket:not(.has-items):not(.is-active){
  display:none!important;
  visibility:hidden!important;
  opacity:0!important;
  pointer-events:none!important;
  transform:none!important;
  max-height:0!important;
  min-height:0!important;
  padding:0!important;
  overflow:hidden!important;
}

/* Lined basket only */
html body .float-basket.has-items,
html body .float-basket.is-active,
html body.has-sticky-reserve .float-basket.has-items,
html body.has-sticky-reserve .float-basket.is-active{
  display:flex!important;
  visibility:visible!important;
  opacity:1!important;
  transform:translateY(0)!important;
  pointer-events:auto!important;
  background:var(--brand-primary,#1f3a5f)!important;
  background-color:var(--brand-primary,#1f3a5f)!important;
  color:var(--brand-on-dark,#f7f5f1)!important;
  min-height:calc(3.25rem + env(safe-area-inset-bottom,0px));
  max-height:none!important;
  padding:0.85rem var(--space-gutter,1.25rem) calc(0.85rem + env(safe-area-inset-bottom,0px))!important;
  z-index:55;
}
.float-basket.has-items .float-basket__count,
.float-basket.has-items .float-basket__total,
.float-basket.is-active .float-basket__count,
.float-basket.is-active .float-basket__total{
  color:var(--brand-on-dark,#f7f5f1)!important;
  -webkit-text-fill-color:var(--brand-on-dark,#f7f5f1)!important;
  opacity:1!important;
  visibility:visible!important;
}
.float-basket.has-items .float-basket__btn,
.float-basket.is-active .float-basket__btn,
.float-basket.has-items a.float-basket__btn,
.float-basket.is-active a.float-basket__btn{
  background:var(--brand-on-dark,#f7f5f1)!important;
  color:var(--brand-primary,#1f3a5f)!important;
  -webkit-text-fill-color:var(--brand-primary,#1f3a5f)!important;
  opacity:1!important;
  visibility:visible!important;
  pointer-events:auto!important;
}
body.has-sticky-reserve{padding-bottom:0!important}
body.has-sticky-reserve .site-footer{
  padding-bottom:calc(2.25rem + var(--float-basket-space,5.5rem))!important;
  background:var(--brand-primary,#1f3a5f)!important;
}
@media (max-width:980px){
  body.has-sticky-reserve:has([data-size-reserve]) .size-list,
  body.has-sticky-reserve:has([data-size-reserve]) .size-rows,
  body.has-sticky-reserve:has([data-lp-configure]) .size-list,
  body.has-sticky-reserve:has([data-lp-configure]) .size-rows{
    padding-bottom:calc(var(--float-basket-space,5.5rem) + 1.25rem);
  }
}
.order-sheet[hidden]:not(.is-open):not(.on){display:none!important}
</style>
<script src="{{ 'float-basket-fix.js' | asset_url }}" defer></script>
