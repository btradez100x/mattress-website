{%- comment -%}
  Every mattress variant as JSON. No market, SIZE_MAPS, or title allowlist.
  Includes price 0, inventory 0, and US/AU/UAE titles.
  available_for_sale is not required — made-to-order sizes with 0 inventory still emit.
  Expects: mattress (product)
{%- endcomment -%}
[
{%- assign catalog_first = true -%}
{%- if mattress != blank -%}
  {%- for v in mattress.variants -%}
    {%- unless catalog_first -%},{%- endunless -%}
    {%- render 'size-variant-json', v: v -%}
    {%- assign catalog_first = false -%}
  {%- endfor -%}
{%- endif -%}
]
