{%- comment -%}
  Every mattress variant as JSON, including price 0, inventory 0, and
  US/AU/UAE titles. SIZE_MAPS is not a live ceiling. The picker and size
  guide then keep only rows whose Market Shown (custom.market_shown) includes
  the browser country. Blank Market Shown uses in_market, not "show all 18".
  Expects: mattress (product)
{%- endcomment -%}
[
{%- assign catalog_first = true -%}
{%- if mattress != blank -%}
  {%- for v in mattress.variants -%}
    {%- unless catalog_first -%},{%- endunless -%}
    {%- render 'size-variant-json', v: v -%}
    {%- assign catalog_first = false -%}
  {%- endfor -%}
{%- endif -%}
]
