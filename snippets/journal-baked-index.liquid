{%- comment -%}
  Baked Journal index (cards + in-page article panels).
  Generated by scripts/bake-journal-articles.py. Do not delete.
  Published Shopify blog posts win when present; baked notes fill the rest.
{%- endcomment -%}
{%- liquid
  assign journal_blog = blogs['journal']
  assign published = ','
  if journal_blog.articles_count > 0
    for article in journal_blog.articles
      assign published = published | append: article.handle | append: ','
    endfor
  endif
-%}

<div class="journal-with-panels">
  <div class="journal-index-view" id="journal-index">
    <ul class="blog-index__grid" role="list">
      {%- if journal_blog.articles_count > 0 -%}
        {%- for article in journal_blog.articles limit: 12 -%}
          <li class="blog-card" data-reveal-child style="--reveal-delay: {{ forloop.index0 | times: 50 }}ms">
            <a class="blog-card__link" href="{{ article.url }}">
              {%- if article.image -%}
                <div class="blog-card__media">
                  {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,800,1200', sizes: '(min-width: 1100px) 30vw, 90vw', alt: article.image.alt | default: article.title }}
                </div>
              {%- else -%}
                <div class="blog-card__media blog-card__media--empty" aria-hidden="true"></div>
              {%- endif -%}
              <div class="blog-card__body">
                {%- if article.tags.size > 0 -%}
                  <p class="blog-card__tag">{{ article.tags.first }}</p>
                {%- endif -%}
                <h2 class="blog-card__title">{{ article.title }}</h2>
                {%- if article.excerpt != blank -%}
                  <p class="blog-card__excerpt">{{ article.excerpt | strip_html | truncate: 160 }}</p>
                {%- else -%}
                  <p class="blog-card__excerpt">{{ article.content | strip_html | truncate: 160 }}</p>
                {%- endif -%}
                <p class="blog-card__meta">
                  <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%-d %b %Y' }}</time>
                  <span aria-hidden="true"> · </span><span>Ben Acolatse, CEO</span>
                </p>
              </div>
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
      {%- unless published contains ',how-to-choose-a-mattress,' -%}
        <li class="blog-card" data-reveal-child style="--reveal-delay: 0ms">
          <a class="blog-card__link" href="{% render 'journal-article-href', article_handle: 'how-to-choose-a-mattress' %}">
            <div class="blog-card__media blog-card__media--empty" aria-hidden="true"></div>
            <div class="blog-card__body">
              <p class="blog-card__tag">Buying guide</p>
              <h2 class="blog-card__title">How to Choose a Mattress: A Practical Buying Guide</h2>
              <p class="blog-card__excerpt">A calm, research-informed guide to choosing a mattress: sleep position, firmness, materials, size, and what actually matters for long-term comfort.</p>
              <p class="blog-card__meta">
                <time datetime="2026-08-12">12 Aug 2026</time>
                <span aria-hidden="true"> · </span><span>Ben Acolatse, CEO</span>
              </p>
            </div>
          </a>
        </li>
      {%- endunless -%}
      {%- unless published contains ',mattress-firmness-guide,' -%}
        <li class="blog-card" data-reveal-child style="--reveal-delay: 50ms">
          <a class="blog-card__link" href="{% render 'journal-article-href', article_handle: 'mattress-firmness-guide' %}">
            <div class="blog-card__media blog-card__media--empty" aria-hidden="true"></div>
            <div class="blog-card__body">
              <p class="blog-card__tag">Firmness</p>
              <h2 class="blog-card__title">Mattress Firmness Guide: Soft, Medium and Firm Explained</h2>
              <p class="blog-card__excerpt">Soft, medium or firm? A clear firmness guide for real sleepers - by position, body type and what “support” actually means.</p>
              <p class="blog-card__meta">
                <time datetime="2026-08-12">12 Aug 2026</time>
                <span aria-hidden="true"> · </span><span>Ben Acolatse, CEO</span>
              </p>
            </div>
          </a>
        </li>
      {%- endunless -%}
      {%- unless published contains ',cooler-sleep-and-mattress-materials,' -%}
        <li class="blog-card" data-reveal-child style="--reveal-delay: 100ms">
          <a class="blog-card__link" href="{% render 'journal-article-href', article_handle: 'cooler-sleep-and-mattress-materials' %}">
            <div class="blog-card__media blog-card__media--empty" aria-hidden="true"></div>
            <div class="blog-card__body">
              <p class="blog-card__tag">Cool sleep</p>
              <h2 class="blog-card__title">Sleeping Hot? How Mattress Materials Affect Cooler Sleep</h2>
              <p class="blog-card__excerpt">Heat is one of the top reasons mattresses fail in real homes. Here is how covers, foams and spring units influence cooler sleep - especially in warm climates.</p>
              <p class="blog-card__meta">
                <time datetime="2026-08-12">12 Aug 2026</time>
                <span aria-hidden="true"> · </span><span>Ben Acolatse, CEO</span>
              </p>
            </div>
          </a>
        </li>
      {%- endunless -%}
      {%- unless published contains ',mattress-support-and-back-comfort,' -%}
        <li class="blog-card" data-reveal-child style="--reveal-delay: 150ms">
          <a class="blog-card__link" href="{% render 'journal-article-href', article_handle: 'mattress-support-and-back-comfort' %}">
            <div class="blog-card__media blog-card__media--empty" aria-hidden="true"></div>
            <div class="blog-card__body">
              <p class="blog-card__tag">Support</p>
              <h2 class="blog-card__title">Mattress Support and Back Comfort: What Actually Helps</h2>
              <p class="blog-card__excerpt">Back comfort is about alignment and pressure relief - not the hardest mattress in the shop. Here is what to look for, carefully and honestly.</p>
              <p class="blog-card__meta">
                <time datetime="2026-08-12">12 Aug 2026</time>
                <span aria-hidden="true"> · </span><span>Ben Acolatse, CEO</span>
              </p>
            </div>
          </a>
        </li>
      {%- endunless -%}
      {%- unless published contains ',when-to-replace-a-mattress,' -%}
        <li class="blog-card" data-reveal-child style="--reveal-delay: 200ms">
          <a class="blog-card__link" href="{% render 'journal-article-href', article_handle: 'when-to-replace-a-mattress' %}">
            <div class="blog-card__media blog-card__media--empty" aria-hidden="true"></div>
            <div class="blog-card__body">
              <p class="blog-card__tag">Longevity</p>
              <h2 class="blog-card__title">When to Replace a Mattress (And When to Refresh the Top)</h2>
              <p class="blog-card__excerpt">Most beds wear out from the top down. Learn the replacement signs - and why refreshing the comfort layer can beat binning the whole mattress.</p>
              <p class="blog-card__meta">
                <time datetime="2026-08-12">12 Aug 2026</time>
                <span aria-hidden="true"> · </span><span>Ben Acolatse, CEO</span>
              </p>
            </div>
          </a>
        </li>
      {%- endunless -%}
      {%- unless published contains ',hybrid-vs-foam-vs-innerspring,' -%}
        <li class="blog-card" data-reveal-child style="--reveal-delay: 250ms">
          <a class="blog-card__link" href="{% render 'journal-article-href', article_handle: 'hybrid-vs-foam-vs-innerspring' %}">
            <div class="blog-card__media blog-card__media--empty" aria-hidden="true"></div>
            <div class="blog-card__body">
              <p class="blog-card__tag">Mattress types</p>
              <h2 class="blog-card__title">Hybrid vs Foam vs Innerspring Mattresses: Which Is Right?</h2>
              <p class="blog-card__excerpt">A clear comparison of hybrid, all-foam and traditional innerspring beds - feel, temperature, motion and who each type suits.</p>
              <p class="blog-card__meta">
                <time datetime="2026-08-12">12 Aug 2026</time>
                <span aria-hidden="true"> · </span><span>Ben Acolatse, CEO</span>
              </p>
            </div>
          </a>
        </li>
      {%- endunless -%}
    </ul>
  </div>

  {%- unless published contains ',how-to-choose-a-mattress,' -%}
    <article class="journal-article-panel section article" id="how-to-choose-a-mattress" itemscope itemtype="https://schema.org/Article">
      {% render 'journal-article-layout', article_handle: 'how-to-choose-a-mattress' %}
    </article>
  {%- endunless -%}
  {%- unless published contains ',mattress-firmness-guide,' -%}
    <article class="journal-article-panel section article" id="mattress-firmness-guide" itemscope itemtype="https://schema.org/Article">
      {% render 'journal-article-layout', article_handle: 'mattress-firmness-guide' %}
    </article>
  {%- endunless -%}
  {%- unless published contains ',cooler-sleep-and-mattress-materials,' -%}
    <article class="journal-article-panel section article" id="cooler-sleep-and-mattress-materials" itemscope itemtype="https://schema.org/Article">
      {% render 'journal-article-layout', article_handle: 'cooler-sleep-and-mattress-materials' %}
    </article>
  {%- endunless -%}
  {%- unless published contains ',mattress-support-and-back-comfort,' -%}
    <article class="journal-article-panel section article" id="mattress-support-and-back-comfort" itemscope itemtype="https://schema.org/Article">
      {% render 'journal-article-layout', article_handle: 'mattress-support-and-back-comfort' %}
    </article>
  {%- endunless -%}
  {%- unless published contains ',when-to-replace-a-mattress,' -%}
    <article class="journal-article-panel section article" id="when-to-replace-a-mattress" itemscope itemtype="https://schema.org/Article">
      {% render 'journal-article-layout', article_handle: 'when-to-replace-a-mattress' %}
    </article>
  {%- endunless -%}
  {%- unless published contains ',hybrid-vs-foam-vs-innerspring,' -%}
    <article class="journal-article-panel section article" id="hybrid-vs-foam-vs-innerspring" itemscope itemtype="https://schema.org/Article">
      {% render 'journal-article-layout', article_handle: 'hybrid-vs-foam-vs-innerspring' %}
    </article>
  {%- endunless -%}
</div>
