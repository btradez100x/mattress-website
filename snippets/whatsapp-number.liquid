{%- comment -%}
  Outputs the WhatsApp number for the active market (digits preferred).
  Falls back to that market’s phone, then legacy whatsapp_number / contact_phone.
{%- endcomment -%}
{%- liquid
  assign m = settings.default_market | default: 'ae'
  if localization.country.iso_code == 'GB'
    assign m = 'gb'
  elsif localization.country.iso_code == 'AE'
    assign m = 'ae'
  endif

  if m == 'gb'
    assign phone = settings.contact_phone_gb | default: settings.contact_phone | default: ''
    echo settings.whatsapp_number_gb | default: settings.whatsapp_number | default: phone
  else
    assign phone = settings.contact_phone_ae | default: settings.contact_phone | default: ''
    echo settings.whatsapp_number_ae | default: settings.whatsapp_number | default: phone
  endif
-%}
