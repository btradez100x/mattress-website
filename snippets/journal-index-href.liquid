{%- comment -%}
  Journal index URL. Prefer a blog that actually has articles so live
  Journal content is not hidden behind an empty Page.
{%- endcomment -%}
{%- if blogs['journal'].articles_count > 0 -%}
  {{- blogs['journal'].url -}}
{%- elsif pages['journal'].handle == 'journal' -%}
  {{- pages['journal'].url -}}
{%- elsif blogs['journal'].handle == 'journal' -%}
  {{- blogs['journal'].url -}}
{%- else -%}
  /pages/journal
{%- endif -%}
