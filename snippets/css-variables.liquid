{% comment %}
  Design tokens from theme settings (Spec S5.1).
  Page/section token overrides can set inline --brand-* on a wrapper.
{% endcomment %}
{% style %}
  :root {
    --brand-primary: {{ settings.color_primary }};
    --brand-accent: {{ settings.color_accent }};
    --brand-bg: {{ settings.color_bg }};
    --brand-surface: {{ settings.color_surface }};
    --brand-ink: {{ settings.color_ink }};
    --brand-on-dark: {{ settings.color_on_dark }};

    --font-serif: {% case settings.font_serif %}
      {% when 'fraunces' %}'Fraunces', Georgia, serif
      {% when 'playfair' %}'Playfair Display', Georgia, serif
      {% else %}'Cormorant Garamond', Georgia, serif
    {% endcase %};
    --font-sans: {% case settings.font_sans %}
      {% when 'work_sans' %}'Work Sans', system-ui, sans-serif
      {% when 'inter' %}'Inter', system-ui, sans-serif
      {% else %}'Manrope', system-ui, sans-serif
    {% endcase %};

    --wordmark-tracking: {{ settings.wordmark_tracking | divided_by: 100.0 }}em;
    --space-section: clamp(4.5rem, 10vw, 7.5rem);
    --space-gutter: clamp(1.25rem, 4vw, 2.5rem);
    --max-width: 72rem;
    --max-width-narrow: 40rem;
    --radius: 0;
    --transition: 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }
{% endstyle %}
