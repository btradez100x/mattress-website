{% comment %}
  Onni & Osher logo lockup
  ------------------------------------------------------------------
  Wordmark and descriptor come from Theme settings → Brand
  (brand_name + brand_product_line). Type, colour, and Ember are
  Theme settings → Logo lockup.

  Usage:
    {% render 'oo-logo' %}
    {% render 'oo-logo', lockup: 'three', reverse: true %}
    {% render 'oo-logo', size: 40, size_mobile: 28, align: 'center', accent: true %}
    {% render 'oo-logo', tag: 'div', link: false %}

  Parameters (all optional):
    lockup       'two' | 'three' | 'wordmark'   default: settings.oo_logo_lockup
    size         wordmark size in px (desktop)  default: settings.oo_logo_size
    size_mobile  wordmark size in px (mobile)   default: settings.oo_logo_size_mobile
    reverse      true to use the on-dark colours
    palette      'basket' | 'v3' to override the colour set
    accent       true to force Ember on the joining symbol
    align        'left' | 'center'              default: settings.oo_logo_align
    link         false to render without a link (default links to the home page)
    class        extra class names
    id           unique id when rendering more than once on a page (default 'header')
{% endcomment %}

{%- liquid
  assign lockup = lockup | default: settings.oo_logo_lockup
  assign size = size | default: settings.oo_logo_size
  assign size_mobile = size_mobile | default: settings.oo_logo_size_mobile
  assign align = align | default: settings.oo_logo_align
  assign uid = id | default: 'header'
  assign raw_name = settings.brand_name | default: 'Numa' | strip
  assign product_line = settings.brand_product_line | default: '' | strip

  if accent == nil or accent == blank
    assign accent = settings.oo_logo_amp_accent
  endif
  if link == nil
    assign link = true
  endif

  assign palette = palette | default: settings.oo_logo_palette
  if palette == 'v3'
    if reverse
      assign colour = settings.oo_logo_v3_colour_reverse
      assign descriptor_colour = settings.oo_logo_v3_descriptor_colour_reverse
    else
      assign colour = settings.oo_logo_v3_colour
      assign descriptor_colour = settings.oo_logo_v3_descriptor_colour
    endif
  elsif reverse
    assign colour = settings.oo_logo_colour_reverse
    assign descriptor_colour = settings.oo_logo_descriptor_colour_reverse
  else
    assign colour = settings.oo_logo_colour
    assign descriptor_colour = settings.oo_logo_descriptor_colour
  endif

  if accent == true or accent == 'ember' or accent == 'true'
    if reverse
      assign amp_colour = settings.oo_logo_accent_colour_reverse
    else
      assign amp_colour = settings.oo_logo_accent_colour
    endif
  elsif accent == 'stone'
    assign amp_colour = settings.oo_logo_stone_colour | default: colour
  else
    assign amp_colour = colour
  endif

  comment
    Any symbol in a wordmark line is wrapped so it takes the symbol weight
    and optional Ember colour. Letters and digits are left alone.
  endcomment
  assign symbols = '&amp;,+,/,×,·,•,|,~,*,–,-,—,=,°,@,^' | split: ','

  if lockup == 'three'
    if raw_name contains '&'
      assign amp_parts = raw_name | split: '&'
      assign raw_1 = amp_parts.first | strip | append: ' &'
      assign raw_2 = raw_name | remove_first: amp_parts.first | remove_first: '&' | strip
    elsif raw_name contains ' '
      assign words = raw_name | split: ' '
      assign raw_1 = words.first
      assign raw_2 = raw_name | remove_first: words.first | strip
    else
      assign raw_1 = raw_name
      assign raw_2 = ''
    endif
    assign descriptor = product_line | escape
    assign descriptor_scale = settings.oo_logo_descriptor_scale | minus: 6
  else
    assign raw_1 = raw_name
    assign raw_2 = ''
    assign descriptor = product_line | escape
    assign descriptor_scale = settings.oo_logo_descriptor_scale
  endif

  assign line_1 = raw_1 | append: ' ' | escape | replace: ' x ', ' × ' | strip
  assign line_2 = raw_2 | append: ' ' | escape | replace: ' x ', ' × ' | strip
  for sym in symbols
    assign marker = '[[' | append: forloop.index0 | append: ']]'
    assign line_1 = line_1 | replace: sym, marker
    assign line_2 = line_2 | replace: sym, marker
  endfor
  for sym in symbols
    assign marker = '[[' | append: forloop.index0 | append: ']]'
    assign wrapped = '<span class="oo-logo__sym">' | append: sym | append: '</span>'
    assign line_1 = line_1 | replace: marker, wrapped
    assign line_2 = line_2 | replace: marker, wrapped
  endfor

  if lockup == 'wordmark'
    assign descriptor = ''
  endif

  assign tracking = settings.oo_logo_tracking | times: 0.01
  assign line_height = settings.oo_logo_line_height | times: 0.01
  assign descriptor_ratio = descriptor_scale | times: 0.01
  assign descriptor_gap = settings.oo_logo_descriptor_gap | times: 0.01
  assign show_descriptor = true
  if descriptor == blank or size_mobile < settings.oo_logo_descriptor_min
    assign show_descriptor = false
  endif

  assign label = raw_name
  if show_descriptor
    assign label = label | append: ', ' | append: product_line
  endif

  if link
    assign tag = 'a'
  else
    assign tag = tag | default: 'div'
  endif
-%}

{%- style -%}
  .oo-logo-{{ uid }}{
    --oo-size:{{ size }}px;
    --oo-weight:{{ settings.oo_logo_weight }};
    --oo-amp-weight:{{ settings.oo_logo_amp_weight }};
    --oo-tracking:{{ tracking }}em;
    --oo-line-height:{{ line_height }};
    --oo-descriptor-ratio:{{ descriptor_ratio }};
    --oo-descriptor-gap:{{ descriptor_gap }};
    --oo-colour:{{ colour }};
    --oo-descriptor-colour:{{ descriptor_colour }};
    --oo-amp-colour:{{ amp_colour }};
  }
  @media screen and (max-width: 749px){
    .oo-logo-{{ uid }}{ --oo-size:{{ size_mobile }}px; }
  }
{%- endstyle -%}

<{{ tag }}
  class="oo-logo oo-logo--{{ lockup }} oo-logo--{{ align }} oo-logo-{{ uid }} {{ class }}"
  data-oo-logo
  {% if link %}href="{{ routes.root_url }}"{% endif %}
  aria-label="{{ label | strip | escape }}"
>
  <span class="oo-logo__wordmark" aria-hidden="true">{{ line_1 }}</span>
  {%- if line_2 != blank -%}
    <span class="oo-logo__wordmark" aria-hidden="true">{{ line_2 }}</span>
  {%- endif -%}
  {%- if show_descriptor -%}
    <span class="oo-logo__descriptor" aria-hidden="true" data-brand-product-line>{{ product_line | escape }}</span>
  {%- endif -%}
</{{ tag }}>
