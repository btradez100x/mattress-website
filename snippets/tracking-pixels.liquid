{%- comment -%}
  Tracking bootstrap.
  GTM loads from layout/theme.liquid and layout/password.liquid when
  settings.gtm_container_id is set (script high in head, noscript after body).
  Do not load gtm.js here — this snippet sits too late and would duplicate.
  Theme pushes events to dataLayer via vTrack; platforms are configured in GTM.
  Every vTrack event includes lp_variant + session_id. First-touch lp_variant
  is stored as numa_lp_variant and written to the cart as an order attribute.
  Meta and GA4 must not load as direct scripts.
  Optional TikTok / Snapchat / Clarity remain as legacy fallbacks only when GTM is blank.
{%- endcomment -%}

{%- liquid
  capture valtora_track_market
    render 'size-market'
  endcapture
  assign valtora_track_market = valtora_track_market | strip
-%}
<script>
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({
    market: {{ valtora_track_market | json }},
    country: {{ localization.country.iso_code | json }},
    payment_mode: {{ settings.payment_mode | default: 'full' | json }},
    template: {{ template.name | json }}
  });
</script>

{%- if settings.gtm_container_id == blank -%}
  {%- if settings.tiktok_pixel_id != blank -%}
    <script>
      !function(w,d,t){w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];
      ttq.methods=['page','track','identify','instances','debug','on','off','once','ready','alias','group','enableCookie','disableCookie'];
      ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};
      for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);
      ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e};
      ttq.load=function(e,n){var i='https://analytics.tiktok.com/i18n/pixel/events.js';ttq._i=ttq._i||{};ttq._i[e]=[];ttq._i[e]._u=i;ttq._t=ttq._t||{};ttq._t[e]=+new Date;ttq._o=ttq._o||{};ttq._o[e]=n||{};
      var o=document.createElement('script');o.type='text/javascript';o.async=!0;o.src=i+'?sdkid='+e+'&lib='+t;var a=document.getElementsByTagName('script')[0];a.parentNode.insertBefore(o,a)};
      ttq.load({{ settings.tiktok_pixel_id | json }});
      ttq.page();
    }(window,document,'ttq');
    </script>
  {%- endif -%}

  {%- if settings.snapchat_pixel_id != blank -%}
    <script>
      (function(e,t,n){if(e.snaptr)return;var a=e.snaptr=function(){a.handleRequest?a.handleRequest.apply(a,arguments):a.queue.push(arguments)};
      a.queue=[];var s='script';r=t.createElement(s);r.async=!0;r.src=n;var u=t.getElementsByTagName(s)[0];u.parentNode.insertBefore(r,u);
      })(window,document,'https://sc-static.net/scevent.min.js');
      snaptr('init', {{ settings.snapchat_pixel_id | json }});
      snaptr('track', 'PAGE_VIEW');
    </script>
  {%- endif -%}

  {%- if settings.clarity_project_id != blank -%}
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", {{ settings.clarity_project_id | json }});
    </script>
  {%- endif -%}
{%- endif -%}
