{%- comment -%}
  Spell a policy number for body copy. Theme settings use figures;
  storefront body copy writes them out.
  Expects: n (number or string)
{%- endcomment -%}
{%- assign n = n | default: 0 | plus: 0 -%}
{%- case n -%}
  {%- when 1 -%}one
  {%- when 2 -%}two
  {%- when 3 -%}three
  {%- when 4 -%}four
  {%- when 5 -%}five
  {%- when 6 -%}six
  {%- when 7 -%}seven
  {%- when 8 -%}eight
  {%- when 9 -%}nine
  {%- when 10 -%}ten
  {%- when 11 -%}eleven
  {%- when 12 -%}twelve
  {%- when 12 -%}twelve
  {%- when 14 -%}fourteen
  {%- when 25 -%}twenty five
  {%- when 30 -%}thirty
  {%- else -%}{{ n }}
{%- endcase -%}
