{% comment %}
  Design tokens from theme settings.
  brand_guidelines: v1 (navy/cream) | v2 (carbon/snow/ember - product-derived)
  colour_scheme depends on guidelines version.
{% endcomment %}
{%- liquid
  assign guidelines = settings.brand_guidelines | default: 'v1'
  assign font_set = settings.font_set | default: 'modern'
  assign scheme = settings.color_scheme | default: 'signature'

  if guidelines == 'v2'
    if scheme != 'v2_carbon' and scheme != 'v2_graphite' and scheme != 'v2_warm' and scheme != 'v2_cool'
      assign scheme = 'v2_carbon'
    endif
  else
    if scheme == 'v2_carbon' or scheme == 'v2_graphite' or scheme == 'v2_warm' or scheme == 'v2_cool'
      assign scheme = 'signature'
    endif
  endif

  if guidelines == 'v2'
    if scheme == 'v2_graphite'
      assign color_primary = '#3A3A3C'
      assign color_accent = '#8A6D3B'
      assign color_bg = '#F5F4F1'
      assign color_surface = '#E4E1DA'
      assign color_ink = '#3A3A3C'
      assign color_on_dark = '#F5F4F1'
      assign wordmark_color = '#3A3A3C'
      assign wordmark_line_2 = '#3A3A3C'
      assign wordmark_line_2_on_dark = color_on_dark
      assign heading_color = '#3A3A3C'
      assign eyebrow_color = '#3A3A3C'
      assign eyebrow_on_dark = color_on_dark
    elsif scheme == 'v2_warm'
      assign color_primary = '#1A1A1A'
      assign color_accent = '#9A7344'
      assign color_bg = '#F7F4EE'
      assign color_surface = '#E8E2D6'
      assign color_ink = '#1A1A1A'
      assign color_on_dark = '#F7F4EE'
      assign wordmark_color = '#1A1A1A'
      assign wordmark_line_2 = '#9A7344'
      assign wordmark_line_2_on_dark = color_on_dark
      assign heading_color = '#1A1A1A'
      assign eyebrow_color = '#7A6A55'
      assign eyebrow_on_dark = color_on_dark
    elsif scheme == 'v2_cool'
      assign color_primary = '#1A1A1A'
      assign color_accent = '#6E8494'
      assign color_bg = '#F3F4F3'
      assign color_surface = '#E4E7E6'
      assign color_ink = '#1A1A1A'
      assign color_on_dark = '#F3F4F3'
      assign wordmark_color = '#1A1A1A'
      assign wordmark_line_2 = '#6E8494'
      assign wordmark_line_2_on_dark = color_on_dark
      assign heading_color = '#1A1A1A'
      assign eyebrow_color = '#6B6B70'
      assign eyebrow_on_dark = color_on_dark
    else
      assign color_primary = '#1A1A1A'
      assign color_accent = '#8A6D3B'
      assign color_bg = '#F5F4F1'
      assign color_surface = '#E4E1DA'
      assign color_ink = '#1A1A1A'
      assign color_on_dark = '#F5F4F1'
      assign wordmark_color = '#1A1A1A'
      assign wordmark_line_2 = '#3A3A3C'
      assign wordmark_line_2_on_dark = color_on_dark
      assign heading_color = '#1A1A1A'
      assign eyebrow_color = '#3A3A3C'
      assign eyebrow_on_dark = color_on_dark
    endif
    assign sans_stack = "'Inter', system-ui, sans-serif"
    assign serif_stack = "'Instrument Sans', system-ui, sans-serif"
    assign mono_stack = "'Geist Mono', ui-monospace, monospace"
    assign wordmark_font = 'serif'
    assign headline_font = 'serif'
    assign wordmark_tracking_em = '-0.02'
    assign transition_token = 'var(--dur-base) var(--ease)'
  else
    if scheme == 'warm_charcoal'
      assign color_primary = '#2F2C28'
      assign color_accent = '#9A7344'
      assign color_bg = '#F5F1EA'
      assign color_surface = '#E7E0D4'
      assign color_ink = '#1A1917'
      assign color_on_dark = '#F5F1EA'
    elsif scheme == 'cool_graphite'
      assign color_primary = '#1E2A32'
      assign color_accent = '#6E8494'
      assign color_bg = '#F3F4F3'
      assign color_surface = '#E4E7E6'
      assign color_ink = '#1C2124'
      assign color_on_dark = '#F3F4F3'
    else
      assign color_primary = settings.color_primary | default: '#1F3A5F'
      assign color_accent = settings.color_accent | default: '#8A6D3B'
      assign color_bg = settings.color_bg | default: '#F7F5F1'
      assign color_surface = settings.color_surface | default: '#EAE6DF'
      assign color_ink = settings.color_ink | default: '#222222'
      assign color_on_dark = settings.color_on_dark | default: '#F7F5F1'
    endif

    if scheme == 'classic_navy'
      assign wordmark_color = color_primary
      assign wordmark_line_2 = color_accent
      assign heading_color = color_primary
      assign eyebrow_color = color_primary
      assign eyebrow_on_dark = color_on_dark
    else
      assign wordmark_color = color_accent
      assign wordmark_line_2 = color_primary
      assign heading_color = color_ink
      assign eyebrow_color = color_accent
      assign eyebrow_on_dark = color_on_dark
    endif
    assign wordmark_line_2_on_dark = color_on_dark

    if font_set == 'classic'
      assign sans_stack = "'Manrope', system-ui, sans-serif"
      assign serif_stack = "'Cormorant Garamond', Georgia, serif"
      assign wordmark_font = 'serif'
      assign headline_font = 'serif'
    else
      case settings.font_sans
        when 'work_sans'
          assign sans_stack = "'Work Sans', system-ui, sans-serif"
        when 'inter'
          assign sans_stack = "'Inter', system-ui, sans-serif"
        when 'manrope'
          assign sans_stack = "'Manrope', system-ui, sans-serif"
        else
          assign sans_stack = "'Outfit', system-ui, sans-serif"
      endcase
      case settings.font_serif
        when 'playfair'
          assign serif_stack = "'Playfair Display', Georgia, serif"
        when 'cormorant'
          assign serif_stack = "'Cormorant Garamond', Georgia, serif"
        else
          assign serif_stack = "'Fraunces', Georgia, serif"
      endcase
      assign wordmark_font = settings.wordmark_font | default: 'sans'
      assign headline_font = settings.headline_font | default: 'sans'
    endif
    assign mono_stack = "ui-monospace, SFMono-Regular, Menlo, monospace"
    assign wordmark_tracking_em = settings.wordmark_tracking | divided_by: 100.0
    assign transition_token = 'var(--dur-base) var(--ease)'
  endif
-%}
{% style %}
  :root {
    --brand-primary: {{ color_primary }};
    --brand-accent: {{ color_accent }};
    --brand-gold: {{ color_accent }};
    --brand-bg: {{ color_bg }};
    --brand-surface: {{ color_surface }};
    --brand-ink: {{ color_ink }};
    --brand-on-dark: {{ color_on_dark }};
    --wordmark-color: {{ wordmark_color }};
    --wordmark-line-2: {{ wordmark_line_2 }};
    --wordmark-line-2-on-dark: {{ wordmark_line_2_on_dark }};
    --heading-color: {{ heading_color }};
    --eyebrow-color: {{ eyebrow_color }};
    --eyebrow-on-dark: {{ eyebrow_on_dark }};

    --font-serif: {{ serif_stack }};
    --font-sans: {{ sans_stack }};
    --font-mono: {{ mono_stack }};
    --font-wordmark: {% if wordmark_font == 'serif' %}var(--font-serif){% else %}var(--font-sans){% endif %};
    --font-headline: {% if headline_font == 'serif' %}var(--font-serif){% else %}var(--font-sans){% endif %};

    --wordmark-tracking: {{ wordmark_tracking_em }}em;
    --ground-light: {% if guidelines == 'v2' %}#F5F4F1{% else %}#F7F5F1{% endif %};
    --ground-soft: {% if guidelines == 'v2' %}#E4E1DA{% else %}#EAE6DF{% endif %};
    --ground-mid: {% if guidelines == 'v2' %}#3A3A3C{% else %}{{ color_primary }}{% endif %};
    --ground-dark: {% if guidelines == 'v2' %}#1A1A1A{% else %}{{ color_primary }}{% endif %};
    --carbon: {{ color_primary }};
    --snow: {{ color_on_dark }};
    --ember: {{ color_accent }};
    --s1: 4px; --s2: 8px; --s3: 12px; --s4: 16px;
    --s5: 24px; --s6: 32px; --s7: 48px; --s8: 64px;
    --s9: 96px; --s10: 128px; --s11: 192px;
    --space-section: 72px;
    --space-gutter: 20px;
    --max-width: 1240px;
    --max-width-narrow: 40rem;
    --radius: 2px;
    --radius-control: 2px;
    --transition: {{ transition_token }};
    --sticky-reserve-offset: 0px;
    --hairline: {% if guidelines == 'v2' %}#D6D2CA{% else %}color-mix(in srgb, {{ color_primary }} 12%, transparent){% endif %};
    --hairline-dark: #2E2E30;
    --font-display: {{ serif_stack }};
    --font-text: {{ sans_stack }};
  }

  @media (min-width: 860px) {
    :root {
      --space-section: 128px;
      --space-gutter: 80px;
    }
  }

  body.has-sticky-reserve {
    --sticky-reserve-offset: 5.75rem;
  }

  {% if guidelines == 'v2' %}
  h1, h2 {
    font-family: var(--font-headline);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  h1 { letter-spacing: -0.045em; line-height: 1.02; }
  h3, h4 {
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .section__eyebrow,
  .wordmark__product {
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .wordmark__text {
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: none;
  }
  .gold-rule {
    width: 40px;
    height: 0;
    margin: 0 0 14px;
    border: 0;
    border-top: 1px solid var(--brand-accent);
    background: none;
  }
  .section--dark .gold-rule {
    border-top-color: var(--brand-accent);
  }
  .gold-rule.gold-rule--measure {
    width: 40px;
    max-width: 40px;
    height: 0;
    margin: 0 0 14px;
    background: none;
    border: 0;
    border-top: 1px solid var(--brand-accent);
  }
  .section--dark .gold-rule.gold-rule--measure {
    border-top-color: var(--brand-accent);
  }
  .btn { border-radius: var(--radius-control, 2px); }
  {% elsif font_set == 'classic' %}
  h1, h2, h3, h4 {
    font-weight: 400;
    letter-spacing: -0.015em;
  }
  h1 { font-weight: 400; letter-spacing: -0.02em; }
  .wordmark__text {
    font-weight: 400;
  }
  {% endif %}
{% endstyle %}
