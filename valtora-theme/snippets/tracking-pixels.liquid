{%- comment -%}
  Tracking bootstrap.
  GTM-MX9SHNSM is installed in layout/theme.liquid and layout/password.liquid.
  Do not load gtm.js here (duplicate). Theme pushes events to dataLayer via vTrack;
  platforms are configured in GTM. Meta and GA4 must not load as direct scripts.
{%- endcomment -%}

<script>
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({
    market: {{ settings.default_market | json }},
    payment_mode: {{ settings.payment_mode | default: 'full' | json }},
    template: {{ template.name | json }}
  });
</script>
