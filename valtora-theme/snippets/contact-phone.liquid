{%- comment -%}
  Outputs the phone number for the active market (ae | gb).
  Legacy settings.contact_phone is used as a fallback.
{%- endcomment -%}
{%- liquid
  assign m = settings.default_market | default: 'ae'
  if localization.country.iso_code == 'GB'
    assign m = 'gb'
  elsif localization.country.iso_code == 'AE'
    assign m = 'ae'
  endif

  if m == 'gb'
    echo settings.contact_phone_gb | default: settings.contact_phone | default: ''
  else
    echo settings.contact_phone_ae | default: settings.contact_phone | default: ''
  endif
-%}
