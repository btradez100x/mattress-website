{%- comment -%}
  Mattress variant market: ae | gb | eu | us | au
  Prefers custom.market. Does not treat "European King" as Europe —
  GB sells that size. US/AU titles are never classified as GB.
  Expects: v (variant)
{%- endcomment -%}
{%- liquid
  assign v_market = v.metafields.custom.market | strip | downcase
  assign v_title_down = v.title | downcase
  assign v_opt_down = v.option1 | downcase
  assign v_sku_down = v.sku | downcase
  assign blob = v_title_down | append: ' ' | append: v_opt_down | append: ' ' | append: v_sku_down

  if v_market == 'uk'
    assign v_market = 'gb'
  elsif v_market == 'uae'
    assign v_market = 'ae'
  endif

  if v_market == blank
    if blob contains 'matt-ae' or blob contains '(uae)' or blob contains ' uae'
      assign v_market = 'ae'
    elsif blob contains 'matt-us' or blob contains 'us full' or blob contains 'us queen' or blob contains 'us king' or blob contains 'us twin' or blob contains 'twin xl' or blob contains 'twin-xl' or blob contains 'california' or blob contains 'split king'
      assign v_market = 'us'
    elsif blob contains 'matt-au' or blob contains 'au super' or blob contains 'australian'
      assign v_market = 'au'
    elsif blob contains 'matt-eu'
      assign v_market = 'eu'
    elsif blob contains 'matt-uk' or blob contains 'matt-gb'
      assign v_market = 'gb'
    else
      assign v_market = 'gb'
    endif
  endif
-%}
{{- v_market -}}
