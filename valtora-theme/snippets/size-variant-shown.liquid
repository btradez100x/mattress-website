{%- comment -%}
  Market Shown tokens for a variant, comma-separated, uppercase.

  Source of truth — Shopify Admin definition name: Market Shown
  Namespace and key: custom.MarketShown (camelCase, NO underscore)
  Liquid: variant.metafields.custom.MarketShown
  Also: custom.marketshown (all lowercase). Snake_case is fallback only.

  Admin list metafields often serialize as "GB • UAE" (U+2022 BULLET) with
  spaces, or as an array, or "GB, US". Tokenize as a SET of codes — never
  treat the whole string as one country. Split on bullet, middle dot,
  commas, pipes, slashes, semicolons, whitespace, and HTML entities.
  UK→GB, UAE→AE (UAE still matches the AE market), USA→US.

  Aliases if MarketShown is missing: custom.marketshown, custom.market_shown,
  custom.market-shown, custom.Market_Shown, then older markets_shown /
  shown_markets keys. List, JSON, market objects, or plain text.

  If this snippet prints blank, populate Market Shown on each variant
  (Settings → Custom data → Variants → Market Shown) with GB/UK, US, AE, EU.
  US Twin with Market Shown = US must not appear on the UK size guide.
  A UK extra (for example California King with Market Shown including UK/GB)
  must appear on both the size guide and Configure / add-to-basket.

  Expects: v (variant)
{%- endcomment -%}
{%- liquid
  assign raw = v.metafields.custom.MarketShown.value
  if raw == blank
    assign raw = v.metafields.custom.MarketShown
  endif
  if raw == blank
    assign raw = v.metafields['custom']['MarketShown'].value
  endif
  if raw == blank
    assign raw = v.metafields['custom']['MarketShown']
  endif
  if raw == blank
    assign raw = v.metafields.custom.marketshown.value
  endif
  if raw == blank
    assign raw = v.metafields.custom.marketshown
  endif
  if raw == blank
    assign raw = v.metafields['custom']['marketshown'].value
  endif
  if raw == blank
    assign raw = v.metafields['custom']['marketshown']
  endif
  if raw == blank
    assign raw = v.metafields.custom.market_shown.value
  endif
  if raw == blank
    assign raw = v.metafields.custom.market_shown
  endif
  if raw == blank
    assign raw = v.metafields.custom['market-shown'].value
  endif
  if raw == blank
    assign raw = v.metafields.custom['market-shown']
  endif
  if raw == blank
    assign raw = v.metafields.custom.Market_Shown.value
  endif
  if raw == blank
    assign raw = v.metafields.custom.Market_Shown
  endif
  if raw == blank
    assign raw = v.metafields.custom.markets_shown.value | default: v.metafields.custom.markets_shown
  endif
  if raw == blank
    assign raw = v.metafields.custom.shown_markets.value | default: v.metafields.custom.shown_markets
  endif

  assign csv = ''
  assign parts = ''
  assign looped = false
  if raw != blank
    for item in raw
      assign looped = true
      assign piece = item.iso_code | default: item.isoCode | default: item.country_iso | default: item.country_code | default: item.handle | default: item.name
      if piece == blank
        assign piece = item | append: ''
      endif
      assign piece = piece | strip
      if piece != blank
        if parts != blank
          assign parts = parts | append: ','
        endif
        assign parts = parts | append: piece
      endif
    endfor
    if looped and parts != blank
      assign csv = parts
    else
      assign csv = raw | join: ','
      if csv == blank or csv == raw
        assign csv = raw | append: ''
      endif
    endif
    assign csv = csv | replace: '[', '' | replace: ']', '' | replace: '"', '' | replace: "'", ''
    assign csv = csv | replace: '&bull;', ',' | replace: '&#8226;', ',' | replace: '&#x2022;', ',' | replace: '&#X2022;', ','
    assign csv = csv | replace: '&middot;', ',' | replace: '&#183;', ',' | replace: '&nbsp;', ',' | replace: '&#160;', ','
    assign csv = csv | replace: '•', ',' | replace: '·', ',' | replace: ';', ',' | replace: '|', ',' | replace: '/', ','
    assign csv = csv | replace: 'United Kingdom', 'GB' | replace: 'UNITED KINGDOM', 'GB' | replace: 'Great Britain', 'GB' | replace: 'GREAT BRITAIN', 'GB'
    assign csv = csv | replace: 'United Arab Emirates', 'AE' | replace: 'UNITED ARAB EMIRATES', 'AE'
    assign csv = csv | replace: 'United States of America', 'US' | replace: 'UNITED STATES OF AMERICA', 'US' | replace: 'United States', 'US' | replace: 'UNITED STATES', 'US'
    assign csv = csv | replace: ', ', ',' | replace: ' ,', ',' | replace: '  ', ' '
    assign csv = csv | replace: ' ', ','
    assign csv = csv | upcase | replace: 'UK', 'GB' | replace: 'UAE', 'AE' | replace: 'USA', 'US' | replace: 'GBR', 'GB' | replace: 'ARE', 'AE'
    assign csv = csv | replace: ',,', ',' | replace: ',,', ','
  endif
-%}
{{- csv | strip -}}
