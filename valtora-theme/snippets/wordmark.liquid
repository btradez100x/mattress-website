{% comment %}
  Rendered wordmark from Theme settings → Brand only (brand_name + brand_product_line).
  Never an uploaded logo image - name stays testable.
  Two-line lockup: line 1 = brand name, line 2 = product line.
{% endcomment %}
{%- liquid
  assign name = settings.brand_name | default: 'Numa' | strip
  assign product_line = settings.brand_product_line | default: '' | strip
  assign link_url = link | default: routes.root_url
  assign dark = dark | default: false
  assign show_line = false
  if product_line != blank and show_product_line != false
    assign show_line = true
  endif
-%}
<a
  class="wordmark{% if dark %} wordmark--dark{% endif %}{% if show_line %} wordmark--with-line{% endif %}{% if class != blank %} {{ class }}{% endif %}"
  href="{{ link_url }}"
  aria-label="{{ name }}{% if show_line %} {{ product_line }}{% endif %}"
>
  {%- if settings.brand_mark != blank -%}
    <img
      class="wordmark__mark"
      src="{{ settings.brand_mark | image_url: width: 64 }}"
      alt=""
      width="24"
      height="24"
      loading="eager"
    >
  {%- endif -%}
  <span class="wordmark__lockup">
    <span class="wordmark__text" data-brand-text>{{ name }}</span>
    {%- if show_line -%}
      <span class="wordmark__product" data-brand-product-line>{{ product_line }}</span>
    {%- endif -%}
  </span>
</a>
