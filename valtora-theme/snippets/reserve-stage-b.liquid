{%- comment -%}
  Stage B: lead time + terms + Pay. Hidden until Continue (progressive disclosure).
  Without JS, both stages remain visible (.js-ready + .is-collapsed hide Stage B).
{%- endcomment -%}
{%- liquid
  assign leadtime_placement = leadtime_placement | default: 'staged'
  assign stage_b_heading = stage_b_heading | default: 'Before you order'
  assign lead_window = lead_window | default: '8 to 10 weeks'
  assign leadtime_vague = leadtime_vague | default: 'Made to order. We confirm your delivery date before dispatch.'
  assign payment_mode = payment_mode | default: 'full'
  assign finance_name = finance_name | default: 'Klarna'
  assign trial = settings.return_window_days | default: settings.trial_nights | default: '30' | strip
  if trial == blank
    assign trial = '30'
  endif
  assign warranty = settings.warranty_years | default: '25' | strip
  if warranty == blank
    assign warranty = '25'
  endif
  if market == blank
    capture market
      render 'size-market'
    endcapture
    assign market = market | strip
  endif
  if market == 'ae'
    assign fly_to = 'the UAE'
  elsif market == 'us'
    assign fly_to = 'the US'
  elsif market == 'eu'
    assign fly_to = 'Europe'
  else
    assign fly_to = 'the UK'
  endif
  assign variation_notice = settings.variation_notice | default: 'Made to order, so natural variation in fabric shade is possible. The construction is identical every time.'
-%}
{%- capture legal_name -%}{% render 'legal-name' %}{%- endcapture -%}
{%- assign legal_name = legal_name | strip -%}
{%- liquid
  if payment_mode == 'full'
    assign terms_title = order_terms_title_full | default: 'Order terms'
    assign terms_body = order_terms_full
  else
    assign terms_title = order_terms_title_split | default: 'Payment and order terms'
    assign terms_body = order_terms_split
  endif
-%}
<div
  class="reserve-stage-b is-collapsed"
  data-reserve-stage-b
  tabindex="-1"
  aria-live="polite"
>
  <p class="reserve-stage-b__eyebrow">{{ stage_b_heading }}</p>
  <p class="reserve-stage-b__summary" data-stageb-summary></p>

  {%- unless leadtime_placement == 'inline' -%}
    <div class="order-lead" data-leadtime-block>
      <p class="order-lead__k">Delivery</p>
      {%- if leadtime_placement == 'vague' -%}
        <p class="order-lead__v" data-lead-window-label>{{ leadtime_vague }}</p>
      {%- else -%}
        <p class="order-lead__v" data-lead-window-label>{{ lead_window }}</p>
        <p class="order-lead__s">Most orders arrive sooner.</p>
      {%- endif -%}
    </div>
    <p class="reserve-stage-b__copy" data-leadtime-copy>
      Made to order and delivered in {{ lead_window }}. Most orders arrive sooner. Your mattress goes into production once this order is placed. If we are going to miss that window we will tell you before the date, and you can cancel for a full refund.
    </p>
  {%- endunless -%}

  <div class="order-large-terms" data-order-large-terms hidden>
    <p class="deposit-terms__title">Terms for larger orders</p>
    <p class="reserve-panel__meta" data-order-large-copy></p>
    <label class="order-large-terms__ack">
      <input type="checkbox" data-order-large-ack>
      <span>I understand these terms for this order</span>
    </label>
  </div>

  <div class="deposit-terms">
    <p class="deposit-terms__title">{{ terms_title }}</p>
    <div class="rte reserve-stage-b__terms-body">
      {%- if legal_name != blank and terms_body != blank -%}
        {%- assign terms_body = terms_body | replace: '[Legal]', legal_name | replace: '[legal_name]', legal_name -%}
      {%- endif -%}
      {%- if terms_body != blank -%}
        {%- capture terms_body -%}{% render 'warranty-tokens', text: terms_body %}{%- endcapture -%}
        {%- capture terms_body -%}{% render 'trial-tokens', text: terms_body %}{%- endcapture -%}
        {{ terms_body | strip }}
      {%- else -%}
        <ul class="reserve-stage-b__terms">
          <li>Cancel any time before dispatch for a full refund.</li>
          <li>Spread the cost with {{ finance_name }} at no extra charge.</li>
          <li>Refunds returned to the original payment method within five to ten business days.</li>
          <li>{{ trial }} day returns policy from delivery.</li>
          <li>{{ warranty }} year guarantee on the pocket spring core.</li>
          <li>{{ variation_notice }}</li>
        </ul>
      {%- endif -%}
    </div>
  </div>

  <button type="button" class="btn reserve-stage-b__pay" data-checkout-pay style="width:100%;">
    <span data-pay-label>{{ checkout_label | default: 'Pay' }}</span>
  </button>

  <button type="button" class="order-basket__back" data-reserve-back>Back to order</button>
</div>
