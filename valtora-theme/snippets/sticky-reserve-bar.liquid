{%- comment -%}
  Mobile basket bar. Hidden until the order has lines, and only below 980px.
  View opens a sheet painted from the same order markup as the side panel.
{%- endcomment -%}
<div class="float-basket" data-float-basket data-sticky-reserve hidden>
  <div class="float-basket__sum">
    <span class="float-basket__count" data-float-count>0 mattresses</span>
    <strong class="float-basket__total" data-float-total data-sticky-price></strong>
  </div>
  <div class="float-basket__acts">
    <button type="button" class="float-basket__view" data-float-view>View</button>
    <a
      class="float-basket__btn"
      data-float-continue
      data-checkout-href="{{ pages['checkout'].url | default: '/pages/checkout' }}"
      href="{{ pages['checkout'].url | default: '/pages/checkout' }}"
    >Checkout</a>
  </div>
</div>
