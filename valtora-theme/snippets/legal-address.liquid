{%- comment -%}
  Registered address for legal copy. Brand → Registered address is the default.
  UAE/UK Business details override when filled.
{%- endcomment -%}
{%- liquid
  capture m
    render 'size-market'
  endcapture
  assign m = m | strip

  assign addr = settings.registered_address
  if m == 'ae' and settings.registered_address_ae != blank
    assign addr = settings.registered_address_ae
  elsif m != 'ae' and settings.registered_address_gb != blank
    assign addr = settings.registered_address_gb
  elsif addr == blank
    assign addr = settings.registered_address_gb | default: settings.registered_address_ae
  endif
  echo addr
-%}
