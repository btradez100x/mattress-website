{%- comment -%}
  WhatsApp CTA - S15.3.1
  {% render 'whatsapp-button' %}
  {% render 'whatsapp-button', variant: 'floating' %}
{%- endcomment -%}
{%- if settings.whatsapp_enabled -%}
  {%- liquid
    assign variant = variant | default: 'inline'
    assign prefill = settings.whatsapp_prefill | default: 'Hi - I have a question about reserving a mattress.'
  -%}
  {%- capture raw_number -%}{% render 'whatsapp-number' %}{%- endcapture -%}
  {%- assign raw_number = raw_number | strip -%}
  {%- assign wa_digits = raw_number | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '+', '' -%}
  {%- if wa_digits != blank -%}
    {%- capture wa_url -%}https://wa.me/{{ wa_digits }}?text={{ prefill | url_encode }}{%- endcapture -%}

    {%- if variant == 'floating' -%}
      <a
        class="whatsapp-float"
        href="{{ wa_url | strip }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat on WhatsApp"
      >
        <span class="whatsapp-float__glyph" aria-hidden="true">
          {% render 'whatsapp-icon', size: 26 %}
        </span>
        <span class="whatsapp-float__label">WhatsApp</span>
      </a>
    {%- else -%}
      <a
        class="btn btn--whatsapp{% if class != blank %} {{ class }}{% endif %}"
        href="{{ wa_url | strip }}"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="btn--whatsapp__icon" aria-hidden="true">
          {% render 'whatsapp-icon', size: 20 %}
        </span>
        Chat on WhatsApp
      </a>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
