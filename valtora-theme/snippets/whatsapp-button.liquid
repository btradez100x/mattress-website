{%- comment -%}
  WhatsApp CTA — S15.3.1
  {% render 'whatsapp-button' %}
  {% render 'whatsapp-button', variant: 'floating' %}
{%- endcomment -%}
{%- if settings.whatsapp_enabled and settings.whatsapp_number != blank -%}
  {%- liquid
    assign variant = variant | default: 'inline'
    assign prefill = settings.whatsapp_prefill | default: 'Hi - I have a question about reserving a mattress.'
  -%}
  {%- capture wa_url -%}https://wa.me/{{ settings.whatsapp_number }}?text={{ prefill | url_encode }}{%- endcapture -%}

  {%- if variant == 'floating' -%}
    <a
      class="whatsapp-float"
      href="{{ wa_url | strip }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat on WhatsApp"
    >
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor">
        <path d="M20.5 3.5A11 11 0 0 0 3.1 17.3L2 22l4.8-1.1A11 11 0 1 0 20.5 3.5zm-8.6 17a9.1 9.1 0 0 1-4.6-1.3l-.3-.2-2.8.6.6-2.7-.2-.3a9.1 9.1 0 1 1 7.3 3.9zm5-6.8c-.3-.1-1.6-.8-1.9-.9s-.4-.1-.6.2-.7.9-.8 1-.3.2-.6.1a7.4 7.4 0 0 1-2.2-1.4 8.2 8.2 0 0 1-1.5-1.9c-.2-.3 0-.4.1-.6l.4-.5c.1-.2.2-.3.3-.5s0-.4 0-.5-.6-1.4-.8-1.9-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3a2.3 2.3 0 0 0-.7 1.7 4 4 0 0 0 .8 2.1 9.1 9.1 0 0 0 3.5 3.4 12 12 0 0 0 1.4.5 3.3 3.3 0 0 0 1.5.1 2.5 2.5 0 0 0 1.6-1.1 2 2 0 0 0 .1-1.1c-.1-.1-.3-.2-.6-.3z"/>
      </svg>
      <span class="whatsapp-float__label">WhatsApp</span>
    </a>
  {%- else -%}
    <a
      class="btn btn--whatsapp{% if class != blank %} {{ class }}{% endif %}"
      href="{{ wa_url | strip }}"
      target="_blank"
      rel="noopener noreferrer"
    >
      Chat on WhatsApp
    </a>
  {%- endif -%}
{%- endif -%}
