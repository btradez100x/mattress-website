{%- comment -%}
  Redesign image. Picker uses image_url srcset. Theme WebP uses asset_url.
  Do not use asset_img_url on theme WebP: Shopify cannot resize those files,
  the srcset 404s, and the browser never falls back to src.
{%- endcomment -%}
{%- liquid
  assign filename = file | default: ''
  assign loading = loading | default: 'lazy'
  assign class_name = class | default: ''
  assign alt_text = alt | default: settings.brand_name
  assign w = width | default: 1400
  assign h = height | default: 781
  assign sizes_attr = sizes | default: '(min-width: 900px) 52vw, 100vw'
  assign fetchpriority = fetchpriority | default: ''
-%}
{%- if image != blank -%}
  {{
    image
    | image_url: width: 1600
    | image_tag:
      loading: loading,
      fetchpriority: fetchpriority,
      widths: '800,1200,1600',
      sizes: sizes_attr,
      class: class_name,
      alt: image.alt | default: alt_text,
      width: w,
      height: h
  }}
{%- elsif filename != blank -%}
  <img
    src="{{ filename | asset_url }}"
    alt="{{ alt_text | escape }}"
    width="{{ w }}"
    height="{{ h }}"
    loading="{{ loading }}"
    decoding="async"
    {% if fetchpriority != blank %}fetchpriority="{{ fetchpriority }}"{% endif %}
    {% if class_name != blank %}class="{{ class_name }}"{% endif %}
  >
{%- endif -%}
