{%- comment -%}
  Redesign image. Shopify image picker wins; else theme asset with width/height.
  srcset 800/1200/1600 when a CDN image is present.
{%- endcomment -%}
{%- liquid
  assign file = file | default: ''
  assign loading = loading | default: 'lazy'
  assign class_name = class | default: ''
  assign alt_text = alt | default: settings.brand_name
  assign w = width | default: 1400
  assign h = height | default: 781
  assign sizes_attr = sizes | default: '(min-width: 900px) 52vw, 100vw'
  assign fetchpriority = fetchpriority | default: ''
-%}
{%- if image != blank -%}
  {{
    image
    | image_url: width: 1600
    | image_tag:
      loading: loading,
      fetchpriority: fetchpriority,
      widths: '800,1200,1600',
      sizes: sizes_attr,
      class: class_name,
      alt: image.alt | default: alt_text,
      width: w,
      height: h
  }}
{%- elsif file != blank -%}
  <img
    src="{{ file | asset_url }}"
    srcset="{{ file | asset_img_url: '800x' }} 800w, {{ file | asset_img_url: '1200x' }} 1200w, {{ file | asset_img_url: '1600x' }} 1600w"
    sizes="{{ sizes_attr }}"
    alt="{{ alt_text | escape }}"
    width="{{ w }}"
    height="{{ h }}"
    loading="{{ loading }}"
    decoding="async"
    {% if fetchpriority != blank %}fetchpriority="{{ fetchpriority }}"{% endif %}
    {% if class_name != blank %}class="{{ class_name }}"{% endif %}
  >
{%- endif -%}
