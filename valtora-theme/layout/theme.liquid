<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    {% render 'css-variables' %}

    {%- comment -%} Google Fonts: one serif + one sans (Brand Guidelines §4) {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- liquid
      case settings.font_serif
        when 'fraunces'
          assign serif_family = 'Fraunces:opsz,wght@9..144,400;500'
        when 'playfair'
          assign serif_family = 'Playfair+Display:wght@400;500'
        else
          assign serif_family = 'Cormorant+Garamond:wght@400;500'
      endcase
      case settings.font_sans
        when 'work_sans'
          assign sans_family = 'Work+Sans:wght@400;500;600'
        when 'inter'
          assign sans_family = 'Inter:wght@400;500;600'
        else
          assign sans_family = 'Manrope:wght@400;500;600'
      endcase
    -%}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family={{ serif_family }}&family={{ sans_family }}&display=swap"
    >

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'utm-persistence.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {% render 'tracking-pixels' %}

    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.ValtoraTheme = window.ValtoraTheme || {};
      window.ValtoraTheme.brandName = {{ settings.brand_name | json }};
      window.ValtoraTheme.defaultMarket = {{ settings.default_market | json }};
      window.ValtoraTheme.moneyFormat = {{ shop.money_format | json }};
      window.ValtoraTheme.routes = {
        cartAdd: {{ routes.cart_add_url | json }},
        cart: {{ routes.cart_url | json }},
        root: {{ routes.root_url | json }}
      };
    </script>
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'whatsapp-button', variant: 'floating' %}
  </body>
</html>
