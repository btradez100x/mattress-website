{% layout none %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ gift_card.balance | money }} gift card - {{ shop.name }}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {%- if settings.gtm_container_id != blank -%}
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',{{ settings.gtm_container_id | json }});</script>
    <!-- End Google Tag Manager -->
    {%- endif -%}
  </head>
  <body style="font-family:'Inter',system-ui,sans-serif;padding:2rem;text-align:center;">
    {%- if settings.gtm_container_id != blank -%}
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ settings.gtm_container_id | escape }}"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    {%- endif -%}
    <h1>{{ shop.name }}</h1>
    <p>Gift card · {{ gift_card.balance | money }}</p>
    <p><strong>{{ gift_card.code | format_code }}</strong></p>
  </body>
</html>
