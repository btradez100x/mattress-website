    "more": {
      "type": "lp",
      "blocks": {
        "b3": {
          "type": "video",
          "settings": {
            "ground": "bone",
            "reverse": false,
            "kicker": "The core",
            "heading": "Seven zones, two wire gauges,\nevery spring in its own pocket",
            "body_1": "Two millimetre wire under the hips and shoulders, where the weight lands. One point eight everywhere else. Each spring in its own fabric pocket.",
            "body_2": "Twenty centimetres of it, guaranteed for twenty five years. It is the part that does not come out, because it is the part that does not wear.",
            "video_file": "spring.mp4",
            "poster_file": "spring-poster.webp",
            "caption": "Seven-zone core",
            "image_file": "",
            "image_alt": ""
          }
        },
        "b4": {
          "type": "split",
          "settings": {
            "ground": "",
            "reverse": false,
            "kicker": "The comfort layer",
            "heading": "Medium one face.\nMedium firm the other.",
            "body_1": "Ten centimetres, two densities laminated together. Turn it over and the feel changes. That is the first adjustment, and it costs nothing.",
            "body_2": "If neither face is right, tell us how it should feel and we build a new one to that. For a year, with our compliments.",
            "pull": "",
            "image_file": "quilt-macro.webp",
            "image_alt": ""
          }
        },
        "b5": {
          "type": "video",
          "settings": {
            "ground": "dark",
            "reverse": false,
            "kicker": "The cover",
            "heading": "Zipped the whole way round",
            "body_1": "Four hundred gram cool-knit, breathable, closed with a zip that runs the full perimeter. The zip is why the comfort layer can come out.",
            "body_2": "Nothing is glued. Nothing is tufted. The build is held together by the cover, which means the build can be opened.",
            "video_file": "compression.mp4",
            "poster_file": "compression-poster.webp",
            "caption": "Cover compression",
            "image_file": "",
            "image_alt": ""
          }
        }
      },
