{%- if section.settings.enable_section -%}
<section class="section section--surface" id="awards" data-reveal>
  <div class="page-width">
    <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="section__lede">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <ul class="awards__grid" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'award' and block.settings.enabled -%}
          <li class="award" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="award__mark">
                {{
                  block.settings.image
                  | image_url: width: 160
                  | image_tag: loading: 'lazy', widths: '80,120,160', alt: block.settings.title
                }}
              </div>
            {%- endif -%}
            <div class="award__copy">
              {%- if block.settings.year != blank -%}
                <p class="award__year">{{ block.settings.year }}</p>
              {%- endif -%}
              <h3 class="award__title">{{ block.settings.title }}</h3>
              {%- if block.settings.org != blank -%}
                <p class="award__org">{{ block.settings.org }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="award__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Awards",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Recognition"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Awards & distinctions."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Independent recognition for design and sleep quality."
    }
  ],
  "blocks": [
    {
      "type": "award",
      "name": "Award",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this award",
          "default": true
        },
        {
          "type": "text",
          "id": "year",
          "label": "Year",
          "default": "2026"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Award title",
          "default": "Best New Sleep Brand"
        },
        {
          "type": "text",
          "id": "org",
          "label": "Organisation",
          "default": "Design Middle East Awards"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Supporting text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Badge / logo (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Awards",
      "blocks": [
        {
          "type": "award",
          "settings": {
            "enabled": true,
            "year": "2026",
            "title": "Innovation in Home",
            "org": "Design Middle East Awards"
          }
        },
        {
          "type": "award",
          "settings": {
            "enabled": true,
            "year": "2026",
            "title": "Editors' Choice - Sleep",
            "org": "Gulf Lifestyle Review"
          }
        },
        {
          "type": "award",
          "settings": {
            "enabled": false,
            "year": "2025",
            "title": "Sustainable Product Shortlist",
            "org": "Green Interiors"
          }
        }
      ]
    }
  ]
}
{% endschema %}
