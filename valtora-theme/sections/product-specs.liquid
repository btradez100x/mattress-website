<section class="section" id="specs" data-reveal>
  <div class="page-width specs__grid">
    <div>
      <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
      <hr class="gold-rule">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="section__lede">{{ section.settings.body }}</p>
      {%- endif -%}

      <ul class="specs__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="big-idea__media">
      {% render 'theme-image',
        image: section.settings.image,
        fallback: 'product-side.jpg',
        alt: section.settings.heading,
        sizes: '(min-width: 900px) 45vw, 100vw'
      %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product specs",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The mattress"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "37cm. Hotel-grade depth."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Substantial enough to feel considered — deeper than standard UK sheets, engineered as a system you refresh rather than replace."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Diagram / product image"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Spec line",
          "default": "37cm full height — substantial, hotel-grade depth"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product specs",
      "blocks": [
        { "type": "spec", "settings": { "text": "37cm full height — substantial, hotel-grade depth" } },
        { "type": "spec", "settings": { "text": "Cover — 400gsm cool-knit, breathable" } },
        { "type": "spec", "settings": { "text": "Comfort top — gel-infused memory foam, ~5cm, zip-replaceable (soft / medium / firm)" } },
        { "type": "spec", "settings": { "text": "Transition — high-density comfort foam" } },
        { "type": "spec", "settings": { "text": "Core — 20cm, 7-zone pocket springs" } },
        { "type": "spec", "settings": { "text": "Base — high-density encased support foam" } },
        { "type": "spec", "settings": { "text": "Underside — anti-slip base" } }
      ]
    }
  ]
}
{% endschema %}
