{%- liquid
  assign announcement = section.settings.text | default: 'Concierge unpacking included with every mattress · To the room of your choice, packaging taken away'
-%}
{%- capture announcement -%}{% render 'trial-tokens', text: announcement %}{%- endcapture -%}
{%- capture announcement -%}{% render 'warranty-tokens', text: announcement %}{%- endcapture -%}
{%- assign announcement = announcement | strip -%}
{%- if section.settings.enable_section -%}
{%- if announcement != blank -%}
  <div class="announcement" role="region" aria-label="Announcement" data-announcement-bar>
    <p style="margin:0">
      Concierge unpacking <b>included with every mattress</b> · To the room of your choice, packaging taken away
    </p>
    <button type="button" class="announcement__dismiss" data-announcement-dismiss aria-label="Dismiss">×</button>
  </div>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text (fallback)",
      "default": "Concierge unpacking included with every mattress · To the room of your choice, packaging taken away",
      "info": "Sitewide banner. Ember highlight is applied to included with every mattress. Dismissed per session only."
    },
    {
      "type": "text",
      "id": "text_ae",
      "label": "Text (UAE)",
      "default": "Concierge unpacking included with every mattress · To the room of your choice, packaging taken away"
    },
    {
      "type": "text",
      "id": "text_gb",
      "label": "Text (UK)",
      "default": "Concierge unpacking included with every mattress · To the room of your choice, packaging taken away"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    }
  ]
}
{% endschema %}
