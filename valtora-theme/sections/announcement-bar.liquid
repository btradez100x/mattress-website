{%- liquid
  assign announcement = section.settings.text | default: 'Complimentary Concierge unpacking. Room of your choice. Packaging taken away.'
-%}
{%- capture announcement -%}{% render 'trial-tokens', text: announcement %}{%- endcapture -%}
{%- capture announcement -%}{% render 'warranty-tokens', text: announcement %}{%- endcapture -%}
{%- assign announcement = announcement | strip -%}
{%- if section.settings.enable_section -%}
{%- if announcement != blank -%}
  <div class="announcement" role="region" aria-label="Announcement" data-announcement-bar>
    <p style="margin:0">{{ announcement }}</p>
    <button type="button" class="announcement__dismiss" data-announcement-dismiss aria-label="Dismiss">×</button>
  </div>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text (fallback)",
      "default": "Complimentary Concierge unpacking. Room of your choice. Packaging taken away.",
      "info": "Sitewide HTML .banner. Gold #C4A46A on included with every mattress. Dismissed per session only."
    },
    {
      "type": "text",
      "id": "text_ae",
      "label": "Text (UAE)",
      "default": "Complimentary Concierge unpacking. Room of your choice. Packaging taken away."
    },
    {
      "type": "text",
      "id": "text_gb",
      "label": "Text (UK)",
      "default": "Complimentary Concierge unpacking. Room of your choice. Packaging taken away."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    }
  ]
}
{% endschema %}
