{%- if section.settings.enable_section -%}
<section class="section{% render 'section-ground' %}" id="{{ section.settings.anchor_id | default: 'cool-touch' }}" data-reveal data-section-ground="{% render 'section-ground', as: 'value' %}">
  <div class="page-width media-feature__split">
    {%- liquid
      assign main_caption = section.settings.image_caption
      if main_caption == blank
        assign main_caption = 'Cool-knit cover detail'
      endif
    -%}
    <figure class="cool-touch__main">
      <div class="media-feature__split-media cool-touch__thumb-frame">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: image_size: '1400x', controls: true }}
        {%- else -%}
          {% render 'theme-image',
            image: section.settings.image,
            fallback: 'cover-macro.jpg',
            alt: main_caption,
            sizes: '(min-width: 900px) 50vw, 100vw'
          %}
        {%- endif -%}
        {%- if main_caption != blank -%}
          <figcaption class="cool-touch__caption">{{ main_caption }}</figcaption>
        {%- endif -%}
      </div>
    </figure>
    <div class="media-feature__split-copy">
      <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
      <hr class="gold-rule">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="section__lede">{{ section.settings.body }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="cool-touch__points" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'point' and block.settings.enabled -%}
              <li {{ block.shopify_attributes }}>
                <strong>{{ block.settings.title }}</strong>
                {%- if block.settings.text != blank -%}
                  <span>{{ block.settings.text }}</span>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.gallery_enabled -%}
        <div class="cool-touch__gallery">
          {%- for block in section.blocks -%}
            {%- if block.type == 'media' and block.settings.enabled -%}
              <figure class="cool-touch__thumb" {{ block.shopify_attributes }}>
                {%- liquid
                  assign media_fallback = block.settings.fallback_asset | default: 'cover-macro.jpg'
                  assign media_caption = block.settings.caption
                  if media_caption == blank
                    assign media_caption = 'Cover texture'
                  endif
                -%}
                <div class="cool-touch__thumb-frame">
                {%- if block.settings.video != blank -%}
                  {{ block.settings.video | video_tag: image_size: '600x', controls: true }}
                {%- else -%}
                  {% render 'theme-image',
                    image: block.settings.image,
                    fallback: media_fallback,
                    alt: media_caption,
                    sizes: '30vw'
                  %}
                {%- endif -%}
                  {%- if media_caption != blank -%}
                    <figcaption class="cool-touch__caption">{{ media_caption }}</figcaption>
                  {%- endif -%}
                </div>
              </figure>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Cool touch",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "select",
      "id": "ground",
      "label": "Section colour",
      "options": [
        {
          "value": "auto",
          "label": "Auto — keep neighbours distinct"
        },
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "surface",
          "label": "Stone"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "auto",
      "info": "Auto alternates off-white and stone when you reorder sections. Dark is for contrast only, used sparingly."
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Stone surface background",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "gallery_enabled",
      "label": "Show supporting media gallery",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "cool-touch"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Cool touch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered to sleep cool."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Heat is why people give up on a mattress they used to love. This one lets it out."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Main image caption",
      "default": "Cool-knit cover detail"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Main video (optional)"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this point",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cool to the touch"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "It does not feel warm when you get in"
        }
      ]
    },
    {
      "type": "media",
      "name": "Gallery media",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this media",
          "default": true
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Cover texture"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (optional)"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Theme fallback asset",
          "default": "cover-macro.jpg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cool touch",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "enabled": true,
            "title": "Cool to the touch",
            "text": "It does not feel warm when you get in"
          }
        },
        {
          "type": "point",
          "settings": {
            "enabled": true,
            "title": "Contours without trapping",
            "text": "It shapes to you. It does not hold the heat"
          }
        },
        {
          "type": "media",
          "settings": {
            "enabled": true,
            "caption": "Cover knit",
            "fallback_asset": "cover-macro.jpg"
          }
        },
        {
          "type": "media",
          "settings": {
            "enabled": true,
            "caption": "Surface detail",
            "fallback_asset": "handle-detail.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
