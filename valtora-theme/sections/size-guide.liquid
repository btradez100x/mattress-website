<section class="policy-page size-guide-page">
  <div class="section section--dark policy-hero">
    <div class="page-width policy-hero__copy">
      <p class="section__eyebrow">Sizing</p>
      <hr class="gold-rule">
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="section__lede policy-hero__lede">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="section section--surface policy-body">
    <div class="page-width">
      <div class="table-wrap policy-table">
        <table class="size-table">
          <thead>
            <tr>
              <th>UAE size</th>
              <th>W × L (cm)</th>
              <th>UK size</th>
              <th>W × L (cm)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Single</td><td>90-100 × 200</td><td>Single</td><td>90 × 190</td></tr>
            <tr><td>Queen</td><td>160 × 200</td><td>Double</td><td>135 × 190</td></tr>
            <tr><td>King</td><td>180 × 200</td><td>King</td><td>150 × 200</td></tr>
            <tr><td></td><td></td><td>Super King</td><td>180 × 200</td></tr>
            <tr><td>Super King</td><td>200 × 200</td><td>Emperor</td><td>200 × 200</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="section policy-body">
    <div class="page-width page-width--narrow">
      <div class="policy-articles">
        <article class="policy-article">
          <h2>{{ section.settings.note_heading }}</h2>
          <div class="policy-article__body rte trust-policy__body">
            <p>{{ section.settings.note_body }}</p>
          </div>
        </article>
        <article class="policy-article">
          <h2>{{ section.settings.depth_heading }}</h2>
          <div class="policy-article__body rte trust-policy__body">
            <p>{{ section.settings.depth_body }}</p>
          </div>
        </article>
      </div>
    </div>
  </div>

  <div class="section section--dark policy-cta">
    <div class="page-width policy-cta__inner">
      <p class="section__eyebrow">Next</p>
      <hr class="gold-rule">
      <p class="policy-cta__action">
        <a class="btn" href="/#reserve">Reserve your size</a>
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Size guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sizes in centimetres"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "UAE and UK use different size names and dimensions. Always order by centimetres."
    },
    {
      "type": "text",
      "id": "note_heading",
      "label": "Expat note heading",
      "default": "For expats"
    },
    {
      "type": "textarea",
      "id": "note_body",
      "label": "Expat note",
      "default": "UAE sizes differ from UK sizes - a UAE King is wider than a UK King. A UK King (150cm) is closer to a UAE Queen (160cm)."
    },
    {
      "type": "text",
      "id": "depth_heading",
      "label": "Depth heading",
      "default": "37cm depth"
    },
    {
      "type": "textarea",
      "id": "depth_body",
      "label": "Depth body",
      "default": "Our mattress is 37cm deep - substantial, hotel-grade, and deeper than typical UK sheets (25-30cm). Plan for deep-fitted sheets."
    }
  ],
  "presets": [{ "name": "Size guide" }]
}
{% endschema %}
