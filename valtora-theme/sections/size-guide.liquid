{%- comment -%}
  Size guide: variants whose Market Shown (custom.MarketShown) includes
  the visitor country. Unknown country (Ghana / GH) → UK/GB set. Not every
  product variant. A UK extra set in Market Shown appears here and on Configure.
  US-only (US Twin with Market Shown = US) does not. Blank is not all 18.
{%- endcomment -%}
{%- liquid
  capture size_market
    render 'size-market'
  endcapture
  assign size_market = size_market | strip
  if size_market == blank
    assign size_market = 'gb'
  endif

  assign mattress = section.settings.mattress_product
  if mattress == blank
    assign mattress = all_products['the-mattress']
  endif
  if mattress == blank
    assign mattress = all_products['mattress']
  endif
  if mattress == blank
    assign mattress = product
  endif

  assign market_label = 'United Kingdom'
  if size_market == 'ae'
    assign market_label = 'United Arab Emirates'
  elsif size_market == 'us'
    assign market_label = 'United States'
  elsif size_market == 'eu'
    assign market_label = 'Europe'
  elsif size_market == 'au'
    assign market_label = 'Australia / New Zealand'
  endif

  assign reserve_base = routes.root_url | default: '/'
  assign tile_count = 0
  assign gb_tile_count = 0
  capture catalog_iso
    render 'size-catalog-iso', mattress: mattress
  endcapture
  assign catalog_iso = catalog_iso | strip | upcase
  if catalog_iso == blank
    assign catalog_iso = 'GB'
  endif
  assign browser_iso = localization.country.iso_code | upcase | strip
  if browser_iso == 'UK'
    assign browser_iso = 'GB'
  endif
-%}
<section class="policy-page size-guide-page" data-size-guide data-market="{{ size_market }}" data-catalog-iso="{{ catalog_iso }}" data-reserve-href="{{ reserve_base }}">
  <script type="application/json" data-size-price-config>
    {%- render 'size-catalog-json', mattress: mattress -%}
  </script>

  <div class="section section--dark policy-hero">
    <div class="page-width policy-hero__copy">
      <div class="gold-kicker">
        <p class="section__eyebrow">Sizing</p>
        <hr class="gold-rule">
      </div>
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="section__lede policy-hero__lede">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="section section--surface size-guide-catalog">
    <div class="page-width size-guide-catalog__inner">
      <header class="size-guide-catalog__head">
        <div class="gold-kicker">
          <p class="section__eyebrow" data-size-guide-market-label>{{ market_label }}</p>
          <hr class="gold-rule">
        </div>
        <h2 data-size-guide-heading>Every size we make for this market</h2>
        <p class="size-guide-catalog__lede">Names follow local convention. Figures are always width × length in centimetres. European King is 160 × 200 cm where that size is made.</p>
      </header>

      <p class="size-guide-fallback" data-size-guide-uk-note{% unless browser_iso != blank and catalog_iso == 'GB' and browser_iso != 'GB' %} hidden{% endunless %}>
        This country is not set up yet. Showing United Kingdom sizes.
      </p>
      <p class="size-guide-empty" data-size-guide-empty hidden>
        Sizes load from the mattress product. Connect The Mattress in this section, or create a product whose handle is the-mattress.
      </p>

      <div class="size-guide-grid" data-size-guide-grid>
        {%- if mattress != blank -%}
          {%- for v in mattress.variants -%}
            {%- capture in_country -%}{%- render 'size-variant-in-country', v: v, country_iso: catalog_iso -%}{%- endcapture -%}
            {%- capture in_gb -%}{%- render 'size-variant-in-country', v: v, country_iso: 'GB' -%}{%- endcapture -%}
            {%- assign in_country = in_country | strip -%}
            {%- assign in_gb = in_gb | strip -%}
            {%- if in_gb == '1' -%}
              {%- assign gb_tile_count = gb_tile_count | plus: 1 -%}
            {%- endif -%}
            {%- unless in_country == '1' -%}
              {%- continue -%}
            {%- endunless -%}
            {%- assign tile_count = tile_count | plus: 1 -%}
            {%- assign size_id = v.option1 | handle -%}
            {%- if size_id == blank -%}
              {%- assign size_id = v.title | handle -%}
            {%- endif -%}
            {%- if size_id == blank -%}
              {%- assign size_id = v.sku | handleize | replace: 'matt-uk-', '' | replace: 'matt-ae-', '' | replace: 'matt-eu-', '' | replace: 'matt-us-', '' -%}
            {%- endif -%}
            {%- assign tile_label = v.option1 | default: v.title -%}
            {%- if size_market == 'us' and v.metafields.custom.name_us != blank -%}
              {%- assign tile_label = v.metafields.custom.name_us.value | default: v.metafields.custom.name_us -%}
            {%- elsif size_market == 'ae' and v.metafields.custom.name_ae != blank -%}
              {%- assign tile_label = v.metafields.custom.name_ae.value | default: v.metafields.custom.name_ae -%}
            {%- elsif v.metafields.custom.name_gb != blank -%}
              {%- assign tile_label = v.metafields.custom.name_gb.value | default: v.metafields.custom.name_gb -%}
            {%- endif -%}
            {%- assign width_cm = v.metafields.custom.width_cm.value | default: v.metafields.custom.width_cm -%}
            {%- assign length_cm = v.metafields.custom.length_cm.value | default: v.metafields.custom.length_cm -%}
            {%- assign pieces = v.metafields.custom.pieces.value | default: v.metafields.custom.pieces | default: 1 -%}
            {%- assign fits = v.metafields.custom.fits_note.value | default: v.metafields.custom.fits_note -%}
            {%- assign dims = v.metafields.custom.dims -%}
            {%- if width_cm != blank and length_cm != blank -%}
              {%- if pieces > 1 -%}
                {%- assign dims = pieces | append: ' × ' | append: width_cm | append: ' × ' | append: length_cm | append: ' cm' -%}
              {%- else -%}
                {%- assign dims = width_cm | append: ' × ' | append: length_cm | append: ' cm' -%}
              {%- endif -%}
            {%- endif -%}
            {%- assign tile_price = '' -%}
            {%- if v.price > 0 -%}
              {%- assign tile_price = v.price | money -%}
            {%- endif -%}
            {%- assign reserve_href = reserve_base | append: '?size=' | append: size_id | append: '#reserve' -%}
            {%- render 'size-guide-tile',
              label: tile_label,
              dims: dims,
              width_cm: width_cm,
              length_cm: length_cm,
              pieces: pieces,
              price: tile_price,
              fits: fits,
              size_id: size_id,
              market_only: size_market,
              hidden: false,
              reserve_href: reserve_href
            -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if tile_count == 0 and gb_tile_count > 0 and size_market != 'gb' and mattress != blank -%}
        <p class="size-guide-fallback" data-size-guide-uk-static>
          This country is not set up yet. Showing United Kingdom sizes.
        </p>
        <div class="size-guide-grid" data-size-guide-uk-grid>
          {%- for v in mattress.variants -%}
            {%- capture in_gb -%}{%- render 'size-variant-in-country', v: v, country_iso: 'GB' -%}{%- endcapture -%}
            {%- assign in_gb = in_gb | strip -%}
            {%- unless in_gb == '1' -%}
              {%- continue -%}
            {%- endunless -%}
            {%- assign size_id = v.option1 | handle -%}
            {%- if size_id == blank -%}
              {%- assign size_id = v.title | handle -%}
            {%- endif -%}
            {%- if size_id == blank -%}
              {%- assign size_id = v.sku | handleize | replace: 'matt-uk-', '' | replace: 'matt-ae-', '' | replace: 'matt-eu-', '' | replace: 'matt-us-', '' -%}
            {%- endif -%}
            {%- assign tile_label = v.metafields.custom.name_gb.value | default: v.metafields.custom.name_gb | default: v.option1 | default: v.title -%}
            {%- assign width_cm = v.metafields.custom.width_cm.value | default: v.metafields.custom.width_cm -%}
            {%- assign length_cm = v.metafields.custom.length_cm.value | default: v.metafields.custom.length_cm -%}
            {%- assign pieces = v.metafields.custom.pieces.value | default: v.metafields.custom.pieces | default: 1 -%}
            {%- assign fits = v.metafields.custom.fits_note.value | default: v.metafields.custom.fits_note -%}
            {%- assign dims = v.metafields.custom.dims -%}
            {%- if width_cm != blank and length_cm != blank -%}
              {%- if pieces > 1 -%}
                {%- assign dims = pieces | append: ' × ' | append: width_cm | append: ' × ' | append: length_cm | append: ' cm' -%}
              {%- else -%}
                {%- assign dims = width_cm | append: ' × ' | append: length_cm | append: ' cm' -%}
              {%- endif -%}
            {%- endif -%}
            {%- assign tile_price = '' -%}
            {%- if v.price > 0 -%}
              {%- assign tile_price = v.price | money -%}
            {%- endif -%}
            {%- assign reserve_href = reserve_base | append: '?size=' | append: size_id | append: '#reserve' -%}
            {%- render 'size-guide-tile',
              label: tile_label,
              dims: dims,
              width_cm: width_cm,
              length_cm: length_cm,
              pieces: pieces,
              price: tile_price,
              fits: fits,
              size_id: size_id,
              market_only: 'gb',
              hidden: false,
              reserve_href: reserve_href
            -%}
          {%- endfor -%}
        </div>
      {%- elsif tile_count == 0 and gb_tile_count == 0 and mattress != blank -%}
        <div class="size-guide-grid" data-size-guide-uk-grid>
          {%- assign classic_gb = '|single|small-double|double|king|european-king|super-king|emperor|' -%}
          {%- assign classic_painted = 0 -%}
          {%- for v in mattress.variants -%}
            {%- assign size_id = v.option1 | handle -%}
            {%- if size_id == blank -%}
              {%- assign size_id = v.title | handle -%}
            {%- endif -%}
            {%- if size_id == blank -%}
              {%- assign size_id = v.sku | handleize | replace: 'matt-uk-', '' | replace: 'matt-ae-', '' | replace: 'matt-eu-', '' | replace: 'matt-us-', '' -%}
            {%- endif -%}
            {%- assign sid_token = '|' | append: size_id | append: '|' -%}
            {%- unless classic_gb contains sid_token -%}
              {%- continue -%}
            {%- endunless -%}
            {%- assign classic_painted = classic_painted | plus: 1 -%}
            {%- assign tile_label = v.metafields.custom.name_gb.value | default: v.metafields.custom.name_gb | default: v.option1 | default: v.title -%}
            {%- assign width_cm = v.metafields.custom.width_cm.value | default: v.metafields.custom.width_cm -%}
            {%- assign length_cm = v.metafields.custom.length_cm.value | default: v.metafields.custom.length_cm -%}
            {%- assign pieces = v.metafields.custom.pieces.value | default: v.metafields.custom.pieces | default: 1 -%}
            {%- assign fits = v.metafields.custom.fits_note.value | default: v.metafields.custom.fits_note -%}
            {%- assign dims = v.metafields.custom.dims -%}
            {%- if width_cm != blank and length_cm != blank -%}
              {%- if pieces > 1 -%}
                {%- assign dims = pieces | append: ' × ' | append: width_cm | append: ' × ' | append: length_cm | append: ' cm' -%}
              {%- else -%}
                {%- assign dims = width_cm | append: ' × ' | append: length_cm | append: ' cm' -%}
              {%- endif -%}
            {%- endif -%}
            {%- assign tile_price = '' -%}
            {%- if v.price > 0 -%}
              {%- assign tile_price = v.price | money -%}
            {%- endif -%}
            {%- assign reserve_href = reserve_base | append: '?size=' | append: size_id | append: '#reserve' -%}
            {%- render 'size-guide-tile',
              label: tile_label,
              dims: dims,
              width_cm: width_cm,
              length_cm: length_cm,
              pieces: pieces,
              price: tile_price,
              fits: fits,
              size_id: size_id,
              market_only: 'gb',
              hidden: false,
              reserve_href: reserve_href
            -%}
          {%- endfor -%}
        </div>
        {%- if classic_painted == 0 -%}
          <p class="size-guide-empty" data-size-guide-empty-static>
            Sizes load from the mattress product. Connect The Mattress in this section, or create a product whose handle is the-mattress.
          </p>
        {%- endif -%}
      {%- elsif mattress == blank -%}
        <p class="size-guide-empty" data-size-guide-empty-static>
          Sizes load from the mattress product. Connect The Mattress in this section, or create a product whose handle is the-mattress.
        </p>
      {%- endif -%}

      <aside class="size-guide-note" data-size-guide-depth>
        <div class="size-guide-note__title">
          <p class="section__eyebrow">Depth</p>
          <h2>{{ section.settings.depth_heading }}</h2>
        </div>
        <div class="size-guide-note__body rte trust-policy__body">
          <p>{{ section.settings.depth_body }}</p>
          {%- if settings.sheets_enabled -%}
            <p class="pdp-discover">
              <a href="{{ all_products['bed-sheets'].url | default: '/products/bed-sheets' }}">Sheets that fit.</a>
            </p>
          {%- endif -%}
        </div>
      </aside>

      {%- if section.settings.custom_heading != blank or section.settings.custom_body != blank -%}
        <p class="size-guide-custom">
          {%- if section.settings.custom_heading != blank -%}
            <strong>{{ section.settings.custom_heading }}</strong>
            {{ section.settings.custom_body }}
          {%- else -%}
            {{ section.settings.custom_body }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </div>

  <div class="section section--dark policy-cta" data-section-ground="dark">
    <div class="page-width policy-cta__inner">
      <div class="gold-kicker gold-kicker--center">
        <p class="section__eyebrow">Next</p>
        <hr class="gold-rule">
      </div>
      <p class="policy-cta__action">
        <a class="btn" href="{{ reserve_base }}#reserve">Reserve your size</a>
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Size guide",
  "settings": [
    {
      "type": "product",
      "id": "mattress_product",
      "label": "Mattress product",
      "info": "Variants whose Market Shown includes the visitor country. Unknown countries (Ghana) use the UK/GB set. If blank, the theme looks up handle the-mattress, then mattress."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sizes in centimetres"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Always order by centimetres."
    },
    {
      "type": "text",
      "id": "note_heading",
      "label": "Note heading (unused on storefront)",
      "default": "For expats"
    },
    {
      "type": "textarea",
      "id": "note_body",
      "label": "Note body (unused on storefront)",
      "default": "UAE sizes differ from UK sizes - a UAE King is wider than a UK King. A UK King (150cm) is closer to a UAE Queen (160cm)."
    },
    {
      "type": "text",
      "id": "depth_heading",
      "label": "Depth heading",
      "default": "35cm depth"
    },
    {
      "type": "textarea",
      "id": "depth_body",
      "label": "Depth body",
      "default": "Our mattress is 35cm deep - substantial, and deeper than typical UK sheets (25-30cm). Plan for deep-fitted sheets."
    },
    {
      "type": "text",
      "id": "custom_heading",
      "label": "Custom sizes heading",
      "default": "Custom sizes."
    },
    {
      "type": "textarea",
      "id": "custom_body",
      "label": "Custom sizes body",
      "default": "Need a size we do not list? Use Request a size on the reserve panel."
    }
  ],
  "presets": [{ "name": "Size guide" }]
}
{% endschema %}
