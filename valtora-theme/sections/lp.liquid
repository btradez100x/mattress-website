{{ 'lp.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign brand = settings.brand_name | default: 'Numa'
  assign trial = settings.trial_nights | default: 100
  assign warranty = settings.warranty_years | default: '25'
  capture market
    render 'size-market'
  endcapture
  assign market = market | strip
  if market == 'ae'
    assign layer_price = settings.comfort_layer_price_ae | default: 'AED 1,200'
  else
    assign layer_price = settings.comfort_layer_price_gb | default: '£299'
  endif

  assign mattress = all_products['the-mattress']
  if mattress == blank
    assign mattress = all_products['mattress']
  endif
  capture catalog_iso
    render 'size-catalog-iso', mattress: mattress
  endcapture
  assign catalog_iso = catalog_iso | strip | upcase
  if catalog_iso == blank
    assign catalog_iso = 'GB'
  endif
  assign lp_allowed_sizes = section.settings.allowed_size_ids | default: '' | strip
  capture lp_min_money
    render 'mattress-min-price', mattress: mattress, catalog_iso: catalog_iso, allowed_size_ids: lp_allowed_sizes
  endcapture
  assign lp_min_money = lp_min_money | strip
  if lp_min_money != blank
    assign lp_from_label = 'From ' | append: lp_min_money
  else
    assign lp_from_label = ''
  endif
-%}
<div class="lp" data-lp-page data-lp-variant="{{ section.settings.variant | escape }}"{% if lp_allowed_sizes != blank %} data-allowed-sizes="{{ lp_allowed_sizes | escape }}"{% endif %}>
  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- when 'hero' -%}
        <section class="hero" {{ block.shopify_attributes }}>
          <div class="wrap">
            <div class="hero-grid">
              <div>
                {%- if block.settings.kicker != blank -%}
                  <p class="kicker">{{ block.settings.kicker | replace: '[Brand]', brand }}</p>
                {%- endif -%}
                <h1>{{ block.settings.heading | newline_to_br }}</h1>
                {%- if block.settings.lede != blank -%}
                  <p class="lede">{{ block.settings.lede | replace: '[Brand]', brand }}</p>
                {%- endif -%}
                {% render 'lp-sizestrip', show: block.settings.show_sizestrip, rows: block.settings.sizestrip_rows %}
                {%- if block.settings.show_price and block.settings.price_first -%}
                  {% render 'lp-price-block',
                    show: true,
                    large: block.settings.price_large,
                    anchor: true,
                    from_label: lp_from_label,
                    from_fallback: block.settings.price_from,
                    hide_when_empty: true,
                    klarna: block.settings.price_klarna,
                    klarna_amount: block.settings.klarna_amount,
                    show_pay: block.settings.show_pay,
                    pay_label: block.settings.pay_label
                  %}
                {%- endif -%}
                <div class="cta-row">
                  <a class="btn" href="#configure" data-hero-cta data-lp-cta="primary">{{ block.settings.cta_primary | default: 'Choose your size' }}</a>
                  {%- if block.settings.cta_secondary != blank -%}
                    <a class="btn btn-line" href="{{ block.settings.cta_secondary_href | default: '#configure' }}" data-lp-cta="secondary">{{ block.settings.cta_secondary }}</a>
                  {%- endif -%}
                </div>
                {%- if block.settings.trust_1 != blank -%}
                  <div class="trust">
                    <span>{{ block.settings.trust_1 }}</span>
                    {%- if block.settings.trust_2 != blank -%}<span>{{ block.settings.trust_2 }}</span>{%- endif -%}
                    {%- if block.settings.trust_3 != blank -%}<span>{{ block.settings.trust_3 }}</span>{%- endif -%}
                  </div>
                {%- endif -%}
                {%- if block.settings.show_price and block.settings.price_first == false -%}
                  {% render 'lp-price-block',
                    show: true,
                    large: block.settings.price_large,
                    anchor: true,
                    from_label: lp_from_label,
                    from_fallback: block.settings.price_from,
                    hide_when_empty: true,
                    klarna: block.settings.price_klarna,
                    klarna_amount: block.settings.klarna_amount,
                    show_pay: block.settings.show_pay,
                    pay_label: block.settings.pay_label
                  %}
                {%- endif -%}
              </div>
              {%- if block.settings.image_file != blank -%}
                {%- assign lp_img_alt = block.settings.image_alt | default: brand -%}
                {% render 'rd-img', file: block.settings.image_file, alt: lp_img_alt, width: 1600, height: 900, loading: 'eager', fetchpriority: 'high' %}
              {%- endif -%}
            </div>
            <div class="line"></div>
            {%- if block.settings.show_press -%}
              <div class="press">
                <span class="k">{{ block.settings.press_label | default: 'As featured in' }}</span>
                <div class="logos">
                  {%- if block.settings.press_1 != blank -%}<span>{{ block.settings.press_1 }}</span>{%- endif -%}
                  {%- if block.settings.press_2 != blank -%}<span>{{ block.settings.press_2 }}</span>{%- endif -%}
                  {%- if block.settings.press_3 != blank -%}<span>{{ block.settings.press_3 }}</span>{%- endif -%}
                  {%- if block.settings.press_4 != blank -%}<span>{{ block.settings.press_4 }}</span>{%- endif -%}
                  {%- if block.settings.press_5 != blank -%}<span>{{ block.settings.press_5 }}</span>{%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        </section>

      {%- when 'prose' -%}
        <section class="{% if block.settings.ground == 'dark' %}dark{% elsif block.settings.ground == 'bone' %}bone{% elsif block.settings.tight %}tight{% endif %}"{% if block.settings.anchor_id != blank %} id="{{ block.settings.anchor_id | escape }}"{% endif %} {{ block.shopify_attributes }}>
          <div class="wrap">
            <div class="narrow">
              <div class="sec-head">
                {%- if block.settings.kicker != blank -%}<p class="kicker">{{ block.settings.kicker }}</p>{%- endif -%}
                {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading | newline_to_br }}</h2>{%- endif -%}
              </div>
              {%- if block.settings.body_1 != blank -%}<p>{{ block.settings.body_1 | replace: '[Brand]', brand | replace: '[layer_price]', layer_price }}</p>{%- endif -%}
              {%- if block.settings.body_2 != blank -%}<p>{{ block.settings.body_2 | replace: '[Brand]', brand | replace: '[layer_price]', layer_price }}</p>{%- endif -%}
              {%- if block.settings.pull != blank -%}<div class="pull"><p>{{ block.settings.pull }}</p></div>{%- endif -%}
            </div>
          </div>
        </section>

      {%- when 'split' -%}
        <section class="{% if block.settings.ground == 'dark' %}dark{% elsif block.settings.ground == 'bone' %}bone{% endif %}" {{ block.shopify_attributes }}>
          <div class="wrap">
            <div class="split{% if block.settings.reverse %} rev{% endif %}">
              {%- if block.settings.image_file != blank and block.settings.reverse == false -%}
                <div>
                  {%- if block.settings.kicker != blank -%}<p class="kicker">{{ block.settings.kicker }}</p>{%- endif -%}
                  {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading | newline_to_br }}</h2>{%- endif -%}
                  {%- if block.settings.body_1 != blank -%}<p style="margin-top:var(--s3)">{{ block.settings.body_1 | replace: '[layer_price]', layer_price }}</p>{%- endif -%}
                  {%- if block.settings.body_2 != blank -%}<p>{{ block.settings.body_2 | replace: '[layer_price]', layer_price }}</p>{%- endif -%}
                  {%- if block.settings.pull != blank -%}<div class="pull"><p>{{ block.settings.pull }}</p></div>{%- endif -%}
                </div>
                {%- assign lp_img_alt = block.settings.image_alt | default: brand -%}
                {% render 'rd-img', file: block.settings.image_file, alt: lp_img_alt, width: 1400, height: 787, loading: 'lazy' %}
              {%- else -%}
                {%- if block.settings.image_file != blank -%}
                  {%- assign lp_img_alt = block.settings.image_alt | default: brand -%}
                {% render 'rd-img', file: block.settings.image_file, alt: lp_img_alt, width: 1400, height: 787, loading: 'lazy' %}
                {%- endif -%}
                <div>
                  {%- if block.settings.kicker != blank -%}<p class="kicker">{{ block.settings.kicker }}</p>{%- endif -%}
                  {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading | newline_to_br }}</h2>{%- endif -%}
                  {%- if block.settings.body_1 != blank -%}<p style="margin-top:var(--s3)">{{ block.settings.body_1 | replace: '[layer_price]', layer_price }}</p>{%- endif -%}
                  {%- if block.settings.body_2 != blank -%}<p>{{ block.settings.body_2 | replace: '[layer_price]', layer_price }}</p>{%- endif -%}
                  {%- if block.settings.pull != blank -%}<div class="pull"><p>{{ block.settings.pull }}</p></div>{%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </section>

      {%- when 'cards' -%}
        {%- if block.settings.layout == 'arrive' -%}
          <section class="arrive"{% if block.settings.anchor_id != blank %} id="{{ block.settings.anchor_id | escape }}"{% endif %} {{ block.shopify_attributes }}>
            <div class="wrap">
              <div class="sec-head narrow">
                {%- if block.settings.kicker != blank -%}<p class="kicker">{{ block.settings.kicker }}</p>{%- endif -%}
                {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading | newline_to_br }}</h2>{%- endif -%}
                {%- if block.settings.lede != blank -%}
                  <p class="lede" style="color:#C9C5BD;margin-top:var(--s2)">{{ block.settings.lede }}</p>
                {%- endif -%}
              </div>
              <div class="steps3">
                {%- if block.settings.card_1_heading != blank -%}
                  <div>
                    {%- if block.settings.card_1_label != blank -%}<span class="n">{{ block.settings.card_1_label }}</span>{%- endif -%}
                    <h3>{{ block.settings.card_1_heading }}</h3>
                    <p>{{ block.settings.card_1_body }}</p>
                  </div>
                {%- endif -%}
                {%- if block.settings.card_2_heading != blank -%}
                  <div>
                    {%- if block.settings.card_2_label != blank -%}<span class="n">{{ block.settings.card_2_label }}</span>{%- endif -%}
                    <h3>{{ block.settings.card_2_heading }}</h3>
                    <p>{{ block.settings.card_2_body }}</p>
                  </div>
                {%- endif -%}
                {%- if block.settings.card_3_heading != blank -%}
                  <div>
                    {%- if block.settings.card_3_label != blank -%}<span class="n">{{ block.settings.card_3_label }}</span>{%- endif -%}
                    <h3>{{ block.settings.card_3_heading }}</h3>
                    <p>{{ block.settings.card_3_body }}</p>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </section>
        {%- else -%}
          <section class="{% if block.settings.ground == 'bone' %}bone{% elsif block.settings.ground == 'dark' %}dark{% endif %}"{% if block.settings.anchor_id != blank %} id="{{ block.settings.anchor_id | escape }}"{% endif %} {{ block.shopify_attributes }}>
            <div class="wrap">
              {%- if block.settings.kicker != blank or block.settings.heading != blank -%}
                <div class="sec-head narrow">
                  {%- if block.settings.kicker != blank -%}<p class="kicker">{{ block.settings.kicker }}</p>{%- endif -%}
                  {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading | newline_to_br }}</h2>{%- endif -%}
                </div>
              {%- endif -%}
              <div class="grid3">
                {%- if block.settings.card_1_heading != blank -%}
                  <div><h3>{{ block.settings.card_1_heading }}</h3><p>{{ block.settings.card_1_body }}</p></div>
                {%- endif -%}
                {%- if block.settings.card_2_heading != blank -%}
                  <div><h3>{{ block.settings.card_2_heading }}</h3><p>{{ block.settings.card_2_body }}</p></div>
                {%- endif -%}
                {%- if block.settings.card_3_heading != blank -%}
                  <div><h3>{{ block.settings.card_3_heading }}</h3><p>{{ block.settings.card_3_body }}</p></div>
                {%- endif -%}
              </div>
            </div>
          </section>
        {%- endif -%}

      {%- when 'price' -%}
        <section class="bone" {{ block.shopify_attributes }}>
          <div class="wrap">
            <div class="narrow">
              <div class="sec-head">
                {%- if block.settings.kicker != blank -%}<p class="kicker">{{ block.settings.kicker }}</p>{%- endif -%}
                {%- if block.settings.heading != blank -%}
                  {%- if lp_from_label != blank -%}
                    <h2 data-lp-from-heading>From {{ lp_min_money }}.</h2>
                  {%- else -%}
                    <h2 data-lp-from-heading>{{ block.settings.heading | newline_to_br }}</h2>
                  {%- endif -%}
                {%- endif -%}
              </div>
              {%- if block.settings.body != blank -%}<p>{{ block.settings.body }}</p>{%- endif -%}
              {% render 'lp-price-block',
                show: true,
                large: false,
                anchor: true,
                from_label: lp_from_label,
                from_fallback: block.settings.price_from,
                hide_when_empty: true,
                klarna: block.settings.price_klarna,
                klarna_amount: block.settings.klarna_amount,
                show_pay: block.settings.show_pay,
                pay_label: block.settings.pay_label
              %}
              {% render 'lp-sizestrip', show: block.settings.show_sizestrip, rows: block.settings.sizestrip_rows %}
            </div>
          </div>
        </section>

      {%- when 'media' -%}
        <section class="flush" {{ block.shopify_attributes }}>
          {%- if block.settings.image_file != blank -%}
            {%- assign lp_img_alt = block.settings.image_alt | default: brand -%}
                {% render 'rd-img', file: block.settings.image_file, alt: lp_img_alt, width: 1400, height: 787, loading: 'lazy', class: 'lp-flush-img' %}
          {%- endif -%}
        </section>

      {%- when 'layers' -%}
        <section class="tight" id="{{ block.settings.anchor_id | default: 'layers' | escape }}" {{ block.shopify_attributes }}>
          <div class="wrap">
            <div class="narrow">
              <div class="sec-head">
                {%- if block.settings.kicker != blank -%}<p class="kicker">{{ block.settings.kicker }}</p>{%- endif -%}
                {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading | newline_to_br }}</h2>{%- endif -%}
              </div>
              <div class="layers">
                {%- for i in (1..8) -%}
                  {%- capture nkey -%}layer_{{ i }}_n{%- endcapture -%}
                  {%- capture namekey -%}layer_{{ i }}_name{%- endcapture -%}
                  {%- capture desckey -%}layer_{{ i }}_desc{%- endcapture -%}
                  {%- capture metakey -%}layer_{{ i }}_meta{%- endcapture -%}
                  {%- capture corekey -%}layer_{{ i }}_core{%- endcapture -%}
                  {%- assign lname = block.settings[namekey] -%}
                  {%- if lname != blank -%}
                    <div class="layer{% if block.settings[corekey] %} core{% endif %}">
                      <span class="n">{{ block.settings[nkey] | default: i }}</span>
                      <div><b>{{ lname }}</b><span>{{ block.settings[desckey] }}</span></div>
                      <em>{{ block.settings[metakey] }}</em>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        </section>

      {%- when 'video' -%}
        <section class="{% if block.settings.ground == 'dark' %}dark{% elsif block.settings.ground == 'bone' %}bone{% endif %}" {{ block.shopify_attributes }}>
          <div class="wrap">
            <div class="split{% if block.settings.reverse %} rev{% endif %}">
              <div>
                {%- if block.settings.kicker != blank -%}<p class="kicker">{{ block.settings.kicker }}</p>{%- endif -%}
                {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading | newline_to_br }}</h2>{%- endif -%}
                {%- if block.settings.body_1 != blank -%}<p style="margin-top:var(--s3)">{{ block.settings.body_1 }}</p>{%- endif -%}
                {%- if block.settings.body_2 != blank -%}<p>{{ block.settings.body_2 }}</p>{%- endif -%}
              </div>
              <div>
                {%- if block.settings.video_file != blank -%}
                  <video controls playsinline preload="none" poster="{% if block.settings.poster_file != blank %}{{ block.settings.poster_file | asset_url }}{% endif %}">
                    <source src="{{ block.settings.video_file | asset_url }}" type="video/mp4">
                  </video>
                  {%- if block.settings.caption != blank -%}
                    <p class="vid-cap">{{ block.settings.caption }}</p>
                  {%- endif -%}
                {%- elsif block.settings.image_file != blank -%}
                  {%- assign lp_img_alt = block.settings.image_alt | default: brand -%}
                {% render 'rd-img', file: block.settings.image_file, alt: lp_img_alt, width: 1400, height: 787, loading: 'lazy' %}
                {%- endif -%}
              </div>
            </div>
          </div>
        </section>

      {%- when 'assurance' -%}
        <section class="{% if block.settings.ground == 'bone' %}bone{% endif %}" {{ block.shopify_attributes }}>
          <div class="wrap">
            <div class="assure">
              <div>
                <span class="ic"></span>
                <b>{{ block.settings.a1_heading | default: 'You cannot get this wrong' }}</b>
                <p>{{ block.settings.a1_body | default: 'Adjust to Desire. A year to get the feel right. We remake the comfort layer to that, with our compliments, as often as it takes.' }}</p>
              </div>
              <div>
                <span class="ic"></span>
                <b>{{ block.settings.a2_heading | default: '100 days to change your mind' | replace: '100', trial }}</b>
                <p>{{ block.settings.a2_body | default: 'Collected from your home and refunded in full. Some sizes are not covered by the 100 day returns policy.' | replace: '100', trial }}</p>
              </div>
              <div>
                <span class="ic"></span>
                <b>{{ block.settings.a3_heading | default: '25 years on the core' | replace: '25', warranty }}</b>
                <p>{{ block.settings.a3_body | default: 'The part that carries you is guaranteed for a quarter of a century.' }}</p>
              </div>
            </div>
          </div>
        </section>

    {%- endcase -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Landing page",
  "tag": "div",
  "class": "lp-section",
  "settings": [
    {
      "type": "text",
      "id": "variant",
      "label": "Variant id",
      "info": "For analytics. Example: king-and-super-king"
    },
    {
      "type": "text",
      "id": "allowed_size_ids",
      "label": "Allowed size ids for From price",
      "info": "Comma list matching the configure size set (e.g. king,super-king,double). Blank = full market catalog. Theme.js also reads data-allowed-sizes from size-reserve."
    }
  ],
  "blocks": [
    {
      "type": "hero",
      "name": "Hero",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "textarea", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "lede", "label": "Lede" },
        { "type": "text", "id": "cta_primary", "label": "Primary CTA", "default": "Choose your size" },
        { "type": "text", "id": "cta_secondary", "label": "Secondary CTA" },
        { "type": "text", "id": "cta_secondary_href", "label": "Secondary CTA href", "default": "#configure" },
        { "type": "checkbox", "id": "show_price", "label": "Show price block", "default": true },
        { "type": "checkbox", "id": "price_first", "label": "Price above CTA and trust strip", "default": false },
        { "type": "checkbox", "id": "price_large", "label": "Large price", "default": false },
        { "type": "text", "id": "price_from", "label": "From price", "default": "From £2,499" },
        { "type": "text", "id": "price_klarna", "label": "Klarna line (fallback)", "default": "or £104 a month with Klarna" },
        { "type": "text", "id": "klarna_amount", "label": "Klarna amount (bold)", "default": "£104 a month", "info": "Renders as: or £104 a month with Klarna. Leave blank to use Klarna line fallback." },
        { "type": "checkbox", "id": "show_pay", "label": "Show payment row", "default": true },
        { "type": "text", "id": "pay_label", "label": "Payment row label", "default": "Pay by" },
        { "type": "checkbox", "id": "show_sizestrip", "label": "Show size strip", "default": false },
        { "type": "textarea", "id": "sizestrip_rows", "label": "Size strip rows", "info": "One per line: Label|dims|on. Example: King|150 x 200 cm|on" },
        { "type": "text", "id": "trust_1", "label": "Trust 1" },
        { "type": "text", "id": "trust_2", "label": "Trust 2" },
        { "type": "text", "id": "trust_3", "label": "Trust 3" },
        { "type": "text", "id": "image_file", "label": "Image filename", "default": "product-floating.webp" },
        { "type": "text", "id": "image_alt", "label": "Image alt" },
        { "type": "checkbox", "id": "show_press", "label": "Show hero text press strip (prefer the Press logos section)", "default": false },
        { "type": "text", "id": "press_label", "label": "Press label", "default": "As featured in" },
        { "type": "text", "id": "press_1", "label": "Press 1" },
        { "type": "text", "id": "press_2", "label": "Press 2" },
        { "type": "text", "id": "press_3", "label": "Press 3" },
        { "type": "text", "id": "press_4", "label": "Press 4" },
        { "type": "text", "id": "press_5", "label": "Press 5" }
      ]
    },
    {
      "type": "prose",
      "name": "Prose",
      "settings": [
        { "type": "select", "id": "ground", "label": "Ground", "options": [
          { "value": "", "label": "Snow" },
          { "value": "bone", "label": "Bone" },
          { "value": "dark", "label": "Dark" }
        ], "default": "" },
        { "type": "checkbox", "id": "tight", "label": "Tight top padding", "default": false },
        { "type": "text", "id": "anchor_id", "label": "Anchor id" },
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "textarea", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "body_1", "label": "Body 1" },
        { "type": "textarea", "id": "body_2", "label": "Body 2" },
        { "type": "textarea", "id": "pull", "label": "Pull quote" }
      ]
    },
    {
      "type": "split",
      "name": "Split media",
      "settings": [
        { "type": "select", "id": "ground", "label": "Ground", "options": [
          { "value": "", "label": "Snow" },
          { "value": "bone", "label": "Bone" },
          { "value": "dark", "label": "Dark" }
        ], "default": "" },
        { "type": "checkbox", "id": "reverse", "label": "Image first", "default": false },
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "textarea", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "body_1", "label": "Body 1" },
        { "type": "textarea", "id": "body_2", "label": "Body 2" },
        { "type": "textarea", "id": "pull", "label": "Pull quote" },
        { "type": "text", "id": "image_file", "label": "Image filename" },
        { "type": "text", "id": "image_alt", "label": "Image alt" }
      ]
    },
    {
      "type": "cards",
      "name": "Three cards",
      "settings": [
        { "type": "select", "id": "layout", "label": "Layout", "options": [
          { "value": "grid", "label": "Light grid" },
          { "value": "arrive", "label": "Arriving (carbon)" }
        ], "default": "grid" },
        { "type": "select", "id": "ground", "label": "Ground (grid layout)", "options": [
          { "value": "", "label": "Snow" },
          { "value": "bone", "label": "Bone" },
          { "value": "dark", "label": "Dark" }
