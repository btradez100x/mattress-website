{%- liquid
  assign warranty = settings.warranty_years | default: '25'
  if localization.country.iso_code == 'GB'
    assign market = 'gb'
    assign arrived_label = 'Arrived in the UK'
  elsif localization.country.iso_code == 'AE'
    assign market = 'ae'
    assign arrived_label = 'Arrived in the UAE'
  else
    assign market = settings.default_market | default: 'ae'
    if market == 'gb'
      assign arrived_label = 'Arrived in the UK'
    else
      assign arrived_label = 'Arrived in the UAE'
    endif
  endif
  assign order_name = order.name | default: ''
  assign first_name = order.customer.first_name | default: ''
  assign order_email = order.email | default: ''
  capture wa_raw
    render 'whatsapp-number'
  endcapture
  assign wa_raw = wa_raw | strip
-%}
{%- capture lead_window -%}{%- render 'lead-time', product: product, product_type: 'mattress' -%}{%- endcapture -%}
{%- assign lead_window = lead_window | strip -%}
<main data-order-confirmed data-market="{{ market }}" data-lead-window="{{ lead_window | escape }}" data-warranty-years="{{ warranty | escape }}">
  <section class="thanks-hero section--dark" data-reveal>
    <div class="page-width thanks-hero__inner">
      <p class="section__eyebrow">
        {%- if order_name != blank -%}
          ORDER CONFIRMED · #{{ order_name }}
        {%- else -%}
          {{ section.settings.eyebrow | default: 'ORDER CONFIRMED' }}
        {%- endif -%}
      </p>
      <h1 class="thanks-hero__title">
        {%- if first_name != blank -%}
          Thank you, {{ first_name }}.
        {%- else -%}
          {{ section.settings.heading | default: 'Thank you.' }}
        {%- endif -%}
      </h1>
      <p class="thanks-hero__lede">
        {{ section.settings.lede | default: 'Your order is in and production starts this week. Allow 8 to 10 weeks - most orders arrive sooner, and we will email you at every stage so you are never wondering.' }}
      </p>
      <p class="thanks-hero__window">
        Expected delivery
        <strong data-confirmed-lead>{{ lead_window }}</strong>
      </p>
      <p class="thanks-hero__remedy">
        If we are going to miss that window we will tell you before the date, and you can cancel for a full refund.
      </p>
    </div>
  </section>

  <section class="thanks-order" data-reveal>
    <div class="page-width page-width--narrow">
      <p class="section__eyebrow">Your order</p>
      <hr class="gold-rule">
      <ul class="thanks-order__lines" role="list" data-confirmed-lines></ul>
      <p class="thanks-order__total">
        <span>Total</span>
        <strong data-confirmed-total></strong>
      </p>
      <p class="thanks-order__summary" data-confirmed-summary hidden></p>
      {%- if settings.sheets_enabled -%}
        <p class="pdp-discover" data-sheets-confirm>
          A 35cm mattress does not fit a standard fitted sheet.
          <a href="{{ all_products['bed-sheets'].url | default: '/products/bed-sheets' }}">Sheets that fit.</a>
        </p>
      {%- endif -%}
    </div>
  </section>

  <section class="thanks-journey section--dark" data-reveal>
    <div class="page-width page-width--narrow">
      <p class="section__eyebrow">What happens next</p>
      <h2 class="thanks-journey__title">We will keep you posted.</h2>
      <p class="thanks-journey__lede">
        {%- if order_email != blank -%}
          A confirmation is on its way to {{ order_email }}.
        {%- else -%}
          A confirmation is on its way to your email.
        {%- endif -%}
        The next email comes when your mattress goes into production.
      </p>
      <ol class="thanks-stages" data-confirmed-stages>
        <li class="thanks-stage thanks-stage--now" data-stage="confirmed">
          <span class="thanks-stage__dot" aria-hidden="true"></span>
          <span class="thanks-stage__name">Order confirmed</span>
          <span class="thanks-stage__date" data-stage-date>Today</span>
        </li>
        <li class="thanks-stage" data-stage="production">
          <span class="thanks-stage__dot" aria-hidden="true"></span>
          <span class="thanks-stage__name">In production</span>
          <span class="thanks-stage__date"></span>
        </li>
        <li class="thanks-stage" data-stage="quality">
          <span class="thanks-stage__dot" aria-hidden="true"></span>
          <span class="thanks-stage__name">Quality checked</span>
          <span class="thanks-stage__date"></span>
        </li>
        <li class="thanks-stage" data-stage="transit">
          <span class="thanks-stage__dot" aria-hidden="true"></span>
          <span class="thanks-stage__name">In transit</span>
          <span class="thanks-stage__date"></span>
        </li>
        <li class="thanks-stage" data-stage="arrived">
          <span class="thanks-stage__dot" aria-hidden="true"></span>
          <span class="thanks-stage__name" data-stage-arrived-label>{{ arrived_label }}</span>
          <span class="thanks-stage__date"></span>
        </li>
        <li class="thanks-stage" data-stage="delivered">
          <span class="thanks-stage__dot" aria-hidden="true"></span>
          <span class="thanks-stage__name">Delivered</span>
          <span class="thanks-stage__date"></span>
        </li>
      </ol>
    </div>
  </section>

  {%- if section.settings.image != blank -%}
    <section class="thanks-media" aria-label="Product atmosphere" data-reveal>
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag: class: 'thanks-media__img', loading: 'lazy', widths: '800, 1200, 1600, 2000', sizes: '100vw'
      }}
    </section>
  {%- endif -%}

  <section class="thanks-close" data-reveal>
    <div class="page-width page-width--narrow">
      <p class="section__eyebrow">Meanwhile</p>
      <hr class="gold-rule">
      <h2 class="thanks-close__title">Change your mind before dispatch and we refund you in full, no questions asked.</h2>
      <div class="thanks-close__actions">
        {%- assign status_href = pages['order-status'].url | default: '/pages/order-status' -%}
        {%- if section.settings.status_link != blank -%}
          {%- assign status_href = section.settings.status_link -%}
        {%- endif -%}
        <a class="btn" href="{{ status_href }}">Track your order</a>
      </div>
      <p class="thanks-close__inbox">
        Questions?
        {%- if wa_raw != blank -%} WhatsApp {{ wa_raw }}{%- endif -%}
        {%- if settings.contact_email != blank -%}
          {%- if wa_raw != blank %} · {% endif -%}
          <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
        {%- endif -%}
      </p>
    </div>
  </section>
</main>

{% schema %}
{
  "name": "Order confirmed",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow fallback",
      "default": "ORDER CONFIRMED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading fallback",
      "default": "Thank you."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting copy",
      "default": "Your order is in and production starts this week. Allow 8 to 10 weeks - most orders arrive sooner, and we will email you at every stage so you are never wondering."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Atmosphere image"
    },
    {
      "type": "url",
      "id": "status_link",
      "label": "Order status page"
    }
  ]
}
{% endschema %}
