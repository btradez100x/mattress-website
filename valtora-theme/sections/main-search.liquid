<section class="section">
  <div class="page-width">
    <p class="section__eyebrow">Search</p>
    <h1 style="font-size:clamp(2rem,4vw,2.5rem);">Search</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" style="margin:1.5rem 0 2rem;display:flex;gap:0.5rem;flex-wrap:wrap;">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search"
        style="flex:1;min-width:14rem;padding:0.85rem 1rem;border:1px solid color-mix(in srgb, var(--brand-primary) 20%, transparent);background:var(--brand-bg);"
      >
      <button class="btn" type="submit">Search</button>
    </form>
    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p>No results for “{{ search.terms | escape }}”.</p>
      {%- else -%}
        <ul style="list-style:none;padding:0;margin:0;">
          {%- for item in search.results -%}
            <li style="padding:1rem 0;border-bottom:1px solid color-mix(in srgb, var(--brand-primary) 12%, transparent);">
              <a href="{{ item.url }}" style="text-decoration:none;font-weight:500;">{{ item.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
