{%- comment -%}
  Journal index as a Page (Admin: Pages → template journal → handle journal).
  Lists published blogs.journal.articles, then the six baked notes so Journal
  never renders empty. Content is not optional.
{%- endcomment -%}
{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'Journal'
  assign heading = section.settings.heading | default: 'Journal'
  assign lede = section.settings.lede
  assign cta_label = section.settings.cta_label | default: 'Reserve your size'
  assign cta_src = section.settings.cta_link
  if cta_src == blank
    assign cta_src = '/#reserve'
  endif
-%}
{%- capture cta_href -%}{% render 'home-section-href', href: cta_src %}{%- endcapture -%}
{%- assign cta_href = cta_href | strip -%}

<section class="policy-page journal-page">
  <div class="section section--dark policy-hero journal-page-hero" data-reveal>
    <div class="page-width policy-hero__copy">
      <p class="section__eyebrow" data-reveal-child data-reveal-first style="--reveal-delay: 0ms">{{ eyebrow }}</p>
      <hr class="gold-rule" data-reveal-child data-reveal-first style="--reveal-delay: 50ms">
      <h1 data-reveal-child data-reveal-first style="--reveal-delay: 100ms">{{ heading }}</h1>
      {%- if lede != blank -%}
        <p class="section__lede policy-hero__lede" data-reveal-child data-reveal-first style="--reveal-delay: 150ms">{{ lede }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="section section--surface journal-index" data-reveal>
    <div class="page-width">
      {%- if page.content != blank -%}
        <div class="policy-intro rte trust-policy__body" data-reveal-child style="--reveal-delay: 0ms">{{ page.content }}</div>
      {%- endif -%}
      {% render 'journal-baked-index' %}
    </div>
  </div>

  {%- if cta_label != blank -%}
    <div class="section section--dark policy-cta" data-reveal data-section-ground="dark">
      <div class="page-width policy-cta__inner">
        <p class="section__eyebrow" data-reveal-child style="--reveal-delay: 0ms">Next</p>
        <hr class="gold-rule" data-reveal-child style="--reveal-delay: 50ms">
        <p class="policy-cta__action" data-reveal-child style="--reveal-delay: 100ms">
          <a class="btn" href="{{ cta_href }}">{{ cta_label }}</a>
        </p>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Journal",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Journal"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Intro",
      "default": "Clear, practical writing on comfort, cool sleep, support and how to choose a mattress that fits how you actually rest - without the hype."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Reserve your size"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ]
}
{% endschema %}
