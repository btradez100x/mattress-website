{%- if section.settings.enable_section -%}
<section class="section{% render 'section-ground' %}" id="benefits" data-reveal data-section-ground="{% render 'section-ground', as: 'value' %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="benefits__grid">
      {%- for block in section.blocks -%}
        <article class="benefit" {{ block.shopify_attributes }}>
          <svg class="benefit__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'cool' -%}
                <path d="M12 3v18M5 7l14 10M5 17L19 7" stroke="currentColor" stroke-width="1.25"/>
              {%- when 'zones' -%}
                <path d="M4 18V13M7 18V10M10 18V7M13 18V5M16 18V8M19 18V12M22 18V15" stroke="currentColor" stroke-width="1.25"/>
              {%- when 'edge' -%}
                <path d="M4 16h16M5 16V8h14v8" stroke="currentColor" stroke-width="1.25"/>
                <path d="M16 8v8" stroke="currentColor" stroke-width="2"/>
              {%- when 'enduring' -%}
                <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.25"/>
                <path d="M12 8v4l2.5 2.5" stroke="currentColor" stroke-width="1.25"/>
              {%- when 'split' -%}
                <path d="M3 16h7M4 16v-4a3 3 0 0 1 6 0v4M14 16h7M15 16v-4a3 3 0 0 1 6 0v5" stroke="currentColor" stroke-width="1.25"/>
              {%- when 'pockets' -%}
                <circle cx="7" cy="8" r="1.6" stroke="currentColor" stroke-width="1.25"/>
                <circle cx="12" cy="8" r="1.6" stroke="currentColor" stroke-width="1.25"/>
                <circle cx="17" cy="8" r="1.6" stroke="currentColor" stroke-width="1.25"/>
                <circle cx="7" cy="13" r="1.6" stroke="currentColor" stroke-width="1.25"/>
                <circle cx="12" cy="13" r="1.6" stroke="currentColor" stroke-width="1.25"/>
                <circle cx="17" cy="13" r="1.6" stroke="currentColor" stroke-width="1.25"/>
                <circle cx="7" cy="18" r="1.6" stroke="currentColor" stroke-width="1.25"/>
                <circle cx="12" cy="18" r="1.6" stroke="currentColor" stroke-width="1.25"/>
                <circle cx="17" cy="18" r="1.6" stroke="currentColor" stroke-width="1.25"/>
              {%- when 'grip' -%}
                <path d="M4 6h16M7 11l2 2 2-2M13 11l2 2 2-2M7 16l2 2 2-2M13 16l2 2 2-2" stroke="currentColor" stroke-width="1.25"/>
              {%- else -%}
                <path d="M4 9h8M6 9V6l3-2 3 2v3M8 16h12M10 16v3l3 2 3-2v-3" stroke="currentColor" stroke-width="1.25"/>
            {%- endcase -%}
          </svg>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text | newline_to_br }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Benefits",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },

    {
      "type": "select",
      "id": "ground",
      "label": "Section colour",
      "options": [
        {
          "value": "auto",
          "label": "Auto — keep neighbours distinct"
        },
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "surface",
          "label": "Stone"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "auto",
      "info": "Auto alternates off-white and stone when you reorder sections. Dark is for contrast only, used sparingly."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "8 things that hold up."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "adapt", "label": "Adaptive" },
            { "value": "cool", "label": "Cool" },
            { "value": "zones", "label": "Zones" },
            { "value": "enduring", "label": "Enduring" },
            { "value": "edge", "label": "Edge" },
            { "value": "split", "label": "Split" },
            { "value": "pockets", "label": "Pockets" },
            { "value": "grip", "label": "Grip" }
          ],
          "default": "adapt"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Decide later."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Nobody knows how firm they want a mattress until they have slept on one.\nUnzip the cover, turn the layer over, zip it up. Medium on one side, medium firm on the other.\nIf neither is it, you have a year and we adjust it with you."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "adapt",
            "heading": "Decide later.",
            "text": "Nobody knows how firm they want a mattress until they have slept on one.\nUnzip the cover, turn the layer over, zip it up. Medium on one side, medium firm on the other.\nIf neither is it, you have a year and we adjust it with you."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "cool",
            "heading": "Sleep cool.",
            "text": "The cover pulls heat off your skin faster than cotton gives it back."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "zones",
            "heading": "Wake without the ache.",
            "text": "7 zones of carefully engineered springs. Firm under your hips. Soft at your shoulders. Not the same everywhere. Neither are you."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "enduring",
            "heading": "Keep it for decades.",
            "text": "Replace the layer that wears. Keep the bed that does not."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "edge",
            "heading": "Sit on the edge",
            "text": "It holds. No slide, no dip, and you can sleep right to the edge."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "split",
            "heading": "They turn over. You sleep on.",
            "text": "Movement stays on their side of the bed."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "pockets",
            "heading": "Motion stays with you.",
            "text": "Each spring is housed alone. You turn. The other side stays quieter."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "grip",
            "heading": "It stays where you put it.",
            "text": "An anti-slip underside. The mattress holds its place on the frame."
          }
        }
      ]
    }
  ]
}
{% endschema %}
