{%- if section.settings.enable_section -%}
<section class="section{% render 'section-ground' %}" id="benefits" data-reveal data-section-ground="{% render 'section-ground', as: 'value' %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <p class="section__eyebrow">Why it matters</p>
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="benefits__grid">
      {%- for block in section.blocks -%}
        <article class="benefit" {{ block.shopify_attributes }}>
          <svg class="benefit__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'cool' -%}
                <path d="M12 3v18M5 7l14 10M5 17L19 7" stroke="currentColor" stroke-width="1.25"/>
              {%- when 'support' -%}
                <path d="M4 16h16M6 16V9a6 6 0 0 1 12 0v7" stroke="currentColor" stroke-width="1.25"/>
              {%- when 'stability' -%}
                <path d="M4 16h16M6 16V9a6 6 0 0 1 12 0v7" stroke="currentColor" stroke-width="1.25"/>
                <path d="M8 20h8" stroke="currentColor" stroke-width="1.25"/>
              {%- when 'enduring' -%}
                <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.25"/>
                <path d="M12 8v4l2.5 2.5" stroke="currentColor" stroke-width="1.25"/>
              {%- else -%}
                <path d="M4 14h16M8 14V8l4-3 4 3v6" stroke="currentColor" stroke-width="1.25"/>
            {%- endcase -%}
          </svg>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Benefits",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },

    {
      "type": "select",
      "id": "ground",
      "label": "Section colour",
      "options": [
        {
          "value": "auto",
          "label": "Auto — keep neighbours distinct"
        },
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "surface",
          "label": "Stone"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "auto",
      "info": "Auto alternates off-white and stone when you reorder sections. Dark is for contrast only, used sparingly."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Five feels. One bed."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "adapt", "label": "Adaptive" },
            { "value": "cool", "label": "Cool" },
            { "value": "support", "label": "Support" },
            { "value": "stability", "label": "Stability" },
            { "value": "enduring", "label": "Enduring" }
          ],
          "default": "adapt"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Decide later."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Nobody knows how firm they want a mattress until they have slept on one. So we made one that does both. Unzip the cover, turn the layer over, zip it up. Medium on one side, medium firm on the other."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "adapt",
            "heading": "Decide later.",
            "text": "Nobody knows how firm they want a mattress until they have slept on one. So we made one that does both. Unzip the cover, turn the layer over, zip it up. Medium on one side, medium firm on the other."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "cool",
            "heading": "Sleep cool.",
            "text": "Air moves through it instead of sitting under you."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "support",
            "heading": "Wake without the ache.",
            "text": "Firm under your hips. Soft at your shoulders. Not the same everywhere, because you are not."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "enduring",
            "heading": "Keep it for decades.",
            "text": "Replace the layer that wears. Keep the bed that does not."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "stability",
            "heading": "Sit on the edge",
            "text": "It holds. No slide, no dip, and you can sleep right to the edge."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "stability",
            "heading": "They turn over. You sleep on.",
            "text": "Movement stays on their side of the bed."
          }
        }
      ]
    }
  ]
}
{% endschema %}
