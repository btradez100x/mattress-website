<section class="section section--surface" id="benefits" data-reveal>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <p class="section__eyebrow">Why it matters</p>
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="benefits__grid">
      {%- for block in section.blocks -%}
        <article class="benefit" {{ block.shopify_attributes }}>
          <svg class="benefit__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'cool' -%}
                <path d="M12 3v18M5 7l14 10M5 17L19 7" stroke="currentColor" stroke-width="1.25"/>
              {%- when 'support' -%}
                <path d="M4 16h16M6 16V9a6 6 0 0 1 12 0v7" stroke="currentColor" stroke-width="1.25"/>
              {%- when 'enduring' -%}
                <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.25"/>
                <path d="M12 8v4l2.5 2.5" stroke="currentColor" stroke-width="1.25"/>
              {%- else -%}
                <path d="M4 14h16M8 14V8l4-3 4 3v6" stroke="currentColor" stroke-width="1.25"/>
            {%- endcase -%}
          </svg>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered for how you live."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "adapt", "label": "Adaptive" },
            { "value": "cool", "label": "Cool" },
            { "value": "support", "label": "Support" },
            { "value": "enduring", "label": "Enduring" }
          ],
          "default": "adapt"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "A bed that adapts"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Swap the top to change firmness — as your body, your partner, or your preferences change."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "adapt",
            "heading": "A bed that adapts",
            "text": "Swap the top to change firmness — as your body, your partner, or your preferences change."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "cool",
            "heading": "Cool by design",
            "text": "A breathable cool-knit cover and gel-infused comfort layer, made for warm nights."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "support",
            "heading": "Deep, engineered support",
            "text": "A 20cm, 7-zone pocket-spring core and high-density base keep your spine aligned."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "enduring",
            "heading": "Built to keep",
            "text": "Refresh the top instead of replacing the mattress — less waste, less cost over time."
          }
        }
      ]
    }
  ]
}
{% endschema %}
