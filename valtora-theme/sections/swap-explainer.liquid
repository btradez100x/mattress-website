<section class="section section--dark" id="swap-video" data-reveal>
  <div class="page-width" style="text-align:center; max-width: 48rem; margin-inline: auto;">
    <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.body != blank -%}
      <p class="section__lede" style="margin-inline:auto;">{{ section.settings.body }}</p>
    {%- endif -%}
  </div>
  <div class="page-width" style="margin-top: 2.5rem;">
    <div class="big-idea__media" style="aspect-ratio: 16 / 9; max-width: 56rem; margin-inline: auto;">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: image_size: '1600x', controls: true }}
      {%- else -%}
        {% render 'theme-image',
          image: section.settings.image,
          fallback: 'swap-poster.jpg',
          alt: section.settings.heading,
          sizes: '100vw'
        %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Swap System explainer",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Unzip. Lift out. Swap in."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Tops come in soft, medium and firm. Change comfort as life changes — keep the engineered core for decades."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Poster image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Explainer video"
    }
  ],
  "presets": [{ "name": "Swap System explainer" }]
}
{% endschema %}
