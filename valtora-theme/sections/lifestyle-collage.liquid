{%- liquid
  assign brand = settings.brand_name | default: 'Aligna'
  assign heading = section.settings.heading | replace: '[Brand]', brand | replace: 'Aligna', brand
-%}
{%- if section.settings.enable_section -%}
<section
  class="section lifestyle-collage{% render 'section-ground' %}"
  id="{{ section.settings.anchor_id | default: 'lifestyle' }}"
  data-reveal
  data-section-ground="{% render 'section-ground', as: 'value' %}"
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <hr class="gold-rule">
    <h2>{{ heading }}</h2>
    {%- if section.settings.body != blank -%}
      <p class="section__lede">{{ section.settings.body }}</p>
    {%- endif -%}

    <div class="lifestyle-collage__masonry" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'image' and block.settings.enabled -%}
          {%- liquid
            assign span = block.settings.span | default: 'mid'
            assign fallback = block.settings.fallback_asset | default: 'lifestyle-airy.jpg'
            assign img_alt = block.settings.caption
            if img_alt == blank
              assign img_alt = heading
            endif
            assign item_caption = block.settings.caption
            if item_caption == blank
              assign item_caption = img_alt
            endif
          -%}
          <figure
            class="lifestyle-collage__item"
            role="listitem"
            {{ block.shopify_attributes }}
            data-reveal-child
            style="--reveal-delay: {{ forloop.index0 | times: 50 }}ms"
          >
            <div class="lifestyle-collage__frame lifestyle-collage__item--{{ span }}">
              {% render 'theme-image',
                image: block.settings.image,
                fallback: fallback,
                alt: img_alt,
                sizes: '(min-width: 900px) 33vw, 50vw',
                class: 'lifestyle-collage__img'
              %}
            </div>
            <figcaption class="lifestyle-collage__caption">{{ item_caption }}</figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Lifestyle collage",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "select",
      "id": "ground",
      "label": "Section colour",
      "options": [
        {
          "value": "auto",
          "label": "Auto — keep neighbours distinct"
        },
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "surface",
          "label": "Stone"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "auto",
      "info": "Auto alternates off-white and stone when you reorder sections. Dark is for contrast only, used sparingly."
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Stone surface background",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "lifestyle"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Styled by [Brand]",
      "info": "Use [Brand] - replaced by the global brand name setting."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Soft light. Quiet rooms. Real homes, not a showroom aisle."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Lifestyle image",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this image",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Theme fallback asset",
          "default": "lifestyle-airy.jpg",
          "info": "Used when no image is uploaded (local/theme asset filename)."
        },
        {
          "type": "select",
          "id": "span",
          "label": "Collage size",
          "default": "mid",
          "options": [
            { "value": "tall", "label": "Tall" },
            { "value": "mid", "label": "Medium" },
            { "value": "wide", "label": "Wide" },
            { "value": "square", "label": "Square" }
          ]
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "In the room"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lifestyle collage",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "enabled": true,
            "fallback_asset": "lifestyle-airy.jpg",
            "span": "wide",
            "caption": "Soft morning light"
          }
        },
        {
          "type": "image",
          "settings": {
            "enabled": true,
            "fallback_asset": "lifestyle-luxury.jpg",
            "span": "tall",
            "caption": "Navy suite calm"
          }
        },
        {
          "type": "image",
          "settings": {
            "enabled": true,
            "fallback_asset": "lifestyle-city.jpg",
            "span": "mid",
            "caption": "City apartment rest"
          }
        },
        {
          "type": "image",
          "settings": {
            "enabled": true,
            "fallback_asset": "lifestyle-suite.jpg",
            "span": "tall",
            "caption": "Depth in place"
          }
        },
        {
          "type": "image",
          "settings": {
            "enabled": true,
            "fallback_asset": "lifestyle-warm.jpg",
            "span": "mid",
            "caption": "Warm evening light"
          }
        },
        {
          "type": "image",
          "settings": {
            "enabled": true,
            "fallback_asset": "lifestyle-edge.jpg",
            "span": "square",
            "caption": "Edge support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
