{%- liquid
  assign brand = settings.brand_name | default: 'Aligna'
  assign body = section.settings.body | replace: '[Brand]', brand | replace: 'Aligna', brand
-%}
{%- if section.settings.enable_section -%}
<section class="section{% render 'section-ground' %}" id="swap" data-reveal data-section-ground="{% render 'section-ground', as: 'value' %}">
  <div class="page-width big-idea__grid">
    <div class="big-idea__copy">
      <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
      <hr class="gold-rule">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if body != blank -%}
        <div class="section__lede rte">{{ body | newline_to_br }}</div>
      {%- endif -%}
    </div>
    <div class="big-idea__media">
      {% render 'theme-video',
        video: section.settings.video,
        fallback: 'swap-zip.mp4',
        poster: section.settings.image,
        poster_fallback: 'handle-detail.jpg',
        autoplay: true,
        muted: true,
        loop: true,
        controls: false,
        class: 'theme-video theme-video--cover'
      %}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Big idea / Swap System",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show this section",
      "default": true
    },

    {
      "type": "select",
      "id": "ground",
      "label": "Section colour",
      "options": [
        {
          "value": "auto",
          "label": "Auto — keep neighbours distinct"
        },
        {
          "value": "bg",
          "label": "Off-white"
        },
        {
          "value": "surface",
          "label": "Stone"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "auto",
      "info": "Auto alternates off-white and stone when you reorder sections. Dark is for contrast only, used sparingly."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Swap System"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A better bed, for life."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Most mattresses are thrown away because one layer wore out. We made that layer the part you replace.",
      "info": "Use [Brand] - it is replaced by the global brand name setting."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Poster image (optional)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Zip video (Shopify hosted)",
      "info": "Shows the zip / unzip action. Theme falls back to swap-zip.mp4 (muted) when empty."
    }
  ],
  "presets": [{ "name": "Big idea / Swap System" }]
}
{% endschema %}
