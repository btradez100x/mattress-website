{%- liquid
  capture html_market
    render 'size-market'
  endcapture
  assign html_market = html_market | strip
  assign splitit_live = false
  if settings.splitit_enabled and settings.splitit_merchant_id != blank and html_market == 'gb'
    assign splitit_live = true
  endif
  assign cta_shape = settings.cta_radius | default: 'curved'
  if cta_shape != 'square'
    assign cta_shape = 'curved'
  endif
-%}
<!doctype html>
<html class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}" lang="{{ request.locale.iso_code }}" data-market="{{ html_market }}" data-country="{{ localization.country.iso_code }}"{% if splitit_live %} data-splitit="on"{% endif %} data-brand-guidelines="{{ settings.brand_guidelines | default: 'v1' }}" data-color-scheme="{{ settings.color_scheme | default: 'signature' }}" data-cta-shape="{{ cta_shape }}" data-warranty-years="{{ settings.warranty_years | default: '25' | escape }}" data-trial-nights="{{ settings.trial_nights | default: '30' | escape }}" data-return-window-days="{{ settings.return_window_days | default: settings.trial_nights | default: '30' | escape }}" data-adjustment-period-months="{{ settings.adjustment_period_months | default: '12' | escape }}" data-reply-working-days="{{ settings.reply_working_days | default: 5 }}">
  <head>
    <script>
      (function () {
        var html = document.documentElement;
        if (/[?&]force-motion=1(?:&|$)/.test(location.search)) {
          html.setAttribute('data-force-motion', 'true');
        }
        if (html.classList.contains('shopify-design-mode')) return;
        html.classList.add('js-ready');
        setTimeout(function () {
          if (html.getAttribute('data-reveal-booted') === '1') return;
          html.classList.remove('js-ready');
        }, 900);
      })();
    </script>
    {% render 'meta-tags' %}
    {%- if template.name == 'page' and page.handle == 'checkout' -%}
    <link rel="canonical" href="{{ shop.url }}{{ routes.cart_url }}">
    <script>
      (function () {
        var dest = {{ routes.cart_url | json }};
        try {
          if (location.search) {
            dest += (dest.indexOf('?') >= 0 ? '&' : '?') + location.search.replace(/^\?/, '');
          }
        } catch (e) {}
        window.location.replace(dest);
      })();
    </script>
    <meta http-equiv="refresh" content="0;url={{ routes.cart_url }}">
    {%- endif -%}
    {% render 'consent-defaults' %}
    {%- if settings.gtm_container_id != blank -%}
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',{{ settings.gtm_container_id | json }});</script>
    <!-- End Google Tag Manager -->
    {%- endif -%}
    {% render 'css-variables' %}

    {%- comment -%}
      Brand type (guidelines zip), loaded once: Instrument Sans display,
      Inter body, Geist Mono labels. No competing serif/sans swap per page.
    {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- assign font_href_critical = 'https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap' -%}
    {%- if template.name == 'index' -%}
    <link rel="preload" as="image" href="{{ 'hero-mattress.jpg' | asset_url }}" fetchpriority="high">
    {%- endif -%}
    <link rel="preload" as="style" href="{{ font_href_critical }}">
    <link rel="stylesheet" href="{{ font_href_critical }}" media="print" onload="this.onload=null;this.media='all'">
    <noscript><link rel="stylesheet" href="{{ font_href_critical }}"></noscript>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'brand.css' | asset_url | stylesheet_tag }}
    {{ 'redesign.css' | asset_url | stylesheet_tag }}
    {{ 'float-basket-fix.css' | asset_url | stylesheet_tag }}
    {% render 'float-basket-fix' %}

    <script src="{{ 'utm-persistence.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'float-basket-fix.js' | asset_url }}" defer></script>

    {% render 'tracking-pixels' %}

    {%- if settings.klarna_client_id != blank and html_market == 'gb' -%}
      <script
        async
        data-environment="production"
        src="https://js.klarna.com/web-sdk/v1/klarna.js"
        data-client-id="{{ settings.klarna_client_id | escape }}"
      ></script>
    {%- endif -%}
    {%- if settings.splitit_enabled and settings.splitit_merchant_id != blank and html_market == 'gb' -%}
      <script
        async
        src="https://web-components.splitit.com/v2/upstream.js?api-key={{ settings.splitit_merchant_id | url_encode }}&lang=en-GB"
      ></script>
    {%- endif -%}

    {%- if template.suffix == 'comfort-top' or template.suffix == 'comfort-layer' -%}
      {%- if settings.comfort_tops_enabled != true -%}
        <meta name="robots" content="noindex,nofollow">
      {%- endif -%}
    {%- endif -%}
    {%- if template.suffix == 'bed-sheets' and settings.sheets_enabled != true -%}
      <meta name="robots" content="noindex,nofollow">
    {%- endif -%}
    {%- if template.suffix == 'pillows' and settings.pillows_enabled != true -%}
      <meta name="robots" content="noindex,nofollow">
    {%- endif -%}
    {%- if template.name == 'collection' or template.name == 'list-collections' -%}
      <meta name="robots" content="noindex,nofollow">
    {%- endif -%}

    {{ content_for_header }}
    {% render 'consent-update' %}
    {{ 'mobile-fit.css' | asset_url | stylesheet_tag }}
    <style id="page-scroll">
      html {
        overflow-x: clip;
        overflow-y: auto !important;
        height: auto;
      }
      body {
        overflow-x: visible;
        overflow-y: visible;
        height: auto;
      }
      html.nav-open, body.nav-open {
        overflow: hidden !important;
      }
      #MainContent, .main-content, #reserve, [data-size-reserve], [data-lp-configure], .size-reserve__layout, .reserve-panel, .order-panel {
        height: auto;
        max-height: none;
        overflow: visible;
      }
    </style>

    {%- capture valtora_legal_name -%}{% render 'legal-name' %}{%- endcapture -%}
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.ValtoraTheme = window.ValtoraTheme || {};
      window.ValtoraTheme.brandName = {{ settings.brand_name | json }};
      window.ValtoraTheme.legalName = {{ valtora_legal_name | strip | json }};
      window.ValtoraTheme.countryIso = {{ localization.country.iso_code | json }};
      window.ValtoraTheme.market = {{ html_market | json }};
      window.ValtoraTheme.defaultMarket = 'gb';
      window.ValtoraTheme.sizeAddLabel = {{ settings.size_add_label | default: 'Add' | json }};
      window.ValtoraTheme.splititEnabled = {{ splitit_live | json }};
      window.ValtoraTheme.moneyFormat = {{ shop.money_format | json }};
      window.ValtoraTheme.exitIntent = {
        enabled: {{ settings.exit_intent_enabled | json }},
        delaySeconds: {{ settings.exit_intent_delay_seconds | default: 30 | json }}
      };
      window.ValtoraTheme.routes = {
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        cartUpdate: {{ routes.cart_update_url | json }},
        cart: {{ routes.cart_url | json }},
        checkout: {{ routes.root_url | append: 'checkout' | json }},
        review: {{ routes.cart_url | json }},
        root: {{ routes.root_url | json }}
      };
      window.NUMA = window.NUMA || {};
      window.NUMA.returnsDays = {{ settings.return_window_days | default: settings.trial_nights | default: 30 | json }};
    </script>
  </head>

  <body
    class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}"
    data-market="{{ html_market }}"
    data-payment-mode="{{ settings.payment_mode | default: 'full' }}"
    data-comfort-tops-enabled="{% if settings.comfort_tops_enabled %}true{% else %}false{% endif %}"
    data-sheets-enabled="{% if settings.sheets_enabled %}true{% else %}false{% endif %}"
    data-pillows-enabled="{% if settings.pillows_enabled %}true{% else %}false{% endif %}"
    data-footer-accessories-enabled="{% if settings.footer_accessories_enabled %}true{% else %}false{% endif %}"
  >
    {%- if settings.gtm_container_id != blank -%}
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ settings.gtm_container_id | escape }}"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    {%- endif -%}
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'sticky-reserve-bar' %}
    {% render 'exit-intent' %}
    {% render 'whatsapp-button', variant: 'floating' %}
  </body>
</html>
