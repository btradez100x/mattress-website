{%- liquid
  assign html_market = settings.default_market | default: 'ae'
  capture html_market
    render 'size-market'
  endcapture
  assign html_market = html_market | strip
  assign splitit_live = false
  if settings.splitit_enabled and settings.splitit_merchant_id != blank and html_market == 'gb'
    assign splitit_live = true
  endif
-%}
<!doctype html>
<html class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}" lang="{{ request.locale.iso_code }}" data-market="{{ html_market }}" data-country="{{ localization.country.iso_code }}"{% if splitit_live %} data-splitit="on"{% endif %} data-brand-guidelines="{{ settings.brand_guidelines | default: 'v1' }}" data-color-scheme="{{ settings.color_scheme | default: 'signature' }}" data-warranty-years="{{ settings.warranty_years | default: '25' | escape }}" data-trial-nights="{{ settings.trial_nights | default: '100' | escape }}">
  <head>
    <script>
      (function () {
        var html = document.documentElement;
        if (/[?&]force-motion=1(?:&|$)/.test(location.search)) {
          html.setAttribute('data-force-motion', 'true');
        }
        if (html.classList.contains('shopify-design-mode')) return;
        html.classList.add('js-ready');
        setTimeout(function () {
          if (html.getAttribute('data-reveal-booted') === '1') return;
          html.classList.remove('js-ready');
        }, 900);
      })();
    </script>
    {% render 'meta-tags' %}
    {%- if settings.gtm_container_id != blank -%}
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',{{ settings.gtm_container_id | json }});</script>
    <!-- End Google Tag Manager -->
    {%- endif -%}
    {% render 'css-variables' %}

    {%- comment -%}
      Google Fonts: always display=swap. Load the LCP family first.
      When modern headlines + wordmark are sans, Outfit is first paint and Fraunces is deferred.
    {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- liquid
      assign guidelines = settings.brand_guidelines | default: 'v1'
      assign font_href_critical = ''
      assign font_href_deferred = ''
      assign preload_outfit = false
      if guidelines == 'v2'
        assign font_href_critical = 'https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap'
        assign font_href_deferred = 'https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&display=swap'
      else
        assign font_set = settings.font_set | default: 'modern'
        if font_set == 'classic'
          assign serif_family = 'Cormorant+Garamond:wght@400;500;600'
          assign sans_family = 'Manrope:wght@400;500;600;700'
          assign font_href_critical = 'https://fonts.googleapis.com/css2?family=' | append: serif_family | append: '&family=' | append: sans_family | append: '&display=swap'
        else
          case settings.font_serif
            when 'fraunces'
              assign serif_family = 'Fraunces:opsz,wght@9..144,400;500;600'
            when 'playfair'
              assign serif_family = 'Playfair+Display:wght@400;500;600'
            else
              assign serif_family = 'Cormorant+Garamond:wght@400;500;600'
          endcase
          case settings.font_sans
            when 'work_sans'
              assign sans_family = 'Work+Sans:wght@400;500;600;700'
            when 'inter'
              assign sans_family = 'Inter:wght@400;500;600;700'
            when 'manrope'
              assign sans_family = 'Manrope:wght@400;500;600;700'
            else
              assign sans_family = 'Outfit:wght@400;500;600;700'
              assign preload_outfit = true
          endcase
          assign wordmark_font = settings.wordmark_font | default: 'sans'
          assign headline_font = settings.headline_font | default: 'sans'
          if wordmark_font == 'sans' and headline_font == 'sans'
            assign font_href_critical = 'https://fonts.googleapis.com/css2?family=' | append: sans_family | append: '&display=swap'
            assign font_href_deferred = 'https://fonts.googleapis.com/css2?family=' | append: serif_family | append: '&display=swap'
          else
            assign font_href_critical = 'https://fonts.googleapis.com/css2?family=' | append: serif_family | append: '&family=' | append: sans_family | append: '&display=swap'
          endif
        endif
      endif
    -%}
    {%- if preload_outfit -%}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="https://fonts.gstatic.com/s/outfit/v15/QGYvz_MVcBeNP4NJtEtqUYLknw.woff2">
    {%- endif -%}
    {%- if template.name == 'index' -%}
    <link rel="preload" as="image" href="{{ 'hero-mattress.jpg' | asset_url }}" fetchpriority="high">
    {%- endif -%}
    <link rel="preload" as="style" href="{{ font_href_critical }}">
    <link rel="stylesheet" href="{{ font_href_critical }}" media="print" onload="this.onload=null;this.media='all'">
    <noscript><link rel="stylesheet" href="{{ font_href_critical }}"></noscript>
    {%- if font_href_deferred != blank -%}
    <link rel="stylesheet" href="{{ font_href_deferred }}" media="print" onload="this.onload=null;this.media='all'">
    <noscript><link rel="stylesheet" href="{{ font_href_deferred }}"></noscript>
    {%- endif -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'utm-persistence.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {% render 'tracking-pixels' %}

    {%- if settings.klarna_client_id != blank and html_market == 'gb' -%}
      <script
        async
        data-environment="production"
        src="https://js.klarna.com/web-sdk/v1/klarna.js"
        data-client-id="{{ settings.klarna_client_id | escape }}"
      ></script>
    {%- endif -%}
    {%- if settings.splitit_enabled and settings.splitit_merchant_id != blank and html_market == 'gb' -%}
      <script
        async
        src="https://web-components.splitit.com/v2/upstream.js?api-key={{ settings.splitit_merchant_id | url_encode }}&lang=en-GB"
      ></script>
    {%- endif -%}

    {%- if template.suffix == 'comfort-top' or template.suffix == 'comfort-layer' -%}
      {%- if settings.comfort_tops_enabled != true -%}
        <meta name="robots" content="noindex,nofollow">
      {%- endif -%}
    {%- endif -%}
    {%- if template.suffix == 'bed-sheets' and settings.sheets_enabled != true -%}
      <meta name="robots" content="noindex,nofollow">
    {%- endif -%}
    {%- if template.suffix == 'pillows' and settings.pillows_enabled != true -%}
      <meta name="robots" content="noindex,nofollow">
    {%- endif -%}
    {%- if template.name == 'collection' or template.name == 'list-collections' -%}
      <meta name="robots" content="noindex,nofollow">
    {%- endif -%}

    {{ content_for_header }}

    {%- capture valtora_legal_name -%}{% render 'legal-name' %}{%- endcapture -%}
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.ValtoraTheme = window.ValtoraTheme || {};
      window.ValtoraTheme.brandName = {{ settings.brand_name | json }};
      window.ValtoraTheme.legalName = {{ valtora_legal_name | strip | json }};
      window.ValtoraTheme.defaultMarket = {{ settings.default_market | json }};
      window.ValtoraTheme.sizeAddLabel = {{ settings.size_add_label | default: 'Add' | json }};
      window.ValtoraTheme.splititEnabled = {{ splitit_live | json }};
      window.ValtoraTheme.moneyFormat = {{ shop.money_format | json }};
      window.ValtoraTheme.exitIntent = {
        enabled: {{ settings.exit_intent_enabled | json }},
        delaySeconds: {{ settings.exit_intent_delay_seconds | default: 30 | json }}
      };
      window.ValtoraTheme.routes = {
        cartAdd: {{ routes.cart_add_url | json }},
        cart: {{ routes.cart_url | json }},
        checkout: {{ routes.root_url | append: 'checkout' | json }},
        review: {{ pages['checkout'].url | default: '/pages/checkout' | json }},
        root: {{ routes.root_url | json }}
      };
    </script>
  </head>

  <body
    class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}"
    data-market="{{ html_market }}"
    data-payment-mode="{{ settings.payment_mode | default: 'full' }}"
    data-comfort-tops-enabled="{% if settings.comfort_tops_enabled %}true{% else %}false{% endif %}"
    data-sheets-enabled="{% if settings.sheets_enabled %}true{% else %}false{% endif %}"
    data-pillows-enabled="{% if settings.pillows_enabled %}true{% else %}false{% endif %}"
    data-footer-accessories-enabled="{% if settings.footer_accessories_enabled %}true{% else %}false{% endif %}"
  >
    {%- if settings.gtm_container_id != blank -%}
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ settings.gtm_container_id | escape }}"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    {%- endif -%}
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'sticky-reserve-bar' %}
    {% render 'exit-intent' %}
    {% render 'whatsapp-button', variant: 'floating' %}
  </body>
</html>
