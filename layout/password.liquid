<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MX9SHNSM');</script>
    <!-- End Google Tag Manager -->
    {% render 'css-variables' %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Manrope:wght@400;500;600&display=swap">
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MX9SHNSM"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <main class="section" style="min-height:100vh;display:grid;place-items:center;">
      <div class="page-width page-width--narrow" style="text-align:center;">
        {% render 'wordmark' %}
        <h1 style="margin-top:2rem;font-size:clamp(2rem,4vw,2.75rem);">Coming soon</h1>
        <p class="section__lede" style="margin-inline:auto;">
          {% render 'market-tagline' %}. First allocation opening shortly.
        </p>
        {% form 'storefront_password' %}
          {{ form.errors | default_errors }}
          <div style="display:flex;gap:0.5rem;margin-top:1.5rem;justify-content:center;flex-wrap:wrap;">
            <input
              type="password"
              name="password"
              placeholder="Password"
              style="min-width:14rem;padding:0.85rem 1rem;border:1px solid color-mix(in srgb, var(--brand-primary) 20%, transparent);background:var(--brand-bg);"
            >
            <button class="btn" type="submit">Enter</button>
          </div>
        {% endform %}
      </div>
    </main>
  </body>
</html>
