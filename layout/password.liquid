<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-cta-shape="{{ settings.cta_radius | default: 'curved' }}">
  <head>
    {% render 'meta-tags' %}
    {% render 'consent-defaults' %}
    {%- if settings.gtm_container_id != blank -%}
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',{{ settings.gtm_container_id | json }});</script>
    <!-- End Google Tag Manager -->
    {%- endif -%}
    {% render 'css-variables' %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap">
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'brand.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'utm-persistence.js' | asset_url }}" defer></script>
    {{ content_for_header }}
    {% render 'consent-update' %}
    {{ 'mobile-fit.css' | asset_url | stylesheet_tag }}
    <style id="page-scroll">
      html {
        overflow-x: clip;
        overflow-y: auto !important;
        height: auto;
      }
      body {
        overflow-x: visible;
        overflow-y: visible;
        height: auto;
      }
    </style>
  </head>
  <body class="template-password">
    {%- if settings.gtm_container_id != blank -%}
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ settings.gtm_container_id | escape }}"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    {%- endif -%}
    <main class="section" style="min-height:100vh;display:grid;place-items:center;">
      {{ content_for_layout }}
    </main>
  </body>
</html>
